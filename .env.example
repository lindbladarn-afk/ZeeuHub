# Local Docker Compose configuration. Copy to .env and replace all CHANGE_ME values.
DOCKER_REGISTRY=
MSSQL_SA_PASSWORD=CHANGE_ME
ASPNETCORE_HTTPS_PASSWORD=CHANGE_ME

# Optional remote CustomerPortal override. Leave empty for the fully local Hub setup.
PORTAL_IDENTITY_CONNECTION_STRING=

# Optional tenant database connections.
ZEEU_CONNECTION_STRING_DEVELOPMENT=
ZEEU_CONNECTION_STRING_PRODUCTION=
ZEEU_CONNECTION_STRING_LOCALDEVELOPMENT=

# Optional AI configuration.
OPENAI_ENDPOINT=
OPENAI_API_KEY=
OPENAI_DEPLOYMENT=gpt-4.1
OPENAI_API_VERSION=2024-10-21

# Optional integration company context.
INTEGRATION_COMPANY_ID=
INTEGRATION_JEEVES_COMPANY_CODE=

# Jeeves integration source.
INTEGRATION_JEEVES_ENABLED=false
INTEGRATION_JEEVES_BASE_URL=
INTEGRATION_JEEVES_TOKEN=
INTEGRATION_JEEVES_AUTH_URL=
INTEGRATION_JEEVES_APP_ID=
INTEGRATION_JEEVES_APP_SECRET=

# Centra integration source.
INTEGRATION_CENTRA_ENABLED=false
INTEGRATION_CENTRA_BASE_URL=
INTEGRATION_CENTRA_TOKEN=

# Ongoing integration source.
INTEGRATION_ONGOING_ENABLED=false
INTEGRATION_ONGOING_BASE_URL=
INTEGRATION_ONGOING_USERNAME=
INTEGRATION_ONGOING_PASSWORD=
INTEGRATION_ONGOING_GOODS_OWNER_ID=

# Akeneo integration.
AKENEO_ENABLED=false
AKENEO_BASE_URL=
AKENEO_CLIENT_ID=
AKENEO_CLIENT_SECRET=
AKENEO_USERNAME=
AKENEO_PASSWORD=
AKENEO_PAGE_SIZE=100

SEED_MENU=true
