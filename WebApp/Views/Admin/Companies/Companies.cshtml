@using Entities.ViewModels.Admin
@using Microsoft.Extensions.Localization
@model List<ManageCompanyVM>
@inject IStringLocalizer<SharedResources> sharedLocalizer

@{
    // Company list uses the shared admin/module shell so overview metrics, filters and tables follow the same design language as the rest of the portal.
    ViewData["Title"] = sharedLocalizer["Admin_CompaniesTitle"];
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="dashboard-readable module-page admin-page">

@{
    var total = Model?.Count ?? 0;
    var withConn = Model?.Count(c => c.ConnectionStrings?.Any() == true) ?? 0;
    var withPerms = Model?.Count(c => c.Permissions?.Any() == true) ?? 0;
    var withBoth = Model?.Count(c => (c.ConnectionStrings?.Any() ?? false) && (c.Permissions?.Any() ?? false)) ?? 0;
}

    <div class="module-page-header">
        <div>
            <div class="dashboard-card-title">@sharedLocalizer["Admin"]</div>
            <h1 class="module-page-title">@sharedLocalizer["Admin_CompaniesTitle"]</h1>
            <div class="module-page-subtitle">@sharedLocalizer["Admin_CompaniesSubtitle"]</div>
            <div class="module-page-meta">@sharedLocalizer["Admin_CompaniesMeta"]</div>
        </div>
        <a class="btn btn-portal btn-sm rounded-pill admin-company-create-btn" asp-action="CreateCompany">@sharedLocalizer["Admin_CreateCompany"]</a>
    </div>

<div class="row g-2 mb-2 company-cards">
    <div class="col-md-3 col-sm-6 mb-2">
        <div class="card shadow-sm h-100 admin-kpi-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="admin-kpi-label">@sharedLocalizer["Admin_Total"]</div>
                    <div class="admin-kpi-value mb-0">@total</div>
                </div>
                <i class="fa fa-building text-primary fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-2">
        <div class="card shadow-sm h-100 admin-kpi-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="admin-kpi-label">@sharedLocalizer["Admin_HasConnection"]</div>
                    <div class="admin-kpi-value mb-0">@withConn</div>
                </div>
                <i class="fa fa-plug text-success fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-2">
        <div class="card shadow-sm h-100 admin-kpi-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="admin-kpi-label">@sharedLocalizer["Admin_HasPermissions"]</div>
                    <div class="admin-kpi-value mb-0">@withPerms</div>
                </div>
                <i class="fa fa-shield text-primary fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-2">
        <div class="card shadow-sm h-100 admin-kpi-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="admin-kpi-label">@sharedLocalizer["Admin_HasBoth"]</div>
                    <div class="admin-kpi-value mb-0">@withBoth</div>
                </div>
                <i class="fa fa-check-circle text-primary fs-3"></i>
            </div>
        </div>
    </div>
</div>

<div class="card kpi-card p-2">
    <div class="admin-filter-toolbar mb-2">
        <div>
            <div class="admin-section-title">@sharedLocalizer["Admin_CompanyList"]</div>
            <div class="module-page-meta">@sharedLocalizer["Admin_CompanyListMeta"]</div>
        </div>
        <div class="input-group input-group-sm admin-search-control">
                <span class="input-group-text"><i class="fa fa-search"></i></span>
                <input id="company-search" type="search" class="form-control" placeholder="@sharedLocalizer["Admin_SearchCompanyOrModule"]">
        </div>
    </div>
    <div class="module-table-shell">
        <div class="table-responsive module-table admin-table">
            <table class="table table-hover mb-0" id="companies-table">
                <thead>
                    <tr>
                        <th>@sharedLocalizer["CompanyName"]</th>
                        <th class="text-center">@sharedLocalizer["Admin_Connections"]</th>
                        <th class="text-center">@sharedLocalizer["Admin_Permissions"]</th>
                        <th>@sharedLocalizer["Module"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var company in Model)
                    {
                        var hasConn = company.ConnectionStrings?.Any() == true;
                        var permGroups = company.Permissions?.GroupBy(x => x.ModuleId).Select(x => x.First()).ToList()
                                         ?? new List<AdminCompanyPermissionsViewModel>();
                        var permCount = permGroups.Count;
                        var missingPerms = permCount == 0;
                        var missingConn = !hasConn;
                        var rowStatus = missingConn ? "table-danger" : (missingPerms ? "table-warning" : "");

                        @* Each company row stays fully clickable so admin can move from overview to company configuration without extra action buttons. *@
                        <tr class="@rowStatus company-row admin-row-link"
                            data-name="@company.Name"
                            data-modules="@string.Join(",", permGroups.Select(p => p.ModuleName))"
                            onclick="location.href='@Url.Action("ManageCompany","Admin", new { companyId = company.Id })'">
                            <td>
                                <div class="admin-row-title">@company.Name</div>
                                <div class="admin-row-meta">Identity CompanyId: @company.Id</div>
                            </td>
                            <td class="text-center">
                                @if (hasConn)
                                {
                                    <span class="badge bg-success">@company.ConnectionStrings.Count</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@sharedLocalizer["Missing"]</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (!missingPerms)
                                {
                                    <span class="badge bg-info text-dark">@permCount</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@sharedLocalizer["Missing"]</span>
                                }
                            </td>
                            <td>
                                @if (permGroups.Any())
                                {
                                    foreach (var module in permGroups)
                                    {
                                        <span class="badge admin-inline-badge">
                                            @module.ModuleName
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="admin-empty-copy">@sharedLocalizer["Admin_NoModules"]</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    (function () {
        const input = document.getElementById('company-search');
        if (!input) return;
        input.addEventListener('input', function () {
            const term = this.value.toLowerCase();
            document.querySelectorAll('#companies-table tbody tr').forEach(row => {
                const name = row.getAttribute('data-name')?.toLowerCase() || '';
                const modules = row.getAttribute('data-modules')?.toLowerCase() || '';
                const visible = name.includes(term) || modules.includes(term);
                row.style.display = visible ? '' : 'none';
            });
        });
    })();
</script>
</div>
