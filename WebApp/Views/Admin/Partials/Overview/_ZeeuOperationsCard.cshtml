@model WebApp.ViewModels.Admin.AdminOverviewViewModel
@{
    var hasItems = Model.InternalOperations.Any();
    var hasFailures = Model.InternalOperationsProviderFailures.Any();
}

<div class="card shadow-sm h-100 admin-operations-card">
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
            <div>
                <div class="admin-operations-kicker">ZeeU Operations</div>
                <div class="admin-operations-title">Intern kontrollpanel</div>
                <div class="admin-operations-subtitle mt-1">
                    @Model.InternalOperationsCount signaler kräver uppföljning.
                </div>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                @if (Model.InternalOperationsDegraded)
                {
                    <span class="badge text-bg-warning">Partiell data</span>
                }
                <a asp-controller="Admin" asp-action="HealthDetail" class="btn btn-sm btn-outline-secondary overview-action-btn">
                    Driftstatus
                </a>
                <a asp-controller="Admin" asp-action="AiQueries" asp-route-tab="quota" class="btn btn-sm btn-outline-secondary overview-action-btn">
                    Öppna AI kontrollpanel
                </a>
            </div>
        </div>

        <div class="row g-2 mb-3">
            <div class="col-md-4">
                <div class="rounded-3 p-3 admin-operations-kpi">
                    <div class="admin-operations-kpi-label">Signaler totalt</div>
                    <div class="admin-operations-kpi-value">@Model.InternalOperationsCount</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="rounded-3 p-3 admin-operations-kpi">
                    <div class="admin-operations-kpi-label">Hög prioritet</div>
                    <div class="admin-operations-kpi-value">@Model.InternalOperationsHighPriorityCount</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="rounded-3 p-3 admin-operations-kpi">
                    <div class="admin-operations-kpi-label">Providerfel</div>
                    <div class="admin-operations-kpi-value">@Model.InternalOperationsProviderFailureCount</div>
                </div>
            </div>
        </div>

        @if (!hasItems)
        {
            <div class="admin-operations-empty">Inga interna signaler just nu.</div>
        }
        else
        {
            <div class="d-flex flex-column gap-2">
                @foreach (var item in Model.InternalOperations)
                {
                    <div class="rounded-3 p-3 admin-operations-item">
                        <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-2">
                            <div class="admin-operations-item-title">@item.Title</div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span class="@item.PriorityCssClass">@item.PriorityLabel</span>
                                <span class="badge bg-secondary-subtle text-secondary-emphasis">@item.Category</span>
                            </div>
                        </div>
                        <div class="admin-operations-item-copy mb-2">@item.Description</div>
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <div class="admin-operations-item-meta">Upptäckt @item.DetectedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                            @if (!string.IsNullOrWhiteSpace(item.LinkUrl))
                            {
                                <a href="@item.LinkUrl" class="btn btn-sm btn-outline-primary overview-action-btn">
                                    @(string.IsNullOrWhiteSpace(item.LinkText) ? "Öppna" : item.LinkText)
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        @if (hasFailures)
        {
            <div class="mt-3 pt-3 border-top admin-operations-failures">
                <div class="admin-operations-failures-title mb-2">Providerfel</div>
                <div class="d-flex flex-column gap-2">
                    @foreach (var failure in Model.InternalOperationsProviderFailures)
                    {
                        <div class="admin-operations-failure-copy">
                            <span class="admin-operations-failure-name">@failure.DisplayName</span>: @failure.Message
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
