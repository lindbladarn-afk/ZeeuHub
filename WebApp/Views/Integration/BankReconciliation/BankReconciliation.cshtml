@using WebApp.Models.Integration
@using WebApp.Services.Integration.BankReconciliation.Validation
@using WebApp.ViewModels.Shared
@model WebApp.ViewModels.Integration.BankReconciliation.BankReconciliationPageViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResources> sharedLocalizer
@{
    // Bank reconciliation stays on the shared module-page shell so menu, access and actions match the other modules.
    ViewData["Title"] = sharedLocalizer["Module_BankReconciliation"].Value;
    var transactionsJson = Model.TransactionsJson;
    var invoicesJson = Model.InvoicesJson;
    var latestFileName = Model.LatestFileName;
    var runtimeBanner = Model.RuntimeBanner;
    var latestUploadedAt = Model.LatestUploadedAt;
    var hasUploadedFile = Model.HasUploadedFile;
    var validationReport = Model.ValidationReport;
    var validationWarnings = validationReport?.Issues
        .Where(issue => issue.Severity == BankReconciliationCamtValidationSeverity.Warning)
        .ToArray() ?? [];
    var validationWarningCount = validationWarnings.Length;
    var validationStatusLabel = validationReport is null
        ? string.Empty
        : validationReport.IsValid && validationWarningCount > 0
            ? "Matchningsbar med varningar"
            : validationReport.IsValid
                ? "Godkänd för matchning"
                : "Blockerad";
    var validationResultText = validationReport is null
        ? string.Empty
        : validationReport.IsValid && validationWarningCount > 0
            ? "Filen kan matchas, men varningarna bör granskas först."
            : validationReport.IsValid
                ? "Struktur och redovisningskontroller är godkända."
                : "Åtgärda blockerande fel innan filen används.";
    var isDemoMode = Model.IsDemoMode;
    var demoScenarioKey = Model.DemoScenarioKey;
    var demoScenarios = Model.DemoScenarios;
    var activeCompanyName = string.IsNullOrWhiteSpace(Model.ActiveCompanyName)
        ? sharedLocalizer["BankRec_SelectedCompanyFallback"].Value
        : Model.ActiveCompanyName;
    var demoToggleLabel = isDemoMode ? sharedLocalizer["BankRec_DemoOn"].Value : sharedLocalizer["BankRec_DemoOff"].Value;
    var demoToggleTitle = isDemoMode
        ? sharedLocalizer["BankRec_DemoDisableTitle"].Value
        : sharedLocalizer["BankRec_DemoEnableTitle"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bankrec.css" asp-append-version="true" />
}

<div class="dashboard-readable module-page integration-page bankrec-page" id="bankrec-page-root" data-workspace-mode="overview" data-has-source="@hasUploadedFile.ToString().ToLowerInvariant()">
    <div class="module-page-header mb-2">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 w-100">
            <div>
                <div class="dashboard-card-title">@sharedLocalizer["Module_BankReconciliation"]</div>
                <h1 class="module-page-title">@sharedLocalizer["Module_BankReconciliation"]</h1>
                <p class="module-page-subtitle mb-0">
                    @sharedLocalizer["BankRec_Subtitle"]
                </p>
            </div>
            <div class="d-flex gap-2">
                <form asp-action="BankReconciliationToggleDemo" method="post" class="document-signing-toggle-form">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="document-signing-env document-signing-env-toggle @(isDemoMode ? "document-signing-env--demo" : "document-signing-env--live")"
                            title="@demoToggleTitle"
                            aria-label="@demoToggleTitle">
                        <i class="fa @(isDemoMode ? "fa-toggle-on" : "fa-toggle-off") me-1"></i>
                        @demoToggleLabel
                    </button>
                </form>
            </div>
        </div>
    </div>

    @if (runtimeBanner is not null)
    {
        <div class="mb-2">
            @await Html.PartialAsync("_ModuleBanner", runtimeBanner)
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        var statusMessage = Model.StatusMessage;
        var statusTone = Model.StatusTone;
        var statusIcon = statusTone == "success" ? "fa fa-check" : "fa fa-circle-info";
        <div class="mb-2">
            @await Html.PartialAsync("_ModuleBanner", new ModuleBannerViewModel
            {
                Message = statusMessage,
                Tone = statusTone,
                IconClass = statusIcon,
                Compact = true
            })
        </div>
    }

    <div class="module-state @(hasUploadedFile ? "module-state--success" : "module-state--warning") bankrec-empty-state mb-2" role="status">
        <div class="module-state-icon" aria-hidden="true">
            <i class="fa @(hasUploadedFile ? "fa-file-circle-check" : "fa-upload")"></i>
        </div>
        <div class="module-state-content">
            <div class="module-state-title">@(hasUploadedFile ? sharedLocalizer["BankRec_FileUploadedTitle"] : sharedLocalizer["BankRec_NoFileTitle"])</div>
            @if (hasUploadedFile && !string.IsNullOrWhiteSpace(latestFileName))
            {
                <div class="bankrec-source-file">
                    <i class="fa fa-file-lines" aria-hidden="true"></i>
                    <span>@latestFileName</span>
                </div>
            }
            else
            {
                <div class="module-state-message">@sharedLocalizer["BankRec_NoFileMessage"]</div>
            }
            <div class="module-state-note">@sharedLocalizer["BankRec_NoFileNote"]</div>
            @if (!string.IsNullOrWhiteSpace(Model.UploadError))
            {
                @await Html.PartialAsync("_ModuleBanner", new ModuleBannerViewModel
                {
                    Title = sharedLocalizer["BankRec_UploadFailedTitle"].Value,
                    Message = Model.UploadError,
                    Tone = "danger",
                    IconClass = "fa fa-circle-xmark",
                    Compact = true
                })
            }
            @if (validationReport is not null)
            {
                <div class="bankrec-validation-summary" aria-label="Valideringssammanfattning">
                    <div class="bankrec-validation-summary__status @(validationReport.IsValid ? validationWarningCount > 0 ? "is-warning" : "is-valid" : "is-invalid")">
                        <i class="fa @(validationReport.IsValid ? validationWarningCount > 0 ? "fa-triangle-exclamation" : "fa-circle-check" : "fa-circle-xmark")" aria-hidden="true"></i>
                        <strong>@validationStatusLabel</strong>
                    </div>
                    <span class="bankrec-validation-summary__divider" aria-hidden="true"></span>
                    <div class="bankrec-validation-summary__metric">
                        <strong>@validationWarningCount</strong>
                        <span>@(validationWarningCount == 1 ? "varning" : "varningar")</span>
                    </div>
                    <span class="bankrec-validation-summary__divider" aria-hidden="true"></span>
                    <div class="bankrec-validation-summary__metric">
                        <strong>@validationReport.TransactionCount</strong>
                        <span>transaktioner</span>
                    </div>
                </div>
                @if (validationWarningCount > 0)
                {
                    <div class="bankrec-validation-warning-panel" role="status" aria-live="polite">
                        <div class="bankrec-validation-warning-panel__heading">
                            <i class="fa fa-triangle-exclamation" aria-hidden="true"></i>
                            <strong>@validationWarningCount @(validationWarningCount == 1 ? "varning" : "varningar") i filen</strong>
                        </div>
                        <ul>
                            @foreach (var warning in validationWarnings.Take(3))
                            {
                                <li>@warning.Message</li>
                            }
                        </ul>
                    </div>
                }
            }
            @if (hasUploadedFile && !isDemoMode)
            {
                var maskedAccount = validationReport?.MaskedAccount ?? Model.BankAccountLabel;
                <div class="bankrec-account-check" role="note">
                    <i class="fa fa-building-shield" aria-hidden="true"></i>
                    <div>
                        <strong>@sharedLocalizer["BankRec_AccountNotVerifiedTitle"]</strong>
                        <span>@sharedLocalizer["BankRec_AccountNotVerifiedMessage", maskedAccount, activeCompanyName]</span>
                    </div>
                </div>
            }
        </div>
        <div class="bankrec-empty-actions">
            @if (hasUploadedFile)
            {
                @if (validationReport is not null)
                {
                    <button type="button"
                            class="btn btn-portal btn-portal-outline btn-sm bankrec-validation-trigger"
                            data-bs-toggle="modal"
                            data-bs-target="#bankrec-validation-modal">
                        <i class="fa fa-shield-check" aria-hidden="true"></i>
                        Visa detaljer
                    </button>
                }
                <form asp-action="BankReconciliationClearUpload" method="post" class="bankrec-clear-upload-form">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-portal btn-portal-outline btn-sm" type="submit">@sharedLocalizer["BankRec_ClearFile"]</button>
                </form>
            }
            else
            {
                @* Upload remains session-bound on purpose until the long-term import flow is in place. *@
                <form asp-action="BankReconciliationUpload" method="post" enctype="multipart/form-data" class="bankrec-upload-form">
                    @Html.AntiForgeryToken()
                    <input type="file" id="bankrec-upload-input" name="file" accept=".xml,.nda" class="d-none" />
                    <button class="btn btn-portal bankrec-upload-trigger btn-sm" id="bankrec-upload-trigger" type="button">@sharedLocalizer["BankRec_AddFile"]</button>
                </form>
            }
            @if (latestUploadedAt.HasValue)
            {
                <div class="module-page-meta small">@sharedLocalizer["Uploaded"] @latestUploadedAt.Value.ToString("yyyy-MM-dd HH:mm")</div>
            }
        </div>
    </div>

    @if (validationReport is not null)
    {
        <div class="modal fade bankrec-bundle-modal bankrec-validation-modal" id="bankrec-validation-modal" tabindex="-1" aria-labelledby="bankrec-validation-modal-title" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <div>
                            <div class="bankrec-bundle-modal__eyebrow">CAMT-kontroll</div>
                            <h5 class="modal-title" id="bankrec-validation-modal-title">Valideringsrapport</h5>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Stäng"></button>
                    </div>
                    <div class="modal-body">
                        <div class="bankrec-validation-result @(validationReport.IsValid ? "is-valid" : "is-invalid")">
                            <i class="fa @(validationReport.IsValid ? validationWarningCount > 0 ? "fa-triangle-exclamation" : "fa-circle-check" : "fa-circle-xmark")" aria-hidden="true"></i>
                            <div>
                                <strong>@(validationReport.IsValid ? validationStatusLabel : "Filen är blockerad")</strong>
                                <span>@validationResultText</span>
                            </div>
                        </div>

                        <dl class="bankrec-validation-details">
                            <div><dt>CAMT-version</dt><dd>@(validationReport.CamtVersion ?? "-")</dd></div>
                            <div><dt>Statement-id</dt><dd>@(validationReport.StatementId ?? "-")</dd></div>
                            <div><dt>Bankkonto</dt><dd>@(validationReport.MaskedAccount ?? "-")</dd></div>
                            <div><dt>Valuta</dt><dd>@(validationReport.Currency ?? "-")</dd></div>
                            <div><dt>Kontoutdrag</dt><dd>@validationReport.StatementCount</dd></div>
                            <div><dt>Bokföringsposter</dt><dd>@validationReport.BookedEntryCount av @validationReport.EntryCount</dd></div>
                            <div><dt>Transaktioner</dt><dd>@validationReport.TransactionCount</dd></div>
                            <div><dt>Blockerade poster</dt><dd>@validationReport.BlockedEntryCount</dd></div>
                            <div><dt>Öppningsbalans</dt><dd>@validationReport.OpeningBalance?.ToString("N2") @validationReport.Currency</dd></div>
                            <div><dt>Stängningsbalans</dt><dd>@validationReport.ClosingBalance?.ToString("N2") @validationReport.Currency</dd></div>
                        </dl>

                        <div class="bankrec-validation-issues">
                            <h6>Kontroller och anmärkningar</h6>
                            @if (validationReport.Issues.Count == 0)
                            {
                                <div class="bankrec-validation-issue is-valid">
                                    <i class="fa fa-check" aria-hidden="true"></i>
                                    <span>Inga fel eller varningar hittades.</span>
                                </div>
                            }
                            else
                            {
                                @foreach (var issue in validationReport.Issues)
                                {
                                    var isError = issue.Severity == BankReconciliationCamtValidationSeverity.Error;
                                    <div class="bankrec-validation-issue @(isError ? "is-error" : "is-warning")">
                                        <i class="fa @(isError ? "fa-circle-xmark" : "fa-triangle-exclamation")" aria-hidden="true"></i>
                                        <div>
                                            <strong>@(isError ? "Fel" : "Varning")</strong>
                                            <span>@issue.Message</span>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-portal btn-portal-outline" data-bs-dismiss="modal">Stäng</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (isDemoMode && demoScenarios.Count > 0)
    {
        var activeScenario = demoScenarios.FirstOrDefault(x => string.Equals(x.Key, demoScenarioKey, StringComparison.OrdinalIgnoreCase)) ?? demoScenarios[0];
        <div class="card shadow-sm border-0 bankrec-card bankrec-demo-panel mb-2">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
                    <div>
                        <div class="bankrec-demo-eyebrow">@sharedLocalizer["BankRec_DemoWorkspace"]</div>
                        <h6 class="mb-1">@sharedLocalizer["BankRec_DemoScenarioHeading"]</h6>
                        <p class="text-muted mb-1">@sharedLocalizer["BankRec_DemoScenarioHelp"]</p>
                        <p class="text-muted small mb-0">@activeScenario.Description</p>
                    </div>
                    <form asp-action="BankReconciliationResetDemoScenario" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-portal btn-portal-outline btn-sm">@sharedLocalizer["BankRec_DemoResetScenario"]</button>
                    </form>
                </div>
                <div class="bankrec-demo-scenarios mt-3">
                    @foreach (var scenario in demoScenarios)
                    {
                        var isActive = string.Equals(scenario.Key, demoScenarioKey, StringComparison.OrdinalIgnoreCase);
                        <form asp-action="BankReconciliationSelectDemoScenario" method="post" class="bankrec-demo-scenario-form" data-skip-page-loader="true">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="scenarioKey" value="@scenario.Key" />
                            <button type="submit"
                                    class="btn btn-portal btn-portal-outline btn-sm bankrec-demo-scenario @(isActive ? "is-active" : string.Empty)"
                                    aria-current="@(isActive ? "true" : null)">
                                @sharedLocalizer["BankRec_DemoScenarioButtonPrefix"] @scenario.Title
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }

    <div class="row g-2 mb-2 bankrec-summary-row">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bankrec-card module-kpi-surface module-kpi-surface--compact">
                <div class="card-body">
                    <div class="text-muted small">@sharedLocalizer["BankRec_IncomingPayments"]</div>
                    <div class="h4 mb-0" id="bankrec-total-credit">0</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bankrec-card module-kpi-surface module-kpi-surface--compact">
                <div class="card-body">
                    <div class="text-muted small">@sharedLocalizer["BankRec_OutgoingPayments"]</div>
                    <div class="h4 mb-0" id="bankrec-total-debit">0</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bankrec-card module-kpi-surface module-kpi-surface--compact">
                <div class="card-body">
                    <div class="text-muted small">@sharedLocalizer["BankRec_MatchedAmount"]</div>
                    <div class="h4 mb-0" id="bankrec-total-matched">0</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bankrec-card module-kpi-surface module-kpi-surface--compact">
                <div class="card-body">
                    <div class="text-muted small">@sharedLocalizer["BankRec_UnmatchedAmount"]</div>
                    <div class="h4 mb-0" id="bankrec-total-unmatched">0</div>
                </div>
            </div>
        </div>
    </div>

    @if (hasUploadedFile)
    {
        <div class="bankrec-demo-status-grid bankrec-live-status-grid mb-2" aria-label="@sharedLocalizer["BankRec_StatusSummaryAria"]">
            <div class="bankrec-demo-status-card" id="bankrec-demo-summary-card-matched">
                <span class="bankrec-demo-status-card__copy">
                    <span class="bankrec-demo-status-card__label">@sharedLocalizer["BankRec_DemoSummaryMatched"]</span>
                    <span class="bankrec-demo-status-card__meta">@sharedLocalizer["BankRec_StatusSummaryHint"]</span>
                </span>
                <span class="bankrec-demo-status-card__value" id="bankrec-demo-summary-matched">0</span>
            </div>
            <div class="bankrec-demo-status-card" id="bankrec-demo-summary-card-review">
                <span class="bankrec-demo-status-card__copy">
                    <span class="bankrec-demo-status-card__label">@sharedLocalizer["BankRec_DemoSummaryReview"]</span>
                    <span class="bankrec-demo-status-card__meta">@sharedLocalizer["BankRec_StatusSummaryHint"]</span>
                </span>
                <span class="bankrec-demo-status-card__value" id="bankrec-demo-summary-review">0</span>
            </div>
            <div class="bankrec-demo-status-card" id="bankrec-demo-summary-card-unmatched">
                <span class="bankrec-demo-status-card__copy">
                    <span class="bankrec-demo-status-card__label">@sharedLocalizer["BankRec_DemoSummaryUnmatched"]</span>
                    <span class="bankrec-demo-status-card__meta">@sharedLocalizer["BankRec_StatusSummaryHint"]</span>
                </span>
                <span class="bankrec-demo-status-card__value" id="bankrec-demo-summary-unmatched">0</span>
            </div>
        </div>
    }

    <div class="card shadow-sm border-0 bankrec-card bankrec-process-card bankrec-mode-shell mb-2">
        <div class="card-body">
            <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
                <div class="bankrec-mode-shell__copy">
                    <div class="bankrec-demo-eyebrow">@sharedLocalizer["BankRec_WorkspaceModeLabel"]</div>
                    <h6 class="mb-1" id="bankrec-mode-title">@sharedLocalizer["BankRec_ModeOverview"]</h6>
                    <p class="text-muted mb-0" id="bankrec-mode-description">@sharedLocalizer["BankRec_ModeDescriptionOverview"]</p>
                </div>
            </div>
            <div class="bankrec-process-steps" aria-label="@sharedLocalizer["BankRec_WorkspaceModeLabel"]">
                <button type="button" class="bankrec-process-step is-active" id="bankrec-mode-overview" aria-current="step">
                    <span class="bankrec-process-step__eyebrow">@sharedLocalizer["BankRec_ProcessStep", 1]</span>
                    <span class="bankrec-process-step__title">@sharedLocalizer["BankRec_ModeOverview"]</span>
                    <span class="bankrec-process-step__meta">@sharedLocalizer["BankRec_ModeDescriptionOverview"]</span>
                    <span class="bankrec-process-step__badge">1</span>
                </button>
                <button type="button" class="bankrec-process-step" id="bankrec-mode-classification" disabled="@(hasUploadedFile ? null : "disabled")">
                    <span class="bankrec-process-step__eyebrow">@sharedLocalizer["BankRec_ProcessStep", 2]</span>
                    <span class="bankrec-process-step__title">@sharedLocalizer["BankRec_ProcessReviewTitle"]</span>
                    <span class="bankrec-process-step__meta">@sharedLocalizer["BankRec_ModeDescriptionClassification"]</span>
                    <span class="bankrec-process-step__badge">2</span>
                </button>
                <button type="button" class="bankrec-process-step" id="bankrec-mode-reconciliation" disabled="@(hasUploadedFile ? null : "disabled")">
                    <span class="bankrec-process-step__eyebrow">@sharedLocalizer["BankRec_ProcessStep", 3]</span>
                    <span class="bankrec-process-step__title">@sharedLocalizer["BankRec_ProcessMatchTitle"]</span>
                    <span class="bankrec-process-step__meta">@sharedLocalizer["BankRec_ModeDescriptionReconciliation"]</span>
                    <span class="bankrec-process-step__badge">3</span>
                </button>
                <button type="button" class="bankrec-process-step" id="bankrec-mode-partial" disabled="@(hasUploadedFile ? null : "disabled")">
                    <span class="bankrec-process-step__eyebrow">@sharedLocalizer["BankRec_ProcessStep", 4]</span>
                    <span class="bankrec-process-step__title">@sharedLocalizer["BankRec_ProcessPartialTitle"]</span>
                    <span class="bankrec-process-step__meta">@sharedLocalizer["BankRec_ProcessPartialDescription"]</span>
                    <span class="bankrec-process-step__badge">4</span>
                </button>
                <button type="button" class="bankrec-process-step" id="bankrec-mode-complete" disabled="@(hasUploadedFile ? null : "disabled")">
                    <span class="bankrec-process-step__eyebrow">@sharedLocalizer["BankRec_ProcessStep", 5]</span>
                    <span class="bankrec-process-step__title">@sharedLocalizer["BankRec_ProcessCompleteTitle"]</span>
                    <span class="bankrec-process-step__meta">@sharedLocalizer["BankRec_ProcessCompleteDescription"]</span>
                    <span class="bankrec-process-step__badge">5</span>
                </button>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 bankrec-card bankrec-classification-panel mb-2 d-none" id="bankrec-classification-panel">
        <div class="card-body">
            <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
                <div>
                    <div class="bankrec-demo-eyebrow">@sharedLocalizer["BankRec_ClassificationPanelEyebrow"]</div>
                    <h6 class="mb-1">@sharedLocalizer["BankRec_ClassificationPanelTitle"]</h6>
                    <p class="text-muted mb-0">@sharedLocalizer["BankRec_ClassificationPanelHint"]</p>
                </div>
            </div>
            <div class="bankrec-classification-filter" id="bankrec-classification-filter"></div>
            <div class="bankrec-classification-grid mt-3" id="bankrec-classification-summary"></div>
        </div>
    </div>

    <div class="card shadow-sm border-0 bankrec-card bankrec-coding-panel mb-2 d-none" id="bankrec-coding-panel">
        <div class="card-body">
            <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
                <div>
                    <div class="bankrec-demo-eyebrow">@sharedLocalizer["BankRec_CodingPanelEyebrow"]</div>
                    <h6 class="mb-1">@sharedLocalizer["BankRec_CodingPanelTitle"]</h6>
                    <p class="text-muted mb-0">@sharedLocalizer["BankRec_CodingPanelHint"]</p>
                </div>
                <div class="d-flex flex-column align-items-end gap-2">
                    <div class="bankrec-coding-bank-account small text-muted" id="bankrec-coding-bank-account"></div>
                    <div class="bankrec-coding-legend">
                        <span class="bankrec-coding-legend__item bankrec-coding-legend__item--suggested">@sharedLocalizer["BankRec_CodingLegendSuggested"]</span>
                        <span class="bankrec-coding-legend__item bankrec-coding-legend__item--editable">@sharedLocalizer["BankRec_CodingLegendEditable"]</span>
                        <span class="bankrec-coding-dirty d-none" id="bankrec-coding-dirty" role="status">@sharedLocalizer["BankRec_UnsavedCodingChanges"]</span>
                        <button type="button" class="btn btn-portal btn-portal-outline btn-sm" id="bankrec-coding-save-btn">@sharedLocalizer["BankRec_CodingSave"]</button>
                    </div>
                </div>
            </div>
            <div class="bankrec-coding-grid mt-3" id="bankrec-coding-summary"></div>
        </div>
    </div>

    <div class="row g-2 bankrec-browse-sections">
        <div class="col-xl-6 bankrec-transactions-column">
            <div class="card shadow-sm border-0 bankrec-card">
                <div class="card-body">
                    <div class="bankrec-table-card-header">
                        <div class="bankrec-table-card-title">
                            <h5 class="mb-0">@sharedLocalizer["BankRec_BankTransactions"]</h5>
                            <span class="badge rounded-pill bg-secondary" id="bankrec-tx-count">0</span>
                        </div>
                        <div class="bankrec-select-filters">
                            <select class="form-select form-select-sm bankrec-select-filter" id="bankrec-tx-filter" aria-label="@sharedLocalizer["BankRec_FilterTransactionsAria"]">
                                <option value="all">@sharedLocalizer["All"]</option>
                                <option value="matched">@sharedLocalizer["Matched"]</option>
                                <option value="review">@sharedLocalizer["BankRec_DemoSummaryReview"]</option>
                                <option value="unmatched">@sharedLocalizer["Unmatched"]</option>
                            </select>
                            <select class="form-select form-select-sm bankrec-select-filter" id="bankrec-tx-group-filter" aria-label="@sharedLocalizer["BankRec_GroupTransactionsAria"]">
                                <option value="all" data-base-label="@sharedLocalizer["BankRec_AllGroups"]">@sharedLocalizer["BankRec_AllGroups"]</option>
