@section Scripts {
    <script>
        (() => {
            const form = document.querySelector('.bankrec-upload-form');
            const input = document.getElementById('bankrec-upload-input');
            const trigger = document.getElementById('bankrec-upload-trigger');

            if (!form || !input || !trigger) {
                return;
            }

            const idleLabel = JSON.parse(document.getElementById('bankrec-upload-idle-label')?.textContent || '"Lägg till camt.053-fil"');
            const readyLabel = JSON.parse(document.getElementById('bankrec-upload-ready-label')?.textContent || '"Ladda upp camt.053"');
            const uploadingLabel = JSON.parse(document.getElementById('bankrec-uploading-label')?.textContent || '"Läser in camt.053..."');
            let isSubmitting = false;

            const setUploading = () => {
                isSubmitting = true;
                trigger.textContent = uploadingLabel;
                trigger.disabled = true;
                trigger.setAttribute('aria-busy', 'true');
            };

            const syncButton = () => {
                if (isSubmitting) {
                    return;
                }

                trigger.textContent = input.files && input.files.length > 0 ? readyLabel : idleLabel;
            };

            trigger.addEventListener('click', () => {
                if (isSubmitting) {
                    return;
                }

                if (input.files && input.files.length > 0) {
                    setUploading();
                    form.requestSubmit();
                    return;
                }

                input.click();
            });

            input.addEventListener('change', () => {
                syncButton();
                if (input.files && input.files.length > 0) {
                    setUploading();
                    form.requestSubmit();
                }
            });

            form.addEventListener('submit', setUploading);
            syncButton();
        })();
    </script>
    <script src="~/js/bank-reconciliation-matching.js" asp-append-version="true"></script>
    <script src="~/js/bank-reconciliation-demo.js" asp-append-version="true"></script>
    <script src="~/js/bank-reconciliation-payment-bundles.js" asp-append-version="true"></script>
}
