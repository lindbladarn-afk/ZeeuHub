<script>
    (function initFlowEngineLiveRefresh() {
        var root = document.querySelector('[data-flowengine-page="true"]');
        if (!root) {
            return;
        }

        var snapshotUrl = root.getAttribute('data-flowengine-live-url');
        var refreshUrl = root.getAttribute('data-flowengine-refresh-url');
        var historyCardId = root.getAttribute('data-flowengine-history-card-id');
        if (!snapshotUrl) {
            return;
        }

        var lastVersion = root.getAttribute('data-flowengine-initial-version') || null;
        var isPolling = false;
        var hasActiveJobs = root.getAttribute('data-flowengine-has-active-jobs') === 'true';

        var getDelay = function () {
            return hasActiveJobs ? 8000 : 25000;
        };

        var refreshHistoryPanel = function () {
            if (!refreshUrl || !historyCardId) {
                window.location.reload();
                return Promise.resolve(false);
            }

            return window.fetch(refreshUrl, {
                credentials: 'same-origin',
                cache: 'no-store',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
                .then(function (response) {
                    if (!response.ok) {
                        throw new Error('Refresh failed');
                    }

                    return response.text();
                })
                .then(function (html) {
                    var parser = new window.DOMParser();
                    var doc = parser.parseFromString(html, 'text/html');
                    var nextCard = doc.getElementById(historyCardId);
                    var currentCard = document.getElementById(historyCardId);

                    if (!nextCard || !currentCard) {
                        window.location.reload();
                        return false;
                    }

                    currentCard.replaceWith(nextCard);
                    return true;
                })
                .catch(function () {
                    window.location.reload();
                    return false;
                });
        };

        var scheduleNext = function () {
            window.setTimeout(poll, getDelay());
        };

        var poll = function () {
            if (isPolling || document.hidden) {
                scheduleNext();
                return;
            }

            isPolling = true;

            window.fetch(snapshotUrl, {
                credentials: 'same-origin',
                cache: 'no-store'
            })
                .then(function (response) {
                    if (!response.ok) {
                        throw new Error('Snapshot failed');
                    }

                    return response.json();
                })
                .then(function (payload) {
                    if (!payload || typeof payload.version !== 'string') {
                        return;
                    }

                    if (payload.version !== lastVersion) {
                        hasActiveJobs = payload.hasActiveJobs === true;
                        return refreshHistoryPanel()
                            .then(function () {
                                lastVersion = payload.version;
                            });
                    }

                    hasActiveJobs = payload.hasActiveJobs === true;
                })
                .catch(function () {
                })
                .finally(function () {
                    isPolling = false;
                    scheduleNext();
                });
        };

        scheduleNext();
    })();
</script>

@section Scripts {
    <script>
        (() => {
            const page = document.querySelector('.flowengine-page');
            if (!page) {
                return;
            }

            const storageKey = 'zeeu.flowengine.workbench';
            const saveUrl = '@Url.Action("FlowEngineSaveWorkbenchSettings", "Integration")';
            const healthStatusUrl = '@Url.Action("FlowEngineHealthStatus", "Integration")';
            const requestVerificationToken = page.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            const serverDefaults = {
                testMode: @workbenchSettings.TestMode.ToString().ToLowerInvariant(),
                dryRun: @workbenchSettings.DryRun.ToString().ToLowerInvariant(),
                debugHttp: @workbenchSettings.DebugHttp.ToString().ToLowerInvariant(),
                skipJeevesCheck: @workbenchSettings.SkipJeevesCheck.ToString().ToLowerInvariant(),
                useLimit: @workbenchSettings.UseLimit.ToString().ToLowerInvariant(),
                limit: @workbenchSettings.Limit,
                centraSchedulerEnabled: @workbenchSettings.CentraSchedulerEnabled.ToString().ToLowerInvariant(),
                shopifySchedulerEnabled: @workbenchSettings.ShopifySchedulerEnabled.ToString().ToLowerInvariant()
            };
            const defaults = {
                ...serverDefaults,
                testMode: typeof serverDefaults.testMode === 'boolean' ? serverDefaults.testMode : @defaultGlobalTestMode.ToString().ToLowerInvariant(),
                dryRun: typeof serverDefaults.dryRun === 'boolean' ? serverDefaults.dryRun : @defaultGlobalDryRun.ToString().ToLowerInvariant(),
                skipJeevesCheck: typeof serverDefaults.skipJeevesCheck === 'boolean' ? serverDefaults.skipJeevesCheck : @defaultGlobalSkipJeevesCheck.ToString().ToLowerInvariant(),
                useLimit: typeof serverDefaults.useLimit === 'boolean' ? serverDefaults.useLimit : @defaultGlobalUseLimit.ToString().ToLowerInvariant(),
                limit: Number.isFinite(Number(serverDefaults.limit)) ? Number(serverDefaults.limit) : @defaultGlobalLimit
            };

            const loadState = () => {
                try {
                    const raw = window.localStorage.getItem(storageKey);
                    if (!raw) {
                        return { ...defaults };
                    }

                    const parsed = JSON.parse(raw);
                    return {
                        ...defaults,
                        ...parsed,
                        limit: Number.isFinite(Number(parsed?.limit)) ? Number(parsed.limit) : defaults.limit
                    };
                } catch {
                    return { ...defaults };
                }
            };

            let state = loadState();

            const flagCount = page.querySelector('[data-fe-flag-count]');
            const testIndicator = page.querySelector('[data-fe-indicator="test"]');
            const dryRunIndicator = page.querySelector('[data-fe-indicator="dryrun"]');
            const limitIndicator = page.querySelector('[data-fe-indicator="limit"]');
            const limitIndicatorValue = page.querySelector('[data-fe-indicator-value="limit"]');
            const limitLabel = page.querySelector('[data-fe-limit-label]');
            const limitSlider = page.querySelector('[data-fe-limit-slider]');
            const schedulerToggles = Array.from(page.querySelectorAll('[data-fe-scheduler-toggle]'));
            const schedulerLabels = Array.from(page.querySelectorAll('[data-fe-scheduler-label]'));
            const clearImportLinesButton = page.querySelector('[data-fe-clear-import-lines]');
            const importLinesField = page.querySelector('[data-fe-import-lines]');
            const importSheetRows = Array.from(page.querySelectorAll('[data-fe-sheet-row]'));
            const importSheetRowCount = page.querySelector('[data-fe-sheet-row-count]');
            const importSheetLineCount = page.querySelector('[data-fe-sheet-line-count]');
            const artStatusField = page.querySelector('[data-fe-art-status-input]');
            const priceToggle = page.querySelector('[data-fe-price-toggle]');
            const priceColumns = Array.from(page.querySelectorAll('[data-fe-price-column-cell], [data-fe-price-column-header]'));
            const uploadOrderButton = page.querySelector('[data-fe-upload-order]');
            const importDocumentInput = page.querySelector('[data-fe-import-document-input]');
            const extractSubmitButton = page.querySelector('[data-fe-extract-submit]');
            const dashboardHistoryEmpty = page.querySelector('[data-fe-dashboard-history-empty]');
            const dashboardFilterCount = page.querySelector('[data-fe-dashboard-filter-count]');
            const dashboardFilterForm = page.querySelector('[data-fe-dashboard-filter-form]');
            const dashboardFilterSystem = page.querySelector('[data-fe-dashboard-filter-system]');
            const dashboardFilterOperation = page.querySelector('[data-fe-dashboard-filter-operation]');
            const dashboardFilterStatus = page.querySelector('[data-fe-dashboard-filter-status]');
            const dashboardFilterDateStart = page.querySelector('[data-fe-dashboard-filter-date-start]');
            const dashboardFilterDateEnd = page.querySelector('[data-fe-dashboard-filter-date-end]');
            const dashboardFilterReset = page.querySelector('[data-fe-dashboard-filter-reset]');
            const modalHost = page.querySelector('#flowengine-modal-host');
            const healthPillsHost = page.querySelector('[data-fe-health-pills]');
            const flagInputs = {
                testMode: page.querySelector('[data-fe-flag="testMode"]'),
                dryRun: page.querySelector('[data-fe-flag="dryRun"]'),
                debugHttp: page.querySelector('[data-fe-flag="debugHttp"]'),
                skipJeevesCheck: page.querySelector('[data-fe-flag="skipJeevesCheck"]'),
                useLimit: page.querySelector('[data-fe-flag="useLimit"]')
            };

            const popovers = Array.from(page.querySelectorAll('[data-fe-popover]'));
            let saveTimer = null;

            const renderHealthPill = (status) => {
                const pill = document.createElement('span');
                pill.className = `flowengine-health-pill ${status.isReady ? 'flowengine-health-pill--ok' : 'flowengine-health-pill--warn'}`;
                pill.textContent = `${status.label}: ${status.statusText}`;
                return pill;
            };

            const renderHealthStatuses = (statuses) => {
                if (!healthPillsHost) {
                    return;
                }

                healthPillsHost.innerHTML = '';

                const isDashboardMode = healthPillsHost.getAttribute('data-fe-health-dashboard') === 'true';
                if (!Array.isArray(statuses) || statuses.length === 0) {
                    const empty = document.createElement('span');
                    empty.className = 'flowengine-health-pill flowengine-health-pill--warn';
                    empty.textContent = 'Status unavailable';
                    healthPillsHost.appendChild(empty);
                    return;
                }

                const visibleStatuses = isDashboardMode ? statuses : statuses.slice(0, 1);
                visibleStatuses.forEach((status) => {
                    healthPillsHost.appendChild(renderHealthPill(status));
                });
            };

            const loadHealthStatuses = async () => {
                if (!healthPillsHost || !healthStatusUrl) {
                    return;
                }

                const section = healthPillsHost.getAttribute('data-fe-health-section') || 'dashboard';
                const url = new URL(healthStatusUrl, window.location.origin);
                url.searchParams.set('section', section);
                url.searchParams.set('testMode', state.testMode ? 'true' : 'false');

                try {
                    const response = await window.fetch(url.toString(), {
                        method: 'GET',
                        credentials: 'same-origin',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    if (!response.ok) {
                        renderHealthStatuses([]);
                        return;
                    }

                    const statuses = await response.json();
                    renderHealthStatuses(statuses);
                } catch {
                    renderHealthStatuses([]);
                }
            };

            const saveState = () => {
                window.localStorage.setItem(storageKey, JSON.stringify(state));
            };

            const persistState = () => {
                if (!saveUrl || !requestVerificationToken) {
                    return;
                }

                if (saveTimer) {
                    window.clearTimeout(saveTimer);
                }

                saveTimer = window.setTimeout(() => {
                    const body = new URLSearchParams();
                    body.set('__RequestVerificationToken', requestVerificationToken);
                    body.set('TestMode', state.testMode ? 'true' : 'false');
                    body.set('DryRun', state.dryRun ? 'true' : 'false');
                    body.set('DebugHttp', state.debugHttp ? 'true' : 'false');
                    body.set('SkipJeevesCheck', state.skipJeevesCheck ? 'true' : 'false');
                    body.set('UseLimit', state.useLimit ? 'true' : 'false');
                    body.set('Limit', String(state.limit));
                    body.set('CentraSchedulerEnabled', state.centraSchedulerEnabled ? 'true' : 'false');
                    body.set('ShopifySchedulerEnabled', state.shopifySchedulerEnabled ? 'true' : 'false');

                    window.fetch(saveUrl, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                        },
                        body: body.toString()
                    }).catch(() => {
                        // Keep the workbench usable even if session persistence fails.
                    });
                }, 150);
            };

            const closePopovers = (except) => {
                popovers.forEach((popover) => {
                    if (popover === except) {
                        return;
                    }

                    popover.hidden = true;
                });
            };

            const initFlowEngineDatepickers = () => {
                if (!window.jQuery || !window.jQuery.fn || typeof window.jQuery.fn.datepicker !== 'function') {
                    return;
                }

                window.jQuery(page)
                    .find('input[data-fe-datepicker="true"]')
                    .each(function () {
                        const input = this;
                        const $input = window.jQuery(input);

                        if ($input.hasClass('hasDatepicker')) {
                            return;
                        }

                        const currentValue = input.value;
                        input.setAttribute('type', 'text');
                        input.setAttribute('autocomplete', 'off');
                        input.setAttribute('placeholder', 'YYYY-MM-DD');

                        $input.datepicker({
                            dateFormat: 'yy-mm-dd',
                            showOtherMonths: true,
                            selectOtherMonths: true,
                            showButtonPanel: true,
                            beforeShow: function () {
                                window.setTimeout(() => {
                                    window.jQuery('#ui-datepicker-div').addClass('flowengine-datepicker');
                                }, 0);
                            }
                        });

                        if (currentValue) {
                            $input.datepicker('setDate', currentValue);
                        }
                    });
            };

            const activeDashboardFilterCount = () => {
                let count = 0;
                if (dashboardFilterSystem && dashboardFilterSystem.value !== 'all') count += 1;
                if (dashboardFilterOperation && dashboardFilterOperation.value !== 'all') count += 1;
                if (dashboardFilterStatus && dashboardFilterStatus.value !== 'all') count += 1;
                if (dashboardFilterDateStart && dashboardFilterDateStart.value) count += 1;
                if (dashboardFilterDateEnd && dashboardFilterDateEnd.value) count += 1;
                return count;
            };

            const renderDashboardFilterCount = () => {
                if (dashboardFilterCount) {
                    const count = activeDashboardFilterCount();
                    dashboardFilterCount.textContent = count > 0 ? String(count) : '';
                    dashboardFilterCount.hidden = count === 0;
                }
            };

            const render = () => {
                if (testIndicator) {
                    testIndicator.hidden = !state.testMode;
                }

                if (dryRunIndicator) {
                    dryRunIndicator.hidden = !state.dryRun;
                }

                if (limitIndicator) {
                    limitIndicator.hidden = !state.useLimit;
                }

                if (limitIndicatorValue) {
                    limitIndicatorValue.textContent = String(state.limit);
                }

                if (limitLabel) {
                    limitLabel.textContent = String(state.limit);
                }

                if (limitSlider) {
                    limitSlider.value = String(state.limit);
                    limitSlider.disabled = !state.useLimit;
                }

                const enabledCount = ['testMode', 'dryRun', 'debugHttp', 'skipJeevesCheck', 'useLimit']
                    .filter((key) => Boolean(state[key]))
                    .length;

                if (flagCount) {
                    flagCount.hidden = enabledCount === 0;
                    flagCount.textContent = enabledCount > 0 ? String(enabledCount) : '';
                }

                Object.entries(flagInputs).forEach(([key, input]) => {
                    if (input) {
                        input.checked = Boolean(state[key]);
                    }
                });

                schedulerToggles.forEach((toggle) => {
                    const key = toggle.getAttribute('data-fe-scheduler-toggle');
                    if (!key) {
                        return;
                    }

                    toggle.checked = Boolean(state[`${key}SchedulerEnabled`]);
                });

                schedulerLabels.forEach((label) => {
                    const key = label.getAttribute('data-fe-scheduler-label');
                    if (!key) {
                        return;
                    }

                    label.textContent = state[`${key}SchedulerEnabled`] ? 'On' : 'Off';
                });
            };

            const ensureHidden = (form, name, value) => {
                let input = form.querySelector(`input[name="${name}"][data-fe-injected="true"]`);
                if (!input) {
                    input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = name;
                    input.dataset.feInjected = 'true';
                    form.appendChild(input);
                }

                input.value = value;
            };

            const syncBooleanField = (form, name, value) => {
                const checkboxes = Array.from(form.querySelectorAll(`input[name="${name}"][type="checkbox"]`));
                const hiddenFields = Array.from(form.querySelectorAll(`input[name="${name}"][type="hidden"]`));

                if (checkboxes.length > 0) {
                    checkboxes.forEach((checkbox) => {
                        checkbox.checked = value;
                    });
                }

                if (hiddenFields.length > 0) {
                    hiddenFields.forEach((input) => {
                        input.value = value ? 'true' : 'false';
                    });
                }

                if (checkboxes.length === 0 && hiddenFields.length === 0) {
                    ensureHidden(form, name, value ? 'true' : 'false');
                }
            };

            const syncLimitField = (form) => {
                if (!state.useLimit) {
                    return;
                }

                const limitInputs = Array.from(form.querySelectorAll('input[name="Limit"]'));
                if (limitInputs.length > 0) {
                    limitInputs.forEach((input) => {
                        input.value = String(state.limit);
                    });
                    return;
                }

                ensureHidden(form, 'Limit', String(state.limit));
            };

            page.querySelectorAll('form[method="post"]').forEach((form) => {
                form.addEventListener('submit', () => {
                    ensureHidden(form, 'FlowEngineGlobalTestMode', state.testMode ? 'true' : 'false');
                    ensureHidden(form, 'FlowEngineGlobalDryRun', state.dryRun ? 'true' : 'false');
                    ensureHidden(form, 'FlowEngineGlobalDebugHttp', state.debugHttp ? 'true' : 'false');
                    ensureHidden(form, 'FlowEngineGlobalSkipJeevesCheck', state.skipJeevesCheck ? 'true' : 'false');
                    ensureHidden(form, 'FlowEngineGlobalUseLimit', state.useLimit ? 'true' : 'false');
                    ensureHidden(form, 'FlowEngineGlobalLimit', String(state.limit));

                    syncBooleanField(form, 'DryRun', state.dryRun);
                    syncBooleanField(form, 'SkipJeevesCheck', state.skipJeevesCheck);
                    syncLimitField(form);
                });
            });

            Object.entries(flagInputs).forEach(([key, input]) => {
                if (!input) {
                    return;
                }

                input.addEventListener('change', () => {
                    state[key] = input.checked;
                    saveState();
                    persistState();
                    render();

                    if (key === 'testMode') {
                        loadHealthStatuses();
                    }
                });
            });

            if (limitSlider) {
                limitSlider.addEventListener('input', () => {
                    state.limit = Number(limitSlider.value);
                    saveState();
                    persistState();
                    render();
                });
            }

            schedulerToggles.forEach((toggle) => {
                toggle.addEventListener('change', () => {
                    const key = toggle.getAttribute('data-fe-scheduler-toggle');
                    if (!key) {
                        return;
                    }

                    state[`${key}SchedulerEnabled`] = toggle.checked;
                    saveState();
                    persistState();
                    render();
                });
            });

            const updatePriceColumn = () => {
                if (!priceToggle) {
                    return;
                }

                priceColumns.forEach((column) => {
                    column.hidden = !priceToggle.checked;
                });
            };

            const syncImportSheet = () => {
                if (!importLinesField || importSheetRows.length === 0) {
                    return;
                }

                const lines = [];
                const articleNumbers = [];

                importSheetRows.forEach((row) => {
                    const article = row.querySelector('[data-fe-sheet-field="article"]')?.value?.trim() ?? '';
                    const quantity = row.querySelector('[data-fe-sheet-field="quantity"]')?.value?.trim() ?? '';
                    const price = row.querySelector('[data-fe-sheet-field="price"]')?.value?.trim() ?? '';

                    if (!article && !quantity && !price) {
                        return;
                    }

                    const parts = [article, quantity];
                    if (priceToggle?.checked && price) {
                        parts.push(price);
                    }

                    lines.push(parts.join(';'));

                    if (article) {
                        articleNumbers.push(article);
                    }
                });

                importLinesField.value = lines.join('\n');

                if (artStatusField) {
                    artStatusField.value = articleNumbers.join('\n');
                }

                if (importSheetRowCount) {
                    importSheetRowCount.textContent = String(Math.min(importSheetRows.length, 5));
                }

                if (importSheetLineCount) {
                    importSheetLineCount.textContent = String(articleNumbers.length);
                }
            };

            const clearImportSheet = () => {
                importSheetRows.forEach((row) => {
                    row.querySelectorAll('[data-fe-sheet-field]').forEach((field) => {
                        field.value = '';
                    });
                });

                syncImportSheet();
            };

            if (importSheetRows.length > 0) {
                importSheetRows.forEach((row) => {
                    row.querySelectorAll('[data-fe-sheet-field="article"], [data-fe-sheet-field="quantity"], [data-fe-sheet-field="price"]').forEach((field) => {
                        field.addEventListener('input', syncImportSheet);
                    });
                });

                syncImportSheet();
            }

            if (priceToggle) {
                priceToggle.addEventListener('change', () => {
                    updatePriceColumn();
                    syncImportSheet();
                });

                updatePriceColumn();
            }

            if (clearImportLinesButton) {
                clearImportLinesButton.addEventListener('click', () => {
                    clearImportSheet();
                });
            }

            if (uploadOrderButton && importDocumentInput) {
                uploadOrderButton.addEventListener('click', () => {
                    importDocumentInput.click();
                });
            }

            if (importDocumentInput && extractSubmitButton) {
                importDocumentInput.addEventListener('change', () => {
                    if (!importDocumentInput.files || importDocumentInput.files.length === 0) {
                        return;
                    }

                    extractSubmitButton.click();
                });
            }

            if (dashboardFilterForm) {
                [dashboardFilterSystem, dashboardFilterOperation, dashboardFilterStatus, dashboardFilterDateStart, dashboardFilterDateEnd]
                    .filter(Boolean)
                    .forEach((element) => {
                        element.addEventListener('change', () => {
                            renderDashboardFilterCount();
                            dashboardFilterForm.requestSubmit();
                        });
                    });

                if (dashboardFilterReset) {
                    dashboardFilterReset.addEventListener('click', () => {
                        if (dashboardFilterCount) {
                            dashboardFilterCount.textContent = '';
                            dashboardFilterCount.hidden = true;
                        }
                    });
                }

                renderDashboardFilterCount();
            }

            page.querySelectorAll('[data-fe-toggle]').forEach((button) => {
                button.addEventListener('click', (event) => {
                    event.preventDefault();
                    event.stopPropagation();

                    const key = button.getAttribute('data-fe-toggle');
                    const popover = page.querySelector(`[data-fe-popover="${key}"]`);
                    if (!popover) {
                        return;
                    }

                    const willOpen = popover.hidden;
                    closePopovers(willOpen ? popover : null);
                    popover.hidden = !willOpen;
                });
            });

            document.addEventListener('click', (event) => {
                if (event.target instanceof Element && event.target.closest('.flowengine-popover-anchor')) {
                    return;
                }

                closePopovers(null);
            });

            const openFlowEngineModal = (modalElement) => {
                if (!modalElement) {
                    return;
                }

                if (window.jQuery && window.jQuery.fn && typeof window.jQuery.fn.modal === 'function') {
                    window.jQuery(modalElement)
                        .off('hidden.flowengine')
                        .on('hidden.flowengine', () => {
                            if (modalHost) {
                                modalHost.innerHTML = '';
                            }
                        })
                        .modal('show');
                    return;
                }

                if (window.bootstrap && typeof window.bootstrap.Modal === 'function') {
                    const instance = new window.bootstrap.Modal(modalElement);
                    modalElement.addEventListener('hidden.bs.modal', () => {
                        if (modalHost) {
                            modalHost.innerHTML = '';
                        }
                    }, { once: true });
                    instance.show();
                }
            };

            page.addEventListener('click', async (event) => {
                const link = event.target instanceof Element
                    ? event.target.closest('.flowengine-history-view-btn')
                    : null;

                if (!link || !page.contains(link)) {
                    return;
                }

                event.preventDefault();

                const url = link.getAttribute('href');
                if (!url || !modalHost) {
                    return;
                }

                try {
                    const response = await window.fetch(url, {
                        method: 'GET',
                        credentials: 'same-origin',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    if (!response.ok) {
                        window.location.assign(url);
                        return;
                    }

                    const html = await response.text();
                    modalHost.innerHTML = html;
                    const modalElement = modalHost.querySelector('.flowengine-job-modal');
                    openFlowEngineModal(modalElement);
                } catch {
                    window.location.assign(url);
                }
            });

            initFlowEngineDatepickers();
            render();
            loadHealthStatuses();
        })();
    </script>
}
