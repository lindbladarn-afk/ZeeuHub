@using Microsoft.AspNetCore.Mvc.Localization
@model WebApp.Models.Integration.FlowEngineModuleViewModel
@inject IHtmlLocalizer<SharedResources> sharedLocalizer
@{
    var activeSection = WebApp.Models.Integration.FlowEngineSectionKeys.Normalize(Model.ActiveSection);
    var isDashboard = activeSection == WebApp.Models.Integration.FlowEngineSectionKeys.Dashboard;
    var isJeeves = activeSection == WebApp.Models.Integration.FlowEngineSectionKeys.Jeeves;
    var isCentra = activeSection == WebApp.Models.Integration.FlowEngineSectionKeys.Centra;
    var isShopify = activeSection == WebApp.Models.Integration.FlowEngineSectionKeys.Shopify;
    var isAkeneo = activeSection == WebApp.Models.Integration.FlowEngineSectionKeys.Akeneo;
    var isJobs = activeSection == WebApp.Models.Integration.FlowEngineSectionKeys.Jobs;
    var isConfig = activeSection == WebApp.Models.Integration.FlowEngineSectionKeys.Config;
    var pageTitle = activeSection switch
    {
        WebApp.Models.Integration.FlowEngineSectionKeys.Jeeves => "Jeeves",
        WebApp.Models.Integration.FlowEngineSectionKeys.Centra => "Centra",
        WebApp.Models.Integration.FlowEngineSectionKeys.Shopify => "Shopify",
        WebApp.Models.Integration.FlowEngineSectionKeys.Akeneo => "Akeneo",
        WebApp.Models.Integration.FlowEngineSectionKeys.Jobs => "Jobbhistorik",
        WebApp.Models.Integration.FlowEngineSectionKeys.Config => "Konfiguration",
        _ => "Dashboard"
    };
    ViewData["Title"] = pageTitle;
    var pageSubtitle = activeSection switch
    {
        WebApp.Models.Integration.FlowEngineSectionKeys.Jeeves => "Jeeves-lasningar, import order och artikelkontroller inne i portalens FlowEngine.",
        WebApp.Models.Integration.FlowEngineSectionKeys.Centra => "Centra-lasningar, batcher, returer och shipment-floden som nu kor native i portalen.",
        WebApp.Models.Integration.FlowEngineSectionKeys.Shopify => "Shopify fetch, validate, send och fulfillment samlat under samma FlowEngine-arbetsyta.",
        WebApp.Models.Integration.FlowEngineSectionKeys.Akeneo => "Akeneo-export och Akeneo till Shopify-floden samlat i portalens integrationsyta.",
        WebApp.Models.Integration.FlowEngineSectionKeys.Jobs => "Senaste korningar, output och jobbdetaljer for portalens FlowEngine.",
        WebApp.Models.Integration.FlowEngineSectionKeys.Config => "Validering av runtime och integrationskonfiguration for portalens native FlowEngine.",
        _ => Model.Subtitle
    };
    var pageSummary = activeSection switch
    {
        WebApp.Models.Integration.FlowEngineSectionKeys.Jeeves => "Detta ar Jeeves-delen av FlowEngine och visar bara de operationer som hor hit.",
        WebApp.Models.Integration.FlowEngineSectionKeys.Centra => "Detta ar Centra-delen av FlowEngine och visar bara Centra-relaterade floden.",
        WebApp.Models.Integration.FlowEngineSectionKeys.Shopify => "Detta ar Shopify-delen av FlowEngine och visar bara Shopify-relaterade floden.",
        WebApp.Models.Integration.FlowEngineSectionKeys.Akeneo => "Detta ar Akeneo-delen av FlowEngine och visar bara Akeneo-relaterade floden.",
        WebApp.Models.Integration.FlowEngineSectionKeys.Jobs => "Jobbhistoriken ligger kvar i samma modul men visas som egen driftvy.",
        WebApp.Models.Integration.FlowEngineSectionKeys.Config => "Konfiguration och preflight visas separat sa driftkontroller inte blandas med operativa floden.",
        _ => Model.Summary
    };
    var selectedJobAction = activeSection switch
    {
        WebApp.Models.Integration.FlowEngineSectionKeys.Jeeves => "FlowEngineJeeves",
        WebApp.Models.Integration.FlowEngineSectionKeys.Centra => "FlowEngineCentra",
        WebApp.Models.Integration.FlowEngineSectionKeys.Shopify => "FlowEngineShopify",
        WebApp.Models.Integration.FlowEngineSectionKeys.Akeneo => "FlowEngineAkeneo",
        WebApp.Models.Integration.FlowEngineSectionKeys.Jobs => "FlowEngineJobs",
        WebApp.Models.Integration.FlowEngineSectionKeys.Config => "FlowEngineConfig",
        _ => "FlowEngine"
    };
    var historyTotalCount = activeSection switch
    {
        WebApp.Models.Integration.FlowEngineSectionKeys.Jeeves => Model.JeevesHistory.TotalCount,
        WebApp.Models.Integration.FlowEngineSectionKeys.Centra => Model.CentraHistory.TotalCount,
        WebApp.Models.Integration.FlowEngineSectionKeys.Shopify => Model.ShopifyHistory.TotalCount,
        WebApp.Models.Integration.FlowEngineSectionKeys.Akeneo => Model.AkeneoHistory.TotalCount,
        _ => Model.DashboardHistory.TotalCount
    };
    var latestJobLocal = Model.RecentJobs.FirstOrDefault()?.CreatedAtUtc.ToLocalTime();
    var headerMeta = latestJobLocal.HasValue
        ? $"Updated {latestJobLocal.Value:dd MMM yyyy HH:mm:ss} • {Math.Max(historyTotalCount, 1)} jobb i historik"
        : string.Empty;
    var defaultGlobalTestMode = true;
    var defaultGlobalDryRun = isCentra
        ? Model.Forms.SendOrders.DryRun
        : isShopify
            ? Model.Forms.ShopifySendOrders.DryRun || Model.Forms.CompleteOrders.DryRun || Model.Forms.CompleteOrder.DryRun
            : isJeeves
                ? Model.Forms.ImportOrder.DryRun
                : false;
    var defaultGlobalSkipJeevesCheck = isCentra
        ? Model.Forms.SendOrders.SkipJeevesCheck
        : isShopify
            ? Model.Forms.ShopifySendOrders.SkipJeevesCheck
            : false;
    var defaultGlobalUseLimit = true;
    var defaultGlobalLimit = Model.Forms.CheckOrders.Limit
        ?? Model.Forms.SendOrders.Limit
        ?? Model.Forms.CreateShipments.Limit
        ?? Model.Forms.ShopifySendOrders.Limit
        ?? Model.Forms.CompleteOrders.Limit
        ?? Model.Forms.ShopifyGetProducts.Limit
        ?? Model.Forms.AkeneoAllProducts.Limit
        ?? 10;
    var selectedCentraJob = Model.CentraHistory.Jobs.FirstOrDefault(job => Model.SelectedJob?.Id == job.Id);
    var selectedShopifyJob = Model.ShopifyHistory.Jobs.FirstOrDefault(job => Model.SelectedJob?.Id == job.Id);
    var selectedJeevesJob = Model.JeevesHistory.Jobs.FirstOrDefault(job => Model.SelectedJob?.Id == job.Id);
    var selectedAkeneoJob = Model.AkeneoHistory.Jobs.FirstOrDefault(job => Model.SelectedJob?.Id == job.Id);
    var workbenchSettings = Model.WorkbenchSettings ?? new WebApp.Models.Integration.FlowEngineWorkbenchSettingsState();
    var hasActiveJobs = Model.RecentJobs.Any(job => job.Status == WebApp.Models.Integration.FlowEngineJobStatus.Queued || job.Status == WebApp.Models.Integration.FlowEngineJobStatus.Running)
        || Model.SelectedJob?.Status is WebApp.Models.Integration.FlowEngineJobStatus.Queued or WebApp.Models.Integration.FlowEngineJobStatus.Running;
    var historyCardId = activeSection switch
    {
        WebApp.Models.Integration.FlowEngineSectionKeys.Jeeves => "flowengine-jeeves-history",
        WebApp.Models.Integration.FlowEngineSectionKeys.Centra => "flowengine-centra-history",
        WebApp.Models.Integration.FlowEngineSectionKeys.Shopify => "flowengine-shopify-history",
        WebApp.Models.Integration.FlowEngineSectionKeys.Akeneo => "flowengine-akeneo-history",
        _ => "flowengine-dashboard-history"
    };
    var currentPageUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var initialSnapshotVersionParts = new List<string>
    {
        activeSection,
        $"active:{Model.RecentJobs.Count(job => job.Status == WebApp.Models.Integration.FlowEngineJobStatus.Queued || job.Status == WebApp.Models.Integration.FlowEngineJobStatus.Running)}"
    };

    if (Model.SelectedJob is not null)
    {
        initialSnapshotVersionParts.Add(
            $"selected:{Model.SelectedJob.Id:N}:{Model.SelectedJob.Status}:{Model.SelectedJob.CreatedAtUtc.UtcTicks}:{Model.SelectedJob.StartedAtUtc?.UtcTicks}:{Model.SelectedJob.FinishedAtUtc?.UtcTicks}:{Model.SelectedJob.ErrorMessage}");
    }

    foreach (var job in Model.RecentJobs.Take(8))
    {
        initialSnapshotVersionParts.Add(
            $"{job.Id:N}:{job.Status}:{job.CreatedAtUtc.UtcTicks}:{job.StartedAtUtc?.UtcTicks}:{job.FinishedAtUtc?.UtcTicks}:{job.ErrorMessage}");
    }

    var initialSnapshotVersion = string.Join("|", initialSnapshotVersionParts);
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-readable module-page flowengine-page flowengine-page--@activeSection"
     id="flowengine-section-dashboard"
     data-flowengine-page="true"
     data-flowengine-section="@activeSection"
     data-flowengine-selected-job-id="@(Model.SelectedJob?.Id.ToString("N") ?? string.Empty)"
     data-flowengine-live-url="@Url.Action(nameof(WebApp.Controllers.IntegrationController.FlowEngineStatusSnapshot), "Integration", new { section = activeSection, selectedJobId = Model.SelectedJob?.Id })"
     data-flowengine-refresh-url="@currentPageUrl"
     data-flowengine-history-card-id="@historyCardId"
     data-flowengine-initial-version="@initialSnapshotVersion"
     data-flowengine-has-active-jobs="@(hasActiveJobs ? "true" : "false")">
    @await Html.PartialAsync("_Alert")
    <div id="flowengine-modal-host"></div>
    <div hidden aria-hidden="true" data-fe-workbench-token>
        @Html.AntiForgeryToken()
    </div>
    <div class="module-page-header">
        <div>
            <div class="dashboard-card-title">Integration</div>
        </div>
        <a asp-controller="Member" asp-action="Index" class="btn btn-sm btn-portal btn-portal-outline">
            <i class="fa fa-arrow-left me-1"></i> Till dashboard
        </a>
    </div>

    <div class="card shadow-sm border-0 flowengine-surface-card flowengine-workbench-header-card mb-4">
        <div class="card-body flowengine-workbench-header">
            <div class="flowengine-workbench-copy">
                <h1 class="flowengine-workbench-title">@pageTitle</h1>
                <div class="flowengine-workbench-pills"
                     data-fe-health-pills
                     data-fe-health-section="@activeSection"
                     data-fe-health-dashboard="@(isDashboard.ToString().ToLowerInvariant())">
                    <span class="flowengine-health-pill flowengine-health-pill--loading" data-fe-health-loading>Checking status...</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(headerMeta))
                {
                    <div class="flowengine-workbench-meta">@headerMeta</div>
                }
            </div>

            <div class="flowengine-workbench-tools">
                <div class="flowengine-workbench-date">@DateTimeOffset.Now.ToString("dddd, d MMM yyyy • HH:mm")</div>
                <div class="flowengine-workbench-actions">
                    <span class="flowengine-chip flowengine-chip--warning" data-fe-indicator="test" hidden>
                        <span class="flowengine-chip-dot"></span>
                        TEST
                    </span>
                    <span class="flowengine-chip flowengine-chip--muted" data-fe-indicator="dryrun" hidden>
                        <span class="flowengine-chip-dot"></span>
                        DRY RUN
                    </span>
                    <span class="flowengine-chip flowengine-chip--limit" data-fe-indicator="limit" hidden>
                        <span>LIMIT</span>
                        <span data-fe-indicator-value="limit">@defaultGlobalLimit</span>
                    </span>

                    <div class="flowengine-popover-anchor">
                        <button type="button" class="flowengine-chip flowengine-chip--button" data-fe-toggle="global-flags">
                            <span class="flowengine-chip-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none">
                                    <path d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.28c.149.05.296.107.44.17l1.15-.7a1.125 1.125 0 0 1 1.353.135l1.833 1.833c.39.39.444.997.136 1.353l-.7 1.15c.063.144.12.291.17.44l1.28.213c.542.09.94.56.94 1.11v2.593c0 .55-.398 1.02-.94 1.11l-1.28.213a5.97 5.97 0 0 1-.17.44l.7 1.15c.308.506.254 1.113-.136 1.503l-1.833 1.833a1.125 1.125 0 0 1-1.353.135l-1.15-.7a5.97 5.97 0 0 1-.44.17l-.213 1.28a1.125 1.125 0 0 1-1.11.94h-2.593a1.125 1.125 0 0 1-1.11-.94l-.213-1.28a5.97 5.97 0 0 1-.44-.17l-1.15.7a1.125 1.125 0 0 1-1.353-.135L3.69 18.31a1.125 1.125 0 0 1-.135-1.353l.7-1.15a5.97 5.97 0 0 1-.17-.44l-1.28-.213a1.125 1.125 0 0 1-.94-1.11v-2.593c0-.55.398-1.02.94-1.11l1.28-.213c.05-.149.107-.296.17-.44l-.7-1.15a1.125 1.125 0 0 1 .135-1.353L5.523 4.535a1.125 1.125 0 0 1 1.353-.135l1.15.7c.144-.063.291-.12.44-.17l.213-1.28Z" />
                                    <path d="M12 15.75a3.75 3.75 0 1 0 0-7.5 3.75 3.75 0 0 0 0 7.5Z" />
                                </svg>
                            </span>
                            <span>Global Flags</span>
                            <span class="flowengine-chip-count" data-fe-flag-count hidden></span>
                        </button>

                        <div class="flowengine-popover flowengine-flags-popover" data-fe-popover="global-flags" hidden>
                            <div class="flowengine-popover-title">Global Flags</div>
                            <label class="flowengine-toggle-row">
                                <span>Test mode</span>
                                <span class="flowengine-switch">
                                    <input type="checkbox" data-fe-flag="testMode" />
                                    <span class="flowengine-switch-slider"></span>
                                </span>
                            </label>
                            <label class="flowengine-toggle-row">
                                <span>Dry run</span>
                                <span class="flowengine-switch">
                                    <input type="checkbox" data-fe-flag="dryRun" />
                                    <span class="flowengine-switch-slider"></span>
                                </span>
                            </label>
                            <label class="flowengine-toggle-row">
                                <span>Debug HTTP</span>
                                <span class="flowengine-switch">
                                    <input type="checkbox" data-fe-flag="debugHttp" />
                                    <span class="flowengine-switch-slider"></span>
                                </span>
                            </label>
                            <label class="flowengine-toggle-row">
                                <span>Skip Jeeves check</span>
                                <span class="flowengine-switch">
                                    <input type="checkbox" data-fe-flag="skipJeevesCheck" />
                                    <span class="flowengine-switch-slider"></span>
                                </span>
                            </label>
                            <label class="flowengine-toggle-row">
                                <span>Use limit</span>
                                <span class="flowengine-switch">
                                    <input type="checkbox" data-fe-flag="useLimit" />
                                    <span class="flowengine-switch-slider"></span>
                                </span>
                            </label>
                            <div class="flowengine-limit-row">
                                <div class="flowengine-limit-meta">
                                    <span>Limit: <span data-fe-limit-label>@defaultGlobalLimit</span></span>
                                    <span>1-500</span>
                                </div>
                                <input type="range" min="1" max="500" value="@defaultGlobalLimit" data-fe-limit-slider />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (isDashboard)
    {
        <div class="row g-3 mb-4">
            <div class="col-12">
                <partial name="FlowEngine/Partials/_FlowEngineHistoryPanel"
                         model='new WebApp.Models.Integration.FlowEngineHistoryPanelViewModel
                         {
                             CardId = "flowengine-dashboard-history",
                             Title = "Execution History",
                             Subtitle = "All systems (session only)",
                             EmptyMessage = "Inga FlowEngine-jobb har körts i den här portalmiljön än.",
                             SelectedJobAction = selectedJobAction,
                             Fragment = "flowengine-dashboard-history",
                             ShowSystemColumn = true,
                             EnableFilters = true,
                             ShowDetail = true,
                             Jobs = Model.DashboardHistory.Jobs,
                             SelectedJob = Model.SelectedJob,
                             CurrentPage = Model.DashboardHistory.CurrentPage,
                             TotalPages = Model.DashboardHistory.TotalPages,
                             TotalCount = Model.DashboardHistory.TotalCount,
                             PageSize = Model.DashboardHistory.PageSize,
                             Filters = Model.DashboardHistory.Filters,
                             AvailableSystems = Model.DashboardHistory.AvailableSystems,
                             AvailableOperations = Model.DashboardHistory.AvailableOperations,
                             AvailableStatuses = Model.DashboardHistory.AvailableStatuses
                         }' />
            </div>
        </div>
    }

    @if (Model.CanRunReadOperations)
    {
        @if (isCentra)
        {
            <partial name="FlowEngine/Partials/_FlowEngineCentraSection" model="Model" />
        }

        @if (isShopify)
        {
            <partial name="FlowEngine/Partials/_FlowEngineShopifySection" model="Model" />
        }

        @if (isAkeneo)
        {
            <div class="row g-3 mb-4">
                <div class="col-12">
                    <div class="card shadow-sm border-0 flowengine-surface-card flowengine-akeneo-console" id="flowengine-section-akeneo">
                        <div class="card-body">
                            <div class="flowengine-akeneo-console-header">
                                <div>
                                    <div class="dashboard-card-title mb-2">Akeneo</div>
                                </div>
                            </div>

                            <div class="d-grid gap-3">
                                <form method="post" class="flowengine-akeneo-card">
                                    @Html.AntiForgeryToken()
                                    <div class="flowengine-akeneo-console-title">Export products to Jeeves</div>
                                    <div class="module-page-meta mb-3">Export Akeneo products for Jeeves import</div>
                                    <label class="form-label text-muted small">SKU:er</label>
                                    <input name="Skus" value="@Model.Forms.AkeneoProducts.Skus" class="form-control mb-3" placeholder="Comma or space separated" />
                                    <div class="flowengine-akeneo-console-actions">
                                        <button type="submit" formaction="@Url.Action("FlowEngineRunAkeneoProducts", "Integration")" class="btn btn-portal btn-portal-outline">@sharedLocalizer["FlowEngine_GetProducts"]</button>
                                        <button type="submit" formaction="@Url.Action("FlowEngineRunAkeneoAllProducts", "Integration")" class="btn btn-portal btn-portal-outline">@sharedLocalizer["FlowEngine_GetAllProducts"]</button>
                                    </div>
                                </form>

                                <div class="flowengine-akeneo-card">
                                    <div class="flowengine-akeneo-console-grid">
                                        <form method="post" class="flowengine-akeneo-console-panel">
                                            @Html.AntiForgeryToken()
                                            <div class="flowengine-akeneo-console-title">@sharedLocalizer["FlowEngine_SendToShopify"]</div>
                                            <div class="module-page-meta mb-3">Dry-run policy diff only (no Shopify writes)</div>
                                            <label class="form-label text-muted small">SKU (optional)</label>
                                            <input name="Sku" value="@Model.Forms.AkeneoSendToShopify.Sku" class="form-control mb-3" placeholder="e.g. 16679" />
                                            <div class="flowengine-akeneo-console-actions">
                                                <button type="submit" formaction="@Url.Action("FlowEngineRunAkeneoSendToShopify", "Integration")" class="btn btn-portal btn-portal-outline">@sharedLocalizer["FlowEngine_SendToShopify"]</button>
                                            </div>
                                            <div class="module-page-meta small mt-3">Enable the global Dry run flag to run this operation.</div>
                                        </form>

                                        <div class="flowengine-akeneo-console-panel">
                                            <form method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="flowengine-akeneo-console-title">@sharedLocalizer["FlowEngine_SendToCentra"]</div>
                                                <div class="module-page-meta mb-3">Dry-run XML handoff for the Centra flow</div>
                                                <label class="form-label text-muted small">SKU (optional)</label>
                                                <input name="Sku" value="@Model.Forms.AkeneoSendToCentra.Sku" class="form-control mb-3" placeholder="e.g. 16679" />
                                                <div class="flowengine-akeneo-console-actions">
                                                    <button type="submit" formaction="@Url.Action("FlowEngineRunAkeneoSendToCentra", "Integration")" class="btn btn-portal btn-portal-outline">@sharedLocalizer["FlowEngine_SendToCentra"]</button>
                                                </div>
                                                <div class="module-page-meta small mt-3">Runs as dry run and stores the generated Centra handoff XML in job history.</div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-12">
                    <partial name="FlowEngine/Partials/_FlowEngineHistoryPanel"
                             model='new WebApp.Models.Integration.FlowEngineHistoryPanelViewModel
                             {
                                 CardId = "flowengine-akeneo-history",
                                 Title = "Execution History",
                                 Subtitle = "Akeneo-körningar i den här portalmiljön.",
                                 EmptyMessage = "Inga Akeneo-jobb har körts i den här portalmiljön än.",
                                 SelectedJobAction = selectedJobAction,
                                 Fragment = "flowengine-akeneo-history",
                                 ShowSystemColumn = false,
                                 EnableFilters = false,
                                 ShowDetail = true,
                                 Jobs = Model.AkeneoHistory.Jobs,
                                 SelectedJob = selectedAkeneoJob,
                                 CurrentPage = Model.AkeneoHistory.CurrentPage,
                                 TotalPages = Model.AkeneoHistory.TotalPages,
                                 TotalCount = Model.AkeneoHistory.TotalCount,
                                 PageSize = Model.AkeneoHistory.PageSize
                             }' />
                </div>
            </div>
        }

        @if (isJeeves)
        {
            <div class="row g-3 mb-4">
                <div class="col-12">
                    <div class="card shadow-sm border-0 flowengine-surface-card flowengine-jeeves-console" id="flowengine-section-jeeves">
                        <div class="card-body">
                            <div class="flowengine-jeeves-import-console">
                                <form method="post" asp-action="FlowEngineRunImportOrder" enctype="multipart/form-data">
                                    @Html.AntiForgeryToken()
                                    @{
                                        var importLineRows = (Model.Forms.ImportOrder.Lines ?? string.Empty)
                                            .Replace("\r", string.Empty, StringComparison.Ordinal)
                                            .Split('\n', StringSplitOptions.RemoveEmptyEntries)
                                            .Select(line =>
                                            {
                                                var parts = line.Split(new[] { ';', '\t' }, StringSplitOptions.None);
                                                return new
                                                {
                                                    Article = parts.ElementAtOrDefault(0)?.Trim() ?? string.Empty,
                                                    Quantity = parts.ElementAtOrDefault(1)?.Trim() ?? string.Empty,
                                                    Price = parts.ElementAtOrDefault(2)?.Trim() ?? string.Empty
                                                };
                                            })
                                            .ToList();
                                        const int importSheetRowCount = 15;
                                        const int importSheetVisibleRowCount = 5;
                                        var importSheetLineCount = importLineRows.Count(row => !string.IsNullOrWhiteSpace(row.Article));
                                        decimal importSheetQuantityTotal = 0;
                                        foreach (var importRow in importLineRows)
                                        {
                                            if (string.IsNullOrWhiteSpace(importRow.Quantity))
                                            {
                                                continue;
                                            }

                                            var normalizedQuantity = importRow.Quantity.Replace(',', '.');
                                            if (decimal.TryParse(normalizedQuantity, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var parsedQuantity))
                                            {
                                                importSheetQuantityTotal += parsedQuantity;
                                            }
                                        }
                                        var articleNumbersForStatus = string.Join(Environment.NewLine, importLineRows
                                            .Select(row => row.Article)
                                            .Where(article => !string.IsNullOrWhiteSpace(article)));
                                        var importArtStatusLookup = Model.ImportArtStatusRows
                                            .Where(row => !string.IsNullOrWhiteSpace(row.ArticleNumber))
                                            .GroupBy(row => row.ArticleNumber.Trim(), StringComparer.OrdinalIgnoreCase)
                                            .ToDictionary(group => group.Key, group => group.First(), StringComparer.OrdinalIgnoreCase);
                                        var importArtStatusMatchedCount = importLineRows
                                            .Select(row => row.Article?.Trim())
                                            .Where(article => !string.IsNullOrWhiteSpace(article))
                                            .Distinct(StringComparer.OrdinalIgnoreCase)
                                            .Count(article => importArtStatusLookup.ContainsKey(article!));
                                        var importArtStatusImportableCount = importArtStatusLookup.Values.Count(row => row.Importable);
                                        var importArtStatusBlockedCount = importArtStatusLookup.Values.Count(row => !row.Importable);
                                        var showImportDocumentReview =
                                            !string.IsNullOrWhiteSpace(Model.ImportDocumentReview?.FileName)
                                            || !string.IsNullOrWhiteSpace(Model.ImportDocumentReview?.ErrorMessage)
                                            || Model.ImportDocumentReview?.Source is not null
                                            || (Model.ImportDocumentReview?.Lines?.Count ?? 0) > 0;
                                    }
                                    <div class="flowengine-jeeves-console-title">@sharedLocalizer["FlowEngine_Jeeves_ImportOrder"]</div>
                                    <textarea name="Lines" class="d-none" data-fe-import-lines>@Model.Forms.ImportOrder.Lines</textarea>
                                    <input type="hidden" name="ArticleNumbers" value="@articleNumbersForStatus" data-fe-art-status-input />
                                    <input type="file" name="ImportDocument" accept=".pdf,.doc,.docx,.xlsx,.csv,.tsv" class="d-none" data-fe-import-document-input />

                                    <div class="flowengine-jeeves-import-grid">
                                        <div>
                                            <label class="form-label text-muted small">@sharedLocalizer["FlowEngine_Jeeves_CompanyId"]</label>
                                            <select class="form-select" disabled>
                                                <option>@(string.IsNullOrWhiteSpace(Model.RuntimeCompanyName) ? sharedLocalizer["FlowEngine_Jeeves_CompanyNotLoaded"] : $"{Model.RuntimeCompanyName} ({Model.RuntimeCompanyCode ?? 0})")</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="form-label text-muted small">@sharedLocalizer["FlowEngine_Jeeves_CustomerNumber"]</label>
                                            <input name="CustomerNumber" value="@Model.Forms.ImportOrder.CustomerNumber" class="form-control" placeholder="@sharedLocalizer["FlowEngine_Jeeves_CustomerNumber_Placeholder"]" />
