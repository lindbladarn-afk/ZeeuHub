                                    {
                                        <div class="flowengine-history-warning flowengine-history-warning--detail mt-3">
                                            <i class="fa fa-circle-info"></i>
                                            <span>Artikelstatus kontrollerad för @importArtStatusMatchedCount artikelnummer. OK: @importArtStatusImportableCount · Kräver åtgärd: @importArtStatusBlockedCount</span>
                                        </div>
                                    }

                                    @if (showImportDocumentReview)
                                    {
                                        <div class="flowengine-review-surface mt-4">
                                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                                                <div class="dashboard-card-title mb-0">@sharedLocalizer["FlowEngine_Jeeves_DocumentReview"]</div>
                                                @if (Model.ImportDocumentReview?.Source is not null)
                                                {
                                                    <span class="flowengine-readiness-pill flowengine-readiness-pill--progress">@Model.ImportDocumentReview.Source.Label</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(Model.ImportDocumentReview?.FileName))
                                            {
                                                <div class="module-page-meta small mb-2">@sharedLocalizer["FlowEngine_Jeeves_File"]: @Model.ImportDocumentReview.FileName</div>
                                            }
