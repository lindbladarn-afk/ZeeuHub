                                            {
                                                <div class="alert alert-danger py-2 px-3 mb-2">@Model.ImportDocumentReview.ErrorMessage</div>
                                            }
                                            @if (Model.ImportDocumentReview?.Source is not null)
                                            {
                                                <div class="module-page-meta small mb-3">@Model.ImportDocumentReview.Source.Detail</div>
                                            }
                                            @if (Model.ImportDocumentReview?.Lines?.Count > 0)
                                            {
                                                <div class="table-responsive flowengine-review-table-wrap">
                                                    <table class="table table-sm mb-3 flowengine-review-table">
                                                        <thead>
                                                            <tr>
                                                                <th>#</th>
                                                                <th>@sharedLocalizer["FlowEngine_Jeeves_ArticleOrEan"]</th>
                                                                <th>@sharedLocalizer["FlowEngine_Jeeves_Quantity"]</th>
