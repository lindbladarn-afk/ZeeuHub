@* Renders the purchase acknowledgement snapshot for the information-driven dashboard layout. *@
@model WebApp.Models.Dashboard.DashboardCardViewModel
@using System.Globalization
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    var card = Model.Data as WebApp.Models.Dashboard.PurchaseAcknowledgementCardViewModel ?? new();
    var recentOrders = card.RecentOrders.ToList();
    var totalOrderValue = recentOrders.Sum(x => x.OrderValue);
    var latestDueDate = recentOrders
        .Select(x => x.DeliveryDate)
        .Where(x => x.HasValue)
        .Select(x => x!.Value)
        .OrderByDescending(x => x)
        .FirstOrDefault();
}

<div class="card kpi-card p-2 dashboard-info-card">
    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
        <div>
            <h5 class="dashboard-card-title m-0">Ordererkännande</h5>
            <div class="dashboard-card-subtitle">Status på inköpsorder som väntar på bekräftelse eller leverans</div>
        </div>
        <a asp-controller="Purchase" asp-action="PurchaseOrders" class="btn btn-portal btn-portal-outline btn-sm dashboard-card-action-btn flex-shrink-0">
            Öppna
        </a>
    </div>

    <div class="dashboard-info-summary-grid dashboard-info-summary-grid--2">
        <div class="dashboard-info-summary-card">
            <div class="dashboard-info-summary-label">Totalt</div>
            <div class="dashboard-info-summary-value">@card.TotalOrders</div>
            <div class="dashboard-info-summary-meta">aktiva orderrader</div>
        </div>
        <div class="dashboard-info-summary-card">
            <div class="dashboard-info-summary-label">Väntar</div>
            <div class="dashboard-info-summary-value">@card.AwaitingAcknowledgementCount</div>
            <div class="dashboard-info-summary-meta">saknar bekräftelse</div>
        </div>
        <div class="dashboard-info-summary-card">
            <div class="dashboard-info-summary-label">Beställda</div>
            <div class="dashboard-info-summary-value">@card.OrderedCount</div>
            <div class="dashboard-info-summary-meta">skickade till leverantör</div>
        </div>
        <div class="dashboard-info-summary-card">
            <div class="dashboard-info-summary-label">Försenade</div>
            <div class="dashboard-info-summary-value">@card.OverdueCount</div>
            <div class="dashboard-info-summary-meta">passerat leveransdatum</div>
        </div>
    </div>

    <div class="dashboard-info-status-strip dashboard-info-status-strip--info">
        <span class="dashboard-info-status-strip__label">Ordervärde</span>
        <span class="dashboard-info-status-strip__value">@totalOrderValue.ToString("N0", CultureInfo.CurrentCulture) kr</span>
        <span class="dashboard-info-status-strip__meta">
            @(latestDueDate > DateTime.MinValue
                ? $"Senast förväntad leverans {latestDueDate:yyyy-MM-dd}"
                : "Inga leveransdatum registrerade")
        </span>
    </div>

    @if (recentOrders.Count > 0)
    {
        <div class="dashboard-info-list list-group list-group-flush bg-transparent">
            @foreach (var order in recentOrders)
            {
                <div class="list-group-item bg-transparent border-0 px-0 py-2">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div class="flex-grow-1">
                            <div class="fw-bold text-truncate">@order.SupplierName</div>
                            <div class="small dashboard-info-muted">#@(order.OrderNumber?.ToString() ?? "-")</div>
                        </div>
                        <span class="badge rounded-pill @(order.IsOverdue ? "bg-danger-subtle text-danger" : "bg-secondary-subtle text-secondary")">
                            @order.StatusLabel
                        </span>
                    </div>
                    <div class="small dashboard-info-muted mt-1">
                        @(order.DeliveryDate.HasValue ? order.DeliveryDate.Value.ToString("yyyy-MM-dd", CultureInfo.CurrentCulture) : "-")
                        · @order.OrderValue.ToString("N0", CultureInfo.CurrentCulture) @order.Currency
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="small dashboard-info-muted">Inga inköpsorder att visa just nu.</div>
    }
</div>
