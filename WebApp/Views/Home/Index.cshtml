@using System.Globalization
@using System.Linq
@{
    // Public landing page shown when the user is signed out.
    // The module cards are defined once below and rendered from a single shared layout.
    ViewData["Title"] = "ZeeU Hub";
    ViewData["AppSidebarNone"] = "true";
    ViewData["AppClass"] = "app-without-sidebar";

    var productModules = new[]
    {
        new
        {
            Title = "ZeeU Dashboard",
            Icon = "fas fa-chart-line",
            Accent = "dashboard",
            Summary = "Få affärsinsikter i realtid med omsättning, snittordervärde, fakturastatus och toppsäljande produkter för aktivt bolag.",
            Highlights = new[] { "Rullande 12 mån", "Tydliga KPI-underlag", "Företagsstyrd vy" }
        },
        new
        {
            Title = "ZeeU Intelligence",
            Icon = "fa fa-magic",
            Accent = "intelligence",
            Summary = "Ställ frågor om orders, fakturor och trender och få svar direkt från er aktiva datakälla med tydlig bolagskontext.",
            Highlights = new[] { "Fråga i klartext", "SQL-stöd vid behov", "Bygger på aktiv tenant" }
        },
        new
        {
            Title = "NotifyMe",
            Icon = "fas fa-broadcast-tower",
            Accent = "notifyme",
            Summary = "Sätt upp notifieringar och varningar på era egna villkor och följ historik, aktivitet och träffsäkerhet direkt i portalen.",
            Highlights = new[] { "Egendefinierade regler", "Översikt, bibliotek och statistik", "Kopplat till Jeeves-data" }
        },
        new
        {
            Title = "Excelimport",
            Icon = "fas fa-file-excel",
            Accent = "excel",
            Summary = "Importera Excelunderlag till portalen med tydlig validering, strukturkontroll och stöd för återkommande arbetsflöden.",
            Highlights = new[] { "Import per bolag", "Validering före import", "Snabb väg från fil till data" }
        },
        new
        {
            Title = "ZeeU Action Center",
            Icon = "fas fa-bolt",
            Accent = "action",
            Summary = "Samla de viktigaste insikterna, avvikelserna och nästa stegen i en arbetsyta som hjälper användaren att prioritera rätt.",
            Highlights = new[] { "Prioriterade insikter", "Koppling till fakturor och orders", "Byggt för uppföljning" }
        },
        new
        {
            Title = "Web Approval",
            Icon = "fas fa-thumbs-up",
            Accent = "approval",
            Summary = "Samla in godkännanden digitalt via webbflöden och få spårbar återkoppling tillbaka till Jeeves.",
            Highlights = new[] { "GDPR och samtycken", "Spårbar status", "Mindre manuellt arbete" }
        },
        new
        {
            Title = "Bankavstämning",
            Icon = "fas fa-file-invoice",
            Accent = "reconciliation",
            Summary = "Importera bankfiler och matcha transaktioner mot fakturor för snabbare och tydligare avstämningsarbete.",
            Highlights = new[] { "camt.053-import", "Sessionbaserad matchning", "Förberett för vidare importflöde" }
        },
        new
        {
            Title = "Integrationer",
            Icon = "fas fa-plug",
            Accent = "integration",
            Summary = "Knyt ihop portal, Jeeves och externa källor så att rätt data blir tillgänglig i rätt modul och rätt bolagskontext.",
            Highlights = new[] { "Hybrid Connector", "Datakällor per bolag", "Kontrollerad åtkomst" }
        },
        new
        {
            Title = "Ordergodkännande",
            Icon = "fas fa-clipboard-check",
            Accent = "orders",
            Summary = "Hantera orderflöden med tydligare status, uppföljning och framtida leveransperspektiv för användare som behöver agera snabbt.",
            Highlights = new[] { "Orderstatus i portal", "Leveransfokus", "Förberett för vidare statistik" }
        }
    };
}

<style>
    /* Signed-out landing page for ZeeU modules. */
    .home-hero {
        padding: 2rem 0 1.25rem;
    }

    .home-eyebrow {
        color: rgba(255, 255, 255, 0.58);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .home-title {
        margin: 0.35rem 0 0.65rem;
        color: #f7fbff;
        font-size: clamp(2.1rem, 4vw, 3.35rem);
        font-weight: 800;
        line-height: 1.02;
    }

    .home-lead {
        max-width: 860px;
        margin: 0;
        color: rgba(226, 234, 247, 0.8);
        font-size: 1rem;
        line-height: 1.7;
    }

    .module-grid {
        row-gap: 1.35rem;
    }

    .module-card {
        position: relative;
        height: 100%;
        min-height: 300px;
        padding: 1.35rem 1.35rem 1.2rem;
        border: 1px solid rgba(120, 139, 169, 0.2);
        border-radius: 22px;
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.015)),
            rgba(22, 31, 47, 0.92);
        box-shadow: 0 18px 45px rgba(3, 9, 20, 0.2);
        overflow: hidden;
    }

    .module-card::before {
        content: "";
        position: absolute;
        inset: 0 auto auto 0;
        width: 100%;
        height: 3px;
        background: var(--module-accent, #38bdf8);
        opacity: 0.85;
    }

    .module-card__icon {
        width: 52px;
        height: 52px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        margin-bottom: 1rem;
        background: color-mix(in srgb, var(--module-accent, #38bdf8) 18%, rgba(255, 255, 255, 0.04));
        color: #f7fbff;
        font-size: 1.1rem;
        box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--module-accent, #38bdf8) 32%, transparent);
    }

    .module-card__title {
        margin: 0 0 0.55rem;
        color: #f7fbff;
        font-size: 1.28rem;
        font-weight: 750;
        letter-spacing: -0.02em;
    }

    .module-card__summary {
        margin: 0 0 1rem;
        color: rgba(226, 234, 247, 0.78);
        line-height: 1.68;
        min-height: 5.8rem;
    }

    .module-card__highlights {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .module-card__highlights li {
        padding: 0.42rem 0.72rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.06);
        color: rgba(236, 243, 252, 0.84);
        font-size: 0.8rem;
        font-weight: 600;
    }

    .module-accent--dashboard { --module-accent: #60a5fa; }
    .module-accent--intelligence { --module-accent: #22d3ee; }
    .module-accent--notifyme { --module-accent: #38bdf8; }
    .module-accent--excel { --module-accent: #22c55e; }
    .module-accent--action { --module-accent: #f59e0b; }
    .module-accent--approval { --module-accent: #10b981; }
    .module-accent--reconciliation { --module-accent: #a78bfa; }
    .module-accent--integration { --module-accent: #fb7185; }
    .module-accent--orders { --module-accent: #34d399; }

    body:not(.theme-dark) .app-content {
        background:
            radial-gradient(circle at top left, rgba(96, 165, 250, 0.08), rgba(255, 255, 255, 0) 34%),
            linear-gradient(180deg, #f8fafc 0%, #eef2f7 100%);
    }

    body:not(.theme-dark) .home-hero {
        padding-top: 2.35rem;
    }

    body:not(.theme-dark) .home-eyebrow {
        color: rgba(15, 23, 42, 0.56);
    }

    body:not(.theme-dark) .home-title {
        color: #0f172a;
        text-shadow: none;
    }

    body:not(.theme-dark) .home-lead {
        color: rgba(15, 23, 42, 0.72);
    }

    body:not(.theme-dark) .module-card {
        border-color: rgba(148, 163, 184, 0.24);
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.95), rgba(248, 250, 252, 0.92)),
            #ffffff;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
    }

    body:not(.theme-dark) .module-card__icon {
        background: color-mix(in srgb, var(--module-accent, #38bdf8) 22%, #ffffff);
        color: color-mix(in srgb, var(--module-accent, #38bdf8) 74%, #0f172a);
        box-shadow:
            inset 0 0 0 1px color-mix(in srgb, var(--module-accent, #38bdf8) 42%, transparent),
            0 8px 18px color-mix(in srgb, var(--module-accent, #38bdf8) 14%, transparent);
    }

    body:not(.theme-dark) .module-card__title {
        color: #0f172a;
    }

    body:not(.theme-dark) .module-card__summary {
        color: rgba(15, 23, 42, 0.72);
    }

    body:not(.theme-dark) .module-card__highlights li {
        background: rgba(148, 163, 184, 0.15);
        color: rgba(15, 23, 42, 0.74);
    }
</style>

<div class="container-fluid px-4 px-xl-5">
    <section class="home-hero">
        <div class="home-eyebrow">ZeeU Modules</div>
        <h1 class="home-title">En portal för affärsdata, notifieringar och operativa arbetsflöden.</h1>
        <p class="home-lead">
            ZeeU Hub samlar dashboard, intelligence, integrationer och uppföljning i ett gemensamt gränssnitt.
            När användaren loggar in visas moduldata per bolag, behörighet och aktiv ForetagKod.
        </p>
    </section>

    <div class="row module-grid">
        @foreach (var module in productModules)
        {
            <div class="col-sm-6 col-xl-4">
                <article class="module-card module-accent--@module.Accent">
                    <div class="module-card__icon" aria-hidden="true">
                        <i class="@module.Icon"></i>
                    </div>
                    <h2 class="module-card__title">@module.Title</h2>
                    <p class="module-card__summary">@module.Summary</p>
                    <ul class="module-card__highlights">
                        @foreach (var highlight in module.Highlights.Where(x => !string.IsNullOrWhiteSpace(x)))
                        {
                            <li>@highlight</li>
                        }
                    </ul>
                </article>
            </div>
        }
    </div>
</div>
