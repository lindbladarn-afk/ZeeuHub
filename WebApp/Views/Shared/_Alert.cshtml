@using WebApp.Helpers;
@using WebApp.Models;

@{
    var currentScope = ScopedAlertTempDataHelper.BuildScope(
        ViewContext.RouteData.Values["controller"]?.ToString(),
        ViewContext.RouteData.Values["action"]?.ToString());

    var scopedAlerts = ScopedAlertTempDataHelper.Read(TempData, peek: true);
    var matchingScopedAlerts = scopedAlerts
        .Where(alert => string.Equals(alert.Scope, currentScope, StringComparison.OrdinalIgnoreCase))
        .ToList();

    if (matchingScopedAlerts.Count > 0)
    {
        var remainingScopedAlerts = scopedAlerts
            .Where(alert => !string.Equals(alert.Scope, currentScope, StringComparison.OrdinalIgnoreCase))
            .ToList();

        ScopedAlertTempDataHelper.Write(TempData, remainingScopedAlerts);
    }
}

@foreach (var scopedAlert in matchingScopedAlerts)
{
    <div class="alert alert-@scopedAlert.Level">
        @scopedAlert.Message
    </div>
}

@if (TempData.ContainsKey(Alert.ATTENTION))
{
    <div class="alert alert-block">
        <a class="close" data-dismiss="alert" href="#">x</a>
        <h4 class="alert-heading">Attention!</h4>
        @TempData[Alert.ATTENTION]
    </div>
}

@foreach (string key in Alert.ALL.Except(new[] { Alert.ATTENTION }))
{
    if (TempData.ContainsKey(key))
    {
        <div class="alert alert-@key">
            @*<button type="button" class="close" data-dismiss="alert">x</button>*@
            @TempData[key]
        </div>
    }
}
