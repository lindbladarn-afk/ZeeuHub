@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Configuration
@using WebApp.Models.Identity
@using Entities.ViewModels;
@using WebApp.Services;
@using Entities.Application
@using WebApp.Services.Application

@inject SignInManager<ApplicationUser> SignInManager
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor _httpContextAccessor
@inject IHtmlLocalizer<SharedResources> sharedLocalizer
@inject IApplicationMenuService ApplicationMenuService
@inject ISidebarRuntimeStatusService SidebarRuntimeStatusService

@{
	var modules = new SideMenuViewModel();
	var dynamicModules = modules.Modules ?? new List<SideMenuModulesViewModel>();
	
	var menuController = ViewContext.RouteData.Values["controller"]?.ToString() ?? null;
	var menuAction = ViewContext.RouteData.Values["action"]?.ToString() ?? null;
	var sessionUser = _httpContextAccessor.HttpContext?.Session.Get<UserSession>("UserObject");
	var hasDataAccess = sessionUser?.HasDataAccess != false;
	var runtimeStatus = await SidebarRuntimeStatusService.GetStatusAsync(sessionUser, Context.RequestAborted);
	var currentSidebarReturnUrl = $"{ViewContext.HttpContext.Request.Path}{ViewContext.HttpContext.Request.QueryString}";
	string RuntimeStatusText(string? statusLabel) => statusLabel switch
	{
		"Queued" => sharedLocalizer["RuntimeStatus_Queued"].Value,
		"Running" => sharedLocalizer["RuntimeStatus_Running"].Value,
		"Completed" => sharedLocalizer["RuntimeStatus_Completed"].Value,
		"Failed" => sharedLocalizer["RuntimeStatus_Failed"].Value,
		"Canceled" or "Cancelled" => sharedLocalizer["RuntimeStatus_Canceled"].Value,
		_ => string.IsNullOrWhiteSpace(statusLabel) ? sharedLocalizer["RuntimeStatus_Unknown"].Value : statusLabel
	};

	var sidebarSnapshotVersionParts = new List<string>
	{
		$"{runtimeStatus.OverallTone}|{runtimeStatus.OverallLabel}|{runtimeStatus.RunningLabel}|{runtimeStatus.LatestLabel}|{runtimeStatus.NotificationCount}"
	};

	foreach (var item in runtimeStatus.NotificationItems.Take(10))
	{
		sidebarSnapshotVersionParts.Add($"{item.AggregateKey}|{item.OccurredAtUtc:O}|{item.Title}|{item.StatusLabel}|{item.StatusTone}");
	}

	if (runtimeStatus.ActionCenterSummaryItem is not null)
	{
		sidebarSnapshotVersionParts.Add(
			$"action-center-summary:{runtimeStatus.ActionCenterSummaryItem.AggregateKey}|{runtimeStatus.ActionCenterSummaryItem.OccurredAtUtc:O}|{runtimeStatus.ActionCenterSummaryItem.Title}|{runtimeStatus.ActionCenterSummaryItem.StatusLabel}|{runtimeStatus.ActionCenterSummaryItem.StatusTone}");
	}

	if (runtimeStatus.LatestItem is not null)
	{
		sidebarSnapshotVersionParts.Add(
			$"latest:{runtimeStatus.LatestItem.AggregateKey}|{runtimeStatus.LatestItem.OccurredAtUtc:O}|{runtimeStatus.LatestItem.Title}|{runtimeStatus.LatestItem.StatusLabel}|{runtimeStatus.LatestItem.StatusTone}");
	}

	var sidebarInitialSnapshotVersion = string.Join(";", sidebarSnapshotVersionParts);

	bool ModuleRequiresDatabase(SideMenuModulesViewModel module)
	{
		var controller = module.MenuSectionController ?? string.Empty;
		if (string.IsNullOrWhiteSpace(controller))
		{
			return false;
		}

		return !string.Equals(controller, "Member", StringComparison.OrdinalIgnoreCase)
			&& !string.Equals(controller, "Integration", StringComparison.OrdinalIgnoreCase)
			&& !string.Equals(controller, "ActionCenter", StringComparison.OrdinalIgnoreCase)
			&& !string.Equals(controller, "NotifyMe", StringComparison.OrdinalIgnoreCase)
			&& !string.Equals(controller, "Support", StringComparison.OrdinalIgnoreCase)
			&& !string.Equals(controller, "Admin", StringComparison.OrdinalIgnoreCase)
			&& !string.Equals(controller, "SuperUser", StringComparison.OrdinalIgnoreCase);
	}

	if (sessionUser?.CompanyId is Guid companyId && companyId != Guid.Empty)
	{
		modules = await ApplicationMenuService.GetMenuAsync(companyId, sessionUser?.UserId, Context.RequestAborted);
		dynamicModules = modules.Modules ?? new List<SideMenuModulesViewModel>();
	}
}

