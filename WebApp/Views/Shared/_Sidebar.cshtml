				<button type="submit"
				        class="btn btn-sm btn-portal menu-runtime-status__mark-all-read-btn"
				        title="@sharedLocalizer["SidebarRuntime_MarkAllReadTooltip"]"
				        aria-label="@sharedLocalizer["SidebarRuntime_MarkAllReadTooltip"]">
					@sharedLocalizer["SidebarRuntime_MarkAllRead"]
