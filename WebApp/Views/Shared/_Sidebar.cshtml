<script>
	// Initiera Bootstrap-tooltips om det inte redan görs globalt
	(function initSidebarRuntimeStatus() {
		if (window.bootstrap) {
			var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
			tooltipTriggerList.map(function (el) {
				return new bootstrap.Tooltip(el);
			});
		}

		var toggles = Array.prototype.slice.call(document.querySelectorAll('[data-sidebar-notifications-toggle]'));
		var panel = document.querySelector('[data-sidebar-notifications-panel]');
		var snapshotUrl = '@Url.Action("SidebarRuntimeStatusSnapshot", "Member")';
		var latestLabelEl = document.querySelector('[data-sidebar-latest-label]');
		var runningLabelEl = document.querySelector('[data-sidebar-running-label]');
		var overallPillEl = document.querySelector('[data-sidebar-overall-pill]');
		var latestItemEl = document.querySelector('[data-sidebar-latest-item]');
		var fullCountEl = document.querySelector('[data-sidebar-count-full]');
		var headerCountEl = document.querySelector('[data-sidebar-count-header]');
		var notificationScrollEl = panel ? panel.querySelector('[data-sidebar-notifications-scroll]') : null;
		var lastVersion = '@sidebarInitialSnapshotVersion';
		var pollInFlight = false;
		var notificationsEmptyText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(sharedLocalizer["SidebarRuntime_NoNotificationsYet"].Value));
		var overallReadyText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(sharedLocalizer["SidebarRuntime_OverallReady"].Value));
		var idleText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(sharedLocalizer["SidebarRuntime_Idle"].Value));
		var noActivityText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(sharedLocalizer["SidebarRuntime_NoActivityYet"].Value));

		var escapeHtml = function (value) {
			return String(value || '')
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;')
				.replace(/'/g, '&#39;');
		};

		var renderNotificationCard = function (item, extraClass) {
			var body =
				'<div class="menu-runtime-status__notification-head">' +
					'<div class="menu-runtime-status__notification-main">' +
						'<i class="' + escapeHtml(item.iconClass || 'fa fa-circle') + ' menu-runtime-status__notification-icon" aria-hidden="true"></i>' +
						'<div class="menu-runtime-status__notification-title">' + escapeHtml(item.title) + '</div>' +
					'</div>' +
					'<span class="menu-runtime-status__notification-badge menu-runtime-status__notification-badge--' + escapeHtml(item.statusTone) + '">' + escapeHtml(item.statusLabel) + '</span>' +
				'</div>' +
				'<div class="menu-runtime-status__notification-subtitle">' + escapeHtml(item.source) + ' · ' + escapeHtml(item.summary) + '</div>';
			var className = 'menu-runtime-status__notification-card' + (extraClass ? ' ' + extraClass : '');

			if (item.linkUrl) {
				return '<a class="' + className + '" href="' + escapeHtml(item.linkUrl) + '">' + body + '</a>';
			}

			return '<div class="' + className + '">' + body + '</div>';
		};

		var renderNotificationItems = function (items, actionCenterSummaryItem) {
			if (!notificationScrollEl) {
				return;
			}

			if ((!items || !items.length) && !actionCenterSummaryItem) {
				notificationScrollEl.innerHTML = '<div class="menu-runtime-status__empty">' + escapeHtml(notificationsEmptyText) + '</div>';
				return;
			}

			var cards = [];
			if (actionCenterSummaryItem) {
				cards.push(renderNotificationCard(actionCenterSummaryItem, 'menu-runtime-status__notification-card--action-center'));
			}

			if (items && items.length) {
				cards = cards.concat(items.map(function (item) {
					return renderNotificationCard(item, '');
				}));
			}

			notificationScrollEl.innerHTML = cards.join('');
		};

		var applySnapshot = function (payload) {
			if (overallPillEl) {
				var isCompactPill = overallPillEl.classList.contains('menu-runtime-status__pill--compact');
				overallPillEl.className = 'menu-runtime-status__pill'
					+ (isCompactPill ? ' menu-runtime-status__pill--compact' : '')
					+ ' menu-runtime-status__pill--' + (payload.overallTone || 'ready');
				overallPillEl.textContent = payload.overallLabel || overallReadyText;
			}

			if (runningLabelEl) {
				runningLabelEl.textContent = payload.runningLabel || idleText;
			}

			if (latestLabelEl) {
				latestLabelEl.textContent = payload.latestLabel || noActivityText;
			}

			var count = Number(payload.notificationCount || 0);
			if (fullCountEl) {
				if (count > 0) {
					fullCountEl.textContent = count;
					fullCountEl.hidden = false;
				} else {
					fullCountEl.hidden = true;
				}
			}

			if (headerCountEl) {
				if (count > 0) {
					headerCountEl.textContent = count;
					headerCountEl.hidden = false;
				} else {
					headerCountEl.hidden = true;
				}
			}

			if (latestItemEl) {
				if (payload.latestItem) {
						latestItemEl.innerHTML =
							'<li class="menu-runtime-status__item">' +
								'<i class="' + escapeHtml(payload.latestItem.iconClass || 'fa fa-circle') + '" aria-hidden="true"></i>' +
								'<div>' +
									'<div class="menu-runtime-status__item-title">' + escapeHtml(payload.latestItem.source) + '</div>' +
								'</div>' +
								'<div class="menu-runtime-status__item-meta">' +
									'<span class="menu-runtime-status__item-dot menu-runtime-status__item-dot--' + escapeHtml(payload.latestItem.statusTone || 'muted') + '"></span>' +
								'</div>' +
							'</li>';
					latestItemEl.hidden = false;
				} else {
					latestItemEl.hidden = true;
					latestItemEl.innerHTML = '';
				}
			}

			renderNotificationItems(payload.notificationItems || [], payload.actionCenterSummaryItem || null);
		};

		var getPollDelay = function () {
			var pillTone = overallPillEl ? (overallPillEl.className.indexOf('menu-runtime-status__pill--info') >= 0 ? 'info' : '') : '';
			return pillTone === 'info' ? 5000 : 25000;
		};

		var schedulePoll = function () {
			window.setTimeout(pollSnapshot, getPollDelay());
		};

		var pollSnapshot = function () {
			if (!snapshotUrl || pollInFlight || document.hidden) {
				schedulePoll();
				return;
			}

			pollInFlight = true;

			window.fetch(snapshotUrl, {
				credentials: 'same-origin',
				cache: 'no-store'
			})
				.then(function (response) {
					if (!response.ok) {
						throw new Error('Sidebar snapshot failed');
					}

					return response.json();
				})
				.then(function (payload) {
					if (!payload || typeof payload.version !== 'string') {
						return;
					}

					if (payload.version !== lastVersion) {
						lastVersion = payload.version;
						applySnapshot(payload);
					}
				})
				.catch(function () {
				})
				.finally(function () {
					pollInFlight = false;
					schedulePoll();
				});
		};

		if (toggles.length && panel) {
			if (panel.parentElement !== document.body) {
				document.body.appendChild(panel);
			}

			var isSidebarMinified = function () {
				return document.body.classList.contains('app-sidebar-minified')
					|| document.body.classList.contains('app-sidebar-minify')
					|| document.documentElement.classList.contains('app-sidebar-minified')
					|| document.documentElement.classList.contains('app-sidebar-minify')
					|| document.querySelector('.app-sidebar-minified')
					|| document.querySelector('.app-sidebar-minify');
			};

			var positionPanel = function (toggle) {
				var rect = toggle.getBoundingClientRect();
				var sidebar = toggle.closest('.menu-runtime-status');
				var sidebarRect = sidebar ? sidebar.getBoundingClientRect() : rect;
				var panelWidth = panel.offsetWidth || 320;
				var panelHeight = Math.min(panel.scrollHeight || 420, 420);
				var viewportPadding = 16;
				var horizontalGap = 18;
				var left;
				var top;

				if (isSidebarMinified()) {
					// In minified mode the trigger sits at the bottom-left corner.
					// Keep the panel visually attached by opening it above the trigger,
					// not by clamping it toward the top-left of the viewport.
					left = rect.right + 12;
					top = rect.bottom - panelHeight;
				} else {
					left = sidebarRect.right + horizontalGap;
					top = rect.top - 6;
				}

				left = Math.max(viewportPadding, Math.min(left, window.innerWidth - panelWidth - viewportPadding));
				top = Math.max(viewportPadding, Math.min(top, window.innerHeight - panelHeight - viewportPadding));

				panel.style.left = left + 'px';
				panel.style.top = top + 'px';
			};

			var setExpanded = function (expanded) {
				toggles.forEach(function (toggle) {
					toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
				});
			};

			toggles.forEach(function (toggle) {
				toggle.addEventListener('click', function (event) {
					event.stopPropagation();
					var isOpen = !panel.classList.contains('is-open');
					if (isOpen) {
						positionPanel(toggle);
					}
					panel.classList.toggle('is-open', isOpen);
					setExpanded(isOpen);
				});
			});

			panel.addEventListener('click', function (event) {
				event.stopPropagation();
			});

			document.addEventListener('click', function () {
				panel.classList.remove('is-open');
				setExpanded(false);
			});

			document.addEventListener('keydown', function (event) {
				if (event.key === 'Escape') {
					panel.classList.remove('is-open');
					setExpanded(false);
				}
			});
		}

		if (headerCountEl && fullCountEl) {
			if (!fullCountEl.hidden && fullCountEl.textContent) {
				headerCountEl.textContent = fullCountEl.textContent;
				headerCountEl.hidden = false;
			} else {
				headerCountEl.hidden = true;
			}
		}

		schedulePoll();
	})();
</script>
