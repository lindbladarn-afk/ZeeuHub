			{
				@if (ViewContext.HttpContext.User.IsInRole("Administrator"))
				{
					<!-- ADMIN med undermenyer - oförändrad -->
					<div class="menu-item has-sub @((menuController == "Admin" || menuAction == "AdminOverview" || menuAction == "Companies" || menuAction == "ExcelImports" || menuAction == "AiQueries" || menuAction == "EventLogs") ? "active" : "")">
						<a class="menu-link" href="javascript:;">
							<div class="menu-icon"><i class="fas fa-shield-alt"></i></div>
								<div class="menu-text">@sharedLocalizer["Admin"]</div>
							<div class="menu-caret"></div>
						</a>
						<div class="menu-submenu">
							<div class="menu-item @(menuAction == "AdminOverview" ? "active" : "")">
								<a class="menu-link" asp-controller="Admin" asp-action="AdminOverview">
									<div class="menu-icon"><i class="fas fa-info"></i></div>
										<div class="menu-text">@sharedLocalizer["Overview"]</div>
								</a>
							</div>
							<div class="menu-item @(menuAction == "Companies" ? "active" : "")">
								<a class="menu-link" asp-controller="Admin" asp-action="Companies">
									<div class="menu-icon"><i class="fas fa-building"></i></div>
										<div class="menu-text">@sharedLocalizer["Company"]</div>
								</a>
							</div>
							<div class="menu-item @(menuAction == "Users" ? "active" : "")">
								<a class="menu-link" asp-controller="Admin" asp-action="Users">
									<div class="menu-icon"><i class="fas fa-user"></i></div>
										<div class="menu-text">@sharedLocalizer["User"]</div>
								</a>
							</div>
							<div class="menu-item @(menuAction == "ExcelImports" ? "active" : "")">
								<a class="menu-link" asp-controller="Admin" asp-action="ExcelImports">
									<div class="menu-icon"><i class="fas fa-file-excel"></i></div>
										<div class="menu-text">@sharedLocalizer["Admin_ExcelImports"]</div>
								</a>
							</div>
							<div class="menu-item @(menuAction == "EventLogs" ? "active" : "")">
								<a class="menu-link" asp-controller="Admin" asp-action="EventLogs">
									<div class="menu-icon"><i class="fas fa-bug"></i></div>
										<div class="menu-text">@sharedLocalizer["Admin_EventLogs"]</div>
								</a>
							</div>
							<div class="menu-item @(menuAction == "AiQueries" ? "active" : "")">
								<a class="menu-link" asp-controller="Admin" asp-action="AiQueries">
									<div class="menu-icon"><i class="fas fa-robot"></i></div>
										<div class="menu-text">@sharedLocalizer["Admin_AiControlPanel"]</div>
								</a>
							</div>
						</div>
					</div>
				}
				@if (ViewContext.HttpContext.User.IsInRole("SuperUser"))
				{
					<div class="menu-item has-sub @((menuController == "SuperUser") ? "active" : "")">
						<a class="menu-link" href="javascript:;">
							<div class="menu-icon"><i class="fas fa-user-shield"></i></div>
							<div class="menu-text">@sharedLocalizer["Control Panel"]</div>
							<div class="menu-caret"></div>
						</a>
						<div class="menu-submenu">
							<div class="menu-item @(menuAction == "ControlPanel" ? "active" : "")">
								<a class="menu-link" asp-controller="SuperUser" asp-action="ControlPanel">
									<div class="menu-icon"><i class="fas fa-th-large"></i></div>
									<div class="menu-text">@sharedLocalizer["Översikt"]</div>
								</a>
							</div>
							<div class="menu-item @(menuAction == "Users" ? "active" : "")">
								<a class="menu-link" asp-controller="SuperUser" asp-action="Users">
									<div class="menu-icon"><i class="fas fa-user-friends"></i></div>
									<div class="menu-text">@sharedLocalizer["Användare"]</div>
								</a>
							</div>
						</div>
					</div>
				}

				@* DYNAMISKA MODULER – samma som tidigare *@
				@foreach (var module in dynamicModules.Where(x => x != null))
				{
					var moduleText = module.MenuSectionText ?? string.Empty;
					var localizedText = string.IsNullOrWhiteSpace(moduleText)
						? string.Empty
						: sharedLocalizer[moduleText].Value ?? moduleText;
					var moduleIcon = string.Equals(module.MenuSectionController, "NotifyMe", StringComparison.OrdinalIgnoreCase)
						? "fas fa-broadcast-tower"
						: module.MenuSectionIcon;
					// Menyval styrs nu endast via SQL/permissions.

						var effectiveSubModules = module.SubModules?
							.Where(sm => sm.MenuItemEnabled == true && sm.UserHasPermission)
							.ToList() ?? new List<SideMenuSubModuleViewModel>();
						var hasConfiguredSubModules = module.SubModules?.Any(sm => sm.MenuItemEnabled == true) ?? false;
						var hasEffectiveAccess = hasConfiguredSubModules
							? effectiveSubModules.Count > 0
							: module.CompanyHasPermission;
						var isIntegrationModule = string.Equals(module.MenuSectionController, "Integration", StringComparison.OrdinalIgnoreCase)
							&& string.Equals(module.MenuSectionText, "Module_Integration", StringComparison.OrdinalIgnoreCase);
						var isLockedForMissingData = !hasDataAccess && ModuleRequiresDatabase(module);
						var directSubModule = effectiveSubModules
							.OrderBy(sm => sm.MenuItemSortOrder ?? int.MaxValue)
							.FirstOrDefault();
						var directController = module.MenuSectionController;
						var directAction = module.MenuSectionAction;
						var integrationFlowEngineActions = new[]
						{
							"FlowEngine",
							"FlowEngineCentra",
							"FlowEngineAkeneo",
							"FlowEngineJeeves",
							"FlowEngineShopify"
						};
							var integrationFlowEngineSubModules = isIntegrationModule
								? effectiveSubModules
									.Where(sm => integrationFlowEngineActions.Contains(sm.MenuItemAction ?? string.Empty, StringComparer.OrdinalIgnoreCase))
									.OrderBy(sm => Array.IndexOf(integrationFlowEngineActions, integrationFlowEngineActions.First(x => string.Equals(x, sm.MenuItemAction, StringComparison.OrdinalIgnoreCase))))
									.ToList()
								: new List<SideMenuSubModuleViewModel>();
							var integrationOtherSubModules = isIntegrationModule
								? effectiveSubModules
									.Where(sm => !integrationFlowEngineActions.Contains(sm.MenuItemAction ?? string.Empty, StringComparer.OrdinalIgnoreCase))
									.OrderBy(sm => sm.MenuItemSortOrder ?? int.MaxValue)
									.ToList()
								: new List<SideMenuSubModuleViewModel>();
						var hasIntegrationMenuItems = integrationFlowEngineSubModules.Count > 0;

					if (!isIntegrationModule && effectiveSubModules.Count == 1)
					{
						var single = effectiveSubModules[0];
						if (string.Equals(single.MenuItemController, module.MenuSectionController, StringComparison.OrdinalIgnoreCase)
							&& string.Equals(single.MenuItemAction, module.MenuSectionAction, StringComparison.OrdinalIgnoreCase))
							{
								effectiveSubModules = new List<SideMenuSubModuleViewModel>();
							}
					}

					if (isLockedForMissingData)
					{
						<div class="menu-item">
							<a class="menu-link-no-access"
							   data-bs-toggle="tooltip"
							   data-bs-placement="right"
								   title="@sharedLocalizer["MissingDataSourceTooltip"]">
								<div class="menu-icon menu-icon--locked">
									<i class="@moduleIcon"></i>
									<span class="menu-icon-lock"><i class="fa fa-lock"></i></span>
								</div>
								<div class="menu-text">@localizedText</div>
							</a>
						</div>
					}
						else if (!hasEffectiveAccess)
						{
							<div class="menu-item">
								<a class="menu-link-no-access">
									<div class="menu-icon menu-icon--locked">
										<i class="@moduleIcon"></i>
										<span class="menu-icon-lock"><i class="fa fa-lock"></i></span>
									</div>
									<div class="menu-text">@localizedText</div>
								</a>
							</div>
					}
					else
					{
						var subMenuActive = "";
						var moduleRouteActive =
							string.Equals(menuController, module.MenuSectionController, StringComparison.OrdinalIgnoreCase)
							&& string.Equals(menuAction, module.MenuSectionAction, StringComparison.OrdinalIgnoreCase);
						if (effectiveSubModules.Count > 0)
						{
							foreach (var subMenu in effectiveSubModules)
							{
								var subMenuText = subMenu.MenuItemText ?? string.Empty;
								var localizedSub = string.IsNullOrWhiteSpace(subMenuText)
									? string.Empty
									: sharedLocalizer[subMenuText].Value ?? subMenuText;
								// Menyval styrs nu endast via SQL/permissions.
								subMenuActive = (menuAction == subMenu.MenuItemAction) ? "active" : subMenuActive;
							}
						}

							if (isIntegrationModule && (hasIntegrationMenuItems || integrationOtherSubModules.Count > 0))
							{
								var integrationActive = string.Equals(menuController, "Integration", StringComparison.OrdinalIgnoreCase)
									&& (integrationFlowEngineSubModules.Any(sm => string.Equals(menuAction, sm.MenuItemAction, StringComparison.OrdinalIgnoreCase))
									    || integrationOtherSubModules.Any(sm => string.Equals(menuAction, sm.MenuItemAction, StringComparison.OrdinalIgnoreCase)));
								var flowEngineActive = string.Equals(menuController, "Integration", StringComparison.OrdinalIgnoreCase)
									&& integrationFlowEngineSubModules.Any(sm => string.Equals(menuAction, sm.MenuItemAction, StringComparison.OrdinalIgnoreCase));
								<div class="menu-item has-sub @(integrationActive ? "active" : "")">
									<a class="menu-link" href="javascript:;">
										<div class="menu-icon"><i class="@moduleIcon"></i></div>
										<div class="menu-text">@localizedText</div>
										<div class="menu-caret"></div>
									</a>
									<div class="menu-submenu">
										@if (integrationOtherSubModules.Count > 0)
										{
											@foreach (var subModule in integrationOtherSubModules)
											{
												var subModuleText = subModule.MenuItemText ?? string.Empty;
												var localizedSubModuleText = string.IsNullOrWhiteSpace(subModuleText)
													? string.Empty
													: sharedLocalizer[subModuleText].Value ?? subModuleText;
												<div class="menu-item @(string.Equals(menuAction, subModule.MenuItemAction, StringComparison.OrdinalIgnoreCase) ? "active" : "")">
													<a class="menu-link" asp-controller="@subModule.MenuItemController" asp-action="@subModule.MenuItemAction">
														<div class="menu-text">@localizedSubModuleText</div>
													</a>
												</div>
											}
										}
										@if (integrationFlowEngineSubModules.Count > 0)
										{
											<div class="menu-item has-sub @(flowEngineActive ? "active" : "")">
											<a class="menu-link" href="javascript:;">
												<div class="menu-text">@sharedLocalizer["SubModule_FlowEngine"]</div>
												<div class="menu-caret"></div>
											</a>
											<div class="menu-submenu">
												@foreach (var subModule in integrationFlowEngineSubModules)
												{
													var subModuleText = subModule.MenuItemText ?? string.Empty;
													var localizedSubModuleText = string.Equals(subModule.MenuItemAction, "FlowEngine", StringComparison.OrdinalIgnoreCase)
														? sharedLocalizer["SubModule_FlowEngine_Dashboard"].Value
														: string.IsNullOrWhiteSpace(subModuleText)
															? string.Empty
															: sharedLocalizer[subModuleText].Value ?? subModuleText;
													<div class="menu-item @(string.Equals(menuAction, subModule.MenuItemAction, StringComparison.OrdinalIgnoreCase) ? "active" : "")">
														<a class="menu-link" asp-controller="@subModule.MenuItemController" asp-action="@subModule.MenuItemAction">
															<div class="menu-text">@localizedSubModuleText</div>
														</a>
													</div>
												}
											</div>
										</div>
									}
								</div>
							</div>
						}
						else if (!isIntegrationModule && effectiveSubModules.Count > 0)
						{
							<div class="menu-item has-sub @((moduleRouteActive || subMenuActive == "active") ? "active" : "")">
								<a class="menu-link" href="javascript:;">
									<div class="menu-icon"><i class="@moduleIcon"></i></div>
									<div class="menu-text">@localizedText</div>
									<div class="menu-caret"></div>
								</a>
								<div class="menu-submenu">
									@foreach (var subModule in effectiveSubModules)
									{
										var subModuleText = subModule.MenuItemText ?? string.Empty;
										var localizedSubModuleText = string.IsNullOrWhiteSpace(subModuleText)
											? string.Empty
											: sharedLocalizer[subModuleText].Value ?? subModuleText;
										<div class="menu-item @((menuAction == subModule.MenuItemAction || subMenuActive == subModule.MenuItemAction) ? "active" : "")">
											<a class="menu-link" asp-controller="@subModule.MenuItemController" asp-action="@subModule.MenuItemAction">
												<div class="menu-text">@localizedSubModuleText</div>
											</a>
										</div>
									}
								</div>
							</div>
						}
						else
						{
								if (hasEffectiveAccess || !hasConfiguredSubModules)
								{
									<div class="menu-item @(moduleRouteActive ? "active" : "")">
										<a class="menu-link" asp-controller="@directController" asp-action="@directAction">
											<div class="menu-icon"><i class="@moduleIcon"></i></div>
											<div class="menu-text">@localizedText</div>
										</a>
								</div>
							}
							else
							{
								<div class="menu-item">
									<a class="menu-link-no-access">
										<div class="menu-icon menu-icon--locked">
											<i class="@moduleIcon"></i>
											<span class="menu-icon-lock"><i class="fa fa-lock"></i></span>
										</div>
										<div class="menu-text">@localizedText</div>
									</a>
								</div>
							}
						}
					}
				}

			<!-- BEGIN minify-button -->
			<div class="menu-item d-flex">
				<a href="javascript:;" class="app-sidebar-minify-btn ms-auto" data-toggle="app-sidebar-minify">
					<i class="fa fa-angle-double-left"></i>
				</a>
			</div>
			<!-- END minify-button -->
				@if (runtimeStatus.IsVisible)
				{
					<div class="menu-runtime-status">
						<div class="menu-runtime-status__header">
							<div class="menu-runtime-status__header-main">
								<div class="menu-runtime-status__title">@sharedLocalizer["Status"]</div>
								<span class="menu-runtime-status__pill menu-runtime-status__pill--compact menu-runtime-status__pill--@runtimeStatus.OverallTone" data-sidebar-overall-pill>@runtimeStatus.OverallLabel</span>
							</div>
							<button type="button" class="menu-runtime-status__bell" data-sidebar-notifications-toggle aria-expanded="false" aria-haspopup="dialog">
								<i class="fa fa-bell-o"></i>
								@if (runtimeStatus.NotificationCount > 0)
								{
									<span class="menu-runtime-status__count" data-sidebar-count-full>@runtimeStatus.NotificationCount</span>
								}
								else
								{
									<span class="menu-runtime-status__count" data-sidebar-count-full hidden></span>
								}
							</button>
						</div>
						<div class="menu-runtime-status__meta">@sharedLocalizer["SidebarRuntime_RunningNow"]: <span data-sidebar-running-label>@runtimeStatus.RunningLabel</span></div>
						<div class="menu-runtime-status__meta">@sharedLocalizer["SidebarRuntime_Latest"]: <span data-sidebar-latest-label>@runtimeStatus.LatestLabel</span></div>
						@if (runtimeStatus.LatestItem is { } latestItem)
						{
							<ul class="menu-runtime-status__list" data-sidebar-latest-item>
								<li class="menu-runtime-status__item">
									<i class="@latestItem.IconClass" aria-hidden="true"></i>
									<div>
										<div class="menu-runtime-status__item-title">@latestItem.Source</div>
									</div>
									<div class="menu-runtime-status__item-meta">
										<span class="menu-runtime-status__item-dot menu-runtime-status__item-dot--@latestItem.StatusTone"></span>
									</div>
								</li>
							</ul>
						}
						else
						{
							<ul class="menu-runtime-status__list" data-sidebar-latest-item hidden></ul>
						}

						</div>
					}
				}
		</div>
		<!-- END menu -->
	</div>
	<!-- END scrollbar -->
</div>
<div class="app-sidebar-bg"></div>
<div class="app-sidebar-mobile-backdrop">
	<a href="#" data-dismiss="app-sidebar-mobile" class="stretched-link"></a>
</div>

@if (runtimeStatus.IsVisible)
{
	<div class="menu-runtime-status__notifications" data-sidebar-notifications-panel>
		<div class="menu-runtime-status__notifications-header">
