					<div class="menu-runtime-status__notification-head">
						<div class="menu-runtime-status__notification-main">
							<i class="@actionCenterSummaryItem.IconClass menu-runtime-status__notification-icon" aria-hidden="true"></i>
							<div class="menu-runtime-status__notification-title">@actionCenterSummaryItem.Title</div>
						</div>
						<span class="menu-runtime-status__notification-badge menu-runtime-status__notification-badge--@actionCenterSummaryItem.StatusTone">@RuntimeStatusText(actionCenterSummaryItem.StatusLabel)</span>
					</div>
					<div class="menu-runtime-status__notification-subtitle">@actionCenterSummaryItem.Source · @actionCenterSummaryItem.Summary</div>
				</a>
