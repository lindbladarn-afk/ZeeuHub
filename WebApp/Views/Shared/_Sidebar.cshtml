				<div class="menu-runtime-status__empty">@sharedLocalizer["SidebarRuntime_NoNotificationsYet"]</div>
			}
			@if (runtimeStatus.NotificationItems.Count > 0)
			{
				@foreach (var item in runtimeStatus.NotificationItems)
				{
					@if (string.IsNullOrWhiteSpace(item.LinkUrl))
					{
						<div class="menu-runtime-status__notification-card">
							<div class="menu-runtime-status__notification-head">
								<div class="menu-runtime-status__notification-main">
									<i class="@item.IconClass menu-runtime-status__notification-icon" aria-hidden="true"></i>
									<div class="menu-runtime-status__notification-title">@item.Title</div>
								</div>
								<span class="menu-runtime-status__notification-badge menu-runtime-status__notification-badge--@item.StatusTone">@RuntimeStatusText(item.StatusLabel)</span>
							</div>
							<div class="menu-runtime-status__notification-subtitle">@item.Source · @item.Summary</div>
						</div>
					}
					else
					{
						<a class="menu-runtime-status__notification-card" href="@item.LinkUrl">
							<div class="menu-runtime-status__notification-head">
								<div class="menu-runtime-status__notification-main">
									<i class="@item.IconClass menu-runtime-status__notification-icon" aria-hidden="true"></i>
									<div class="menu-runtime-status__notification-title">@item.Title</div>
								</div>
								<span class="menu-runtime-status__notification-badge menu-runtime-status__notification-badge--@item.StatusTone">@RuntimeStatusText(item.StatusLabel)</span>
							</div>
							<div class="menu-runtime-status__notification-subtitle">@item.Source · @item.Summary</div>
						</a>
					}
				}
			}
		</div>
