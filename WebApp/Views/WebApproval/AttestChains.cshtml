@model WebApp.ViewModels.Admin.ApprovalChains.ApprovalChainDesignerViewModel
@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    // Approval chain designer keeps the portal's Web Approval shell, but presents the chain as a working simulation rather than a static mockup.
    ViewData["Title"] = Model.PageTitle;
    var culture = CultureInfo.GetCultureInfo("sv-SE");
    var selectedOrderType = Model.OrderTypes.FirstOrDefault(x => string.Equals(x.Key, Model.SelectedOrderTypeKey, StringComparison.OrdinalIgnoreCase))
        ?? Model.OrderTypes.FirstOrDefault()
        ?? new WebApp.ViewModels.Admin.ApprovalChains.ApprovalChainOrderTypeViewModel();
    var selectedStepCount = selectedOrderType.Steps.Count;
    var selectedQuickAmountCount = selectedOrderType.QuickAmounts.Count;
    var selectedUnlimitedSteps = selectedOrderType.Steps.Count(x => x.Limit is null);
    var jsonOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web);
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <style>
        .approval-chain-page {
            --hub-page-surface: #1f2937;
            --hub-page-surface-solid: #1f2937;
            --hub-page-surface-muted: rgba(15, 23, 42, 0.42);
            --hub-page-surface-hover: rgba(15, 23, 42, 0.62);
            --hub-page-border: rgba(148, 163, 184, 0.16);
            --hub-page-border-strong: rgba(255, 255, 255, 0.1);
            --hub-page-card-shadow: none;
            --approval-chain-muted-text: rgba(248, 250, 252, 0.78);
            --approval-chain-subtle-text: rgba(248, 250, 252, 0.68);
        }

        .approval-chain-page .approval-hero {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            align-items: start;
            justify-content: space-between;
        }

        .approval-chain-page .approval-mode-switch {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .approval-chain-page .approval-mode-tab {
            min-height: 2.55rem;
            padding: 0.45rem 0.95rem;
            border-radius: 0.9rem;
            border: 1px solid var(--hub-toggle-border);
            background: var(--hub-toggle-bg);
            color: var(--hub-toggle-text);
            font-weight: 700;
            box-shadow: var(--hub-toggle-shadow);
        }

        .approval-chain-page .approval-mode-tab.is-active {
            border-color: var(--hub-toggle-active-border);
            background: var(--hub-toggle-active-bg);
            color: var(--hub-toggle-active-text);
            box-shadow: var(--hub-toggle-active-shadow);
        }

        .approval-chain-page .approval-mode-tab__meta {
            display: block;
            font-size: 0.72rem;
            font-weight: 600;
            opacity: 0.72;
            line-height: 1.1;
        }

        .approval-chain-page .approval-kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 0.75rem;
        }

        .approval-chain-page .approval-kpi-card {
            padding: 0.9rem 0.95rem;
            border: 1px solid var(--hub-page-border-strong);
            border-radius: 14px;
            background: var(--hub-page-surface);
            box-shadow: var(--hub-page-card-shadow);
        }

        .approval-chain-page .approval-kpi-label {
            color: var(--approval-chain-subtle-text);
            font-size: 0.76rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .approval-chain-page .approval-kpi-value {
            margin-top: 0.22rem;
            color: var(--hub-page-heading);
            font-size: 1.08rem;
            font-weight: 800;
        }

        .approval-chain-page .approval-kpi-subtitle {
            color: var(--approval-chain-muted-text);
            font-size: 0.84rem;
            margin-top: 0.1rem;
        }

        .approval-chain-page .approval-mode-panel {
            margin-bottom: 1rem;
        }

        .approval-chain-page .approval-mode-panel.is-hidden {
            display: none;
        }

        .approval-chain-page .approval-panel--compact {
            padding: 1rem 1rem 0.95rem;
        }

        .approval-chain-page .approval-overview-list {
            display: flex;
            flex-direction: column;
            gap: 0.7rem;
        }

        .approval-chain-page .approval-overview-item {
            display: flex;
            align-items: start;
            justify-content: space-between;
            gap: 1rem;
            padding: 0.85rem 0.9rem;
            border: 1px solid var(--hub-page-border);
            border-radius: 14px;
            background: var(--hub-page-surface-muted);
        }

        .approval-chain-page .approval-overview-item__title {
            color: #f8fafc;
            font-weight: 700;
            line-height: 1.25;
        }

        .approval-chain-page .approval-overview-item__meta {
            color: var(--approval-chain-muted-text);
            font-size: 0.83rem;
            line-height: 1.5;
            margin-top: 0.18rem;
        }

        .approval-chain-page .approval-overview-item__badge {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.28rem 0.6rem;
            border-radius: 999px;
            background: rgba(76, 111, 151, 0.18);
            color: #dbeafe;
            font-size: 0.78rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .approval-chain-page .approval-validation-list,
        .approval-chain-page .approval-diff-list,
        .approval-chain-page .approval-history-list {
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
        }

        .approval-chain-page .approval-validation-item,
        .approval-chain-page .approval-diff-item,
        .approval-chain-page .approval-history-item {
            padding: 0.78rem 0.85rem;
            border: 1px solid var(--hub-page-border);
            border-radius: 14px;
            background: var(--hub-page-surface-muted);
        }

        .approval-chain-page .approval-validation-item--error {
            border-color: rgba(248, 113, 113, 0.22);
            background: rgba(248, 113, 113, 0.08);
        }

        .approval-chain-page .approval-validation-item--warn {
            border-color: rgba(251, 191, 36, 0.22);
            background: rgba(251, 191, 36, 0.08);
        }

        .approval-chain-page .approval-validation-item__title,
        .approval-chain-page .approval-diff-item__title,
        .approval-chain-page .approval-history-item__title {
            color: #f8fafc;
            font-weight: 700;
        }

        .approval-chain-page .approval-validation-item__meta,
        .approval-chain-page .approval-diff-item__meta,
        .approval-chain-page .approval-history-item__meta {
            color: var(--approval-chain-muted-text);
            font-size: 0.83rem;
            line-height: 1.5;
            margin-top: 0.15rem;
        }

        .approval-chain-page .approval-diff-item--added {
            border-color: rgba(34, 197, 94, 0.22);
            background: rgba(34, 197, 94, 0.08);
        }

        .approval-chain-page .approval-diff-item--changed {
            border-color: rgba(76, 111, 151, 0.22);
            background: rgba(76, 111, 151, 0.08);
        }

        .approval-chain-page .approval-diff-item--removed {
            border-color: rgba(248, 113, 113, 0.22);
            background: rgba(248, 113, 113, 0.08);
        }

        .approval-chain-page .approval-panel {
            border: 1px solid var(--hub-page-border-strong);
            border-radius: 16px;
            background: var(--hub-page-surface);
            box-shadow: var(--hub-page-card-shadow);
        }

        .approval-chain-page .approval-panel--soft {
            background: var(--hub-page-surface-muted);
        }

        .approval-chain-page .approval-panel__header {
            display: flex;
            align-items: start;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .approval-chain-page .approval-panel__title {
            margin: 0;
            color: #f8fafc;
            font-size: 1rem;
            font-weight: 700;
        }

        .approval-chain-page .approval-panel__meta {
            color: var(--approval-chain-muted-text);
            font-size: 0.84rem;
        }

        .approval-chain-page .approval-type-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 0.55rem;
        }

        .approval-chain-page .approval-type-chip {
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            min-height: 2.6rem;
            padding: 0.48rem 0.88rem;
            border: 1px solid var(--hub-toggle-border);
            border-radius: 12px;
            background: var(--hub-toggle-bg);
            color: var(--hub-toggle-text);
            font-weight: 600;
            box-shadow: var(--hub-toggle-shadow);
            transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
        }

        .approval-chain-page .approval-type-chip:hover {
            border-color: var(--hub-toggle-hover-border);
            background: var(--hub-toggle-hover-bg);
            color: var(--hub-toggle-hover-text);
        }

        .approval-chain-page .approval-type-chip.is-active {
            color: var(--hub-toggle-active-text);
            border-color: var(--hub-toggle-active-border);
            background: var(--hub-toggle-active-bg);
            box-shadow: var(--hub-toggle-active-shadow);
        }

        .approval-chain-page .approval-chip-icon {
            font-size: 0.9rem;
        }

        .approval-chain-page .approval-input,
        .approval-chain-page .approval-select {
            min-height: 2.6rem;
            border-radius: 12px;
            border-color: rgba(148, 163, 184, 0.2);
            background: linear-gradient(180deg, rgba(37, 46, 63, 0.98), rgba(26, 35, 50, 0.98));
            color: #e5e7eb;
        }

        .approval-chain-page .approval-input:focus,
        .approval-chain-page .approval-select:focus {
            border-color: rgba(56, 189, 248, 0.48);
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.12);
            background: linear-gradient(180deg, rgba(43, 53, 71, 0.99), rgba(30, 40, 56, 0.99));
        }

        .approval-chain-page .approval-inline-input {
            max-width: 8.5rem;
        }

        .approval-chain-page .approval-step-list {
            display: flex;
            flex-direction: column;
            gap: 0.65rem;
        }

        .approval-chain-page .approval-step-row {
            display: grid;
            grid-template-columns: 2.4rem minmax(0, 1fr) minmax(9.5rem, 14rem) auto;
            gap: 0.7rem;
            align-items: start;
            padding: 0.72rem 0.78rem;
            border: 1px solid var(--hub-page-border);
            border-radius: 14px;
            background: var(--hub-page-surface-muted);
        }

        .approval-chain-page .approval-step-index {
            width: 2.25rem;
            height: 2.25rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            border: 1px solid currentColor;
            font-weight: 700;
        }

        .approval-chain-page .approval-step-copy {
            min-width: 0;
            display: grid;
            grid-column: 2;
            grid-template-columns: minmax(0, 1fr);
            gap: 0.42rem;
        }

        .approval-chain-page .approval-step-name {
            color: #f8fafc;
            font-weight: 700;
            line-height: 1.2;
        }

        .approval-chain-page .approval-step-subtitle {
            color: var(--approval-chain-muted-text);
            font-size: 0.83rem;
            margin-top: 0.18rem;
        }

        .approval-chain-page .approval-step-row .form-label {
            margin-bottom: 0.25rem;
            font-size: 0.77rem;
            color: var(--approval-chain-subtle-text);
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        .approval-chain-page .approval-step-control {
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            min-width: 0;
            padding-top: 0.05rem;
        }

        .approval-chain-page .approval-step-control .approval-select,
        .approval-chain-page .approval-step-control .approval-input {
            min-height: 3.45rem;
        }

        .approval-chain-page .approval-step-limit {
            grid-column: 3;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            min-width: 0;
            padding-top: 0.05rem;
        }

        .approval-chain-page .approval-step-actions {
            grid-column: 4;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            align-self: start;
            gap: 0.45rem;
            padding-top: 1.55rem;
        }

        .approval-chain-page .approval-step-confirm {
            min-height: 2.35rem;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.35rem 0.7rem;
            border-radius: 999px;
            border: 1px solid rgba(56, 189, 248, 0.24);
            background: rgba(56, 189, 248, 0.08);
            color: #7dd3fc;
            font-size: 0.84rem;
            font-weight: 700;
            line-height: 1;
            transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
        }

        .approval-chain-page .approval-step-confirm:hover {
            background: rgba(56, 189, 248, 0.16);
            border-color: rgba(56, 189, 248, 0.34);
            color: #bae6fd;
            transform: translateY(-1px);
        }

        .approval-chain-page .approval-step-confirm:focus-visible {
            outline: 2px solid rgba(56, 189, 248, 0.28);
            outline-offset: 2px;
        }

        .approval-chain-page .approval-step-confirm i {
            font-size: 0.84rem;
        }

        .approval-chain-page .approval-icon-button {
            width: 2.35rem;
            height: 2.35rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            border: 1px solid rgba(248, 113, 113, 0.24);
            background: rgba(248, 113, 113, 0.08);
            color: #fca5a5;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
            transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
        }

        .approval-chain-page .approval-icon-button:hover {
            background: rgba(248, 113, 113, 0.16);
            border-color: rgba(248, 113, 113, 0.36);
            color: #fecaca;
            transform: translateY(-1px);
        }

        .approval-chain-page .approval-icon-button:focus-visible {
            outline: 2px solid rgba(248, 113, 113, 0.28);
            outline-offset: 2px;
        }

        .approval-chain-page .approval-icon-button i {
            font-size: 0.88rem;
        }

        .approval-chain-page .approval-outline-button {
            border-radius: 12px;
        }

        .approval-chain-page .approval-preview-table {
            width: 100%;
            border-collapse: collapse;
        }

        .approval-chain-page .approval-preview-table th,
        .approval-chain-page .approval-preview-table td {
            padding: 0.72rem 0.4rem;
            border-bottom: 1px solid rgba(148, 163, 184, 0.14);
        }

        .approval-chain-page .approval-preview-table th {
            color: var(--approval-chain-subtle-text);
            font-size: 0.76rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .approval-chain-page .approval-preview-row.is-active {
            background: rgba(76, 111, 151, 0.1);
        }

        .approval-chain-page .approval-preview-row {
            scroll-margin-top: 6rem;
            transition: background-color 0.18s ease, box-shadow 0.18s ease;
        }

        .approval-chain-page .approval-preview-range {
            color: #e2e8f0;
            font-weight: 600;
        }

        .approval-chain-page .approval-preview-badge {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: 0.28rem 0.62rem;
            margin: 0.12rem 0.18rem 0.12rem 0;
            font-size: 0.77rem;
            font-weight: 700;
            background: rgba(255, 255, 255, 0.06);
            color: #e2e8f0;
        }

        .approval-chain-page .approval-preview-badge--active {
            background: rgba(76, 111, 151, 0.22);
            color: #dbeafe;
        }

        .approval-chain-page .approval-preview-badge--teal { background: rgba(76, 111, 151, 0.16); color: #cfe2ff; }
        .approval-chain-page .approval-preview-badge--indigo { background: rgba(94, 108, 132, 0.18); color: #d6deeb; }
        .approval-chain-page .approval-preview-badge--amber { background: rgba(170, 127, 58, 0.18); color: #fde7c4; }
        .approval-chain-page .approval-preview-badge--rose { background: rgba(124, 92, 120, 0.18); color: #f4d7ec; }

        .approval-chain-page .approval-role--teal { color: #7fb8ff; }
        .approval-chain-page .approval-role--indigo { color: #a5b4fc; }
        .approval-chain-page .approval-role--amber { color: #f1b965; }
        .approval-chain-page .approval-role--rose { color: #d8a3ca; }

        .approval-chain-page .approval-summary-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.7rem;
        }

        .approval-chain-page .approval-summary-card {
            padding: 0.8rem 0.85rem;
            border: 1px solid var(--hub-page-border);
            border-radius: 14px;
            background: var(--hub-page-surface-muted);
        }

        .approval-chain-page .approval-summary-label {
            color: var(--approval-chain-subtle-text);
            font-size: 0.76rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .approval-chain-page .approval-summary-value {
            margin-top: 0.15rem;
            color: #f8fafc;
            font-size: 1.12rem;
            font-weight: 800;
        }

        .approval-chain-page .approval-summary-subtle {
            color: var(--approval-chain-muted-text);
            font-size: 0.82rem;
        }

        .approval-chain-page .approval-preview-flow {
            display: flex;
            flex-direction: column;
            gap: 0.65rem;
        }

        .approval-chain-page .approval-preview-flow__item {
            padding: 0.82rem 0.88rem;
            border: 1px solid var(--hub-page-border);
            border-radius: 14px;
            background: var(--hub-page-surface-muted);
        }

        .approval-chain-page .approval-preview-flow__title {
            color: #f8fafc;
            font-weight: 700;
        }

        .approval-chain-page .approval-preview-flow__meta {
            color: var(--approval-chain-muted-text);
            font-size: 0.83rem;
        }

        body:not(.theme-dark) .approval-chain-page .approval-panel,
        body:not(.theme-dark) .approval-chain-page .approval-panel--soft {
            background: #ffffff;
            border-color: rgba(15, 23, 42, 0.12);
            box-shadow: 0 10px 22px rgba(15, 23, 42, 0.08);
        }

        body:not(.theme-dark) .approval-chain-page .approval-panel__title,
        body:not(.theme-dark) .approval-chain-page .approval-step-name,
        body:not(.theme-dark) .approval-chain-page .approval-summary-value,
        body:not(.theme-dark) .approval-chain-page .approval-preview-flow__title,
        body:not(.theme-dark) .approval-chain-page .approval-preview-range {
            color: #0f172a;
        }

        body:not(.theme-dark) .approval-chain-page .approval-panel__meta,
        body:not(.theme-dark) .approval-chain-page .approval-step-subtitle,
        body:not(.theme-dark) .approval-chain-page .approval-summary-subtle,
        body:not(.theme-dark) .approval-chain-page .approval-preview-flow__meta,
        body:not(.theme-dark) .approval-chain-page .approval-summary-label,
        body:not(.theme-dark) .approval-chain-page .approval-step-row .form-label,
        body:not(.theme-dark) .approval-chain-page .approval-preview-table th {
            color: #475569;
        }

        body:not(.theme-dark) .approval-chain-page .approval-step-row,
        body:not(.theme-dark) .approval-chain-page .approval-summary-card,
        body:not(.theme-dark) .approval-chain-page .approval-preview-flow__item {
            background: rgba(15, 23, 42, 0.02);
            border-color: rgba(148, 163, 184, 0.22);
        }

        body:not(.theme-dark) .approval-chain-page .approval-input,
        body:not(.theme-dark) .approval-chain-page .approval-select {
            background: #ffffff;
            color: #0f172a;
            border-color: rgba(148, 163, 184, 0.28);
        }

        body:not(.theme-dark) .approval-chain-page .approval-type-chip {
            color: #0f172a;
            background: linear-gradient(180deg, #ffffff 0%, #eef2f7 100%);
            border-color: rgba(15, 23, 42, 0.16);
        }

        body:not(.theme-dark) .approval-chain-page .approval-type-chip.is-active {
            color: #ffffff;
            background: linear-gradient(180deg, #4c6f97 0%, #3f618a 100%);
            border-color: rgba(63, 97, 138, 0.55);
            box-shadow: 0 8px 18px rgba(63, 97, 138, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.18);
        }

        body:not(.theme-dark) .approval-chain-page .approval-mode-tab {
            background: linear-gradient(180deg, #ffffff 0%, #eef2f7 100%);
            border-color: rgba(15, 23, 42, 0.16);
            color: #0f172a;
        }

        body:not(.theme-dark) .approval-chain-page .approval-mode-tab.is-active {
            background: linear-gradient(180deg, #4c6f97 0%, #3f618a 100%);
            border-color: rgba(63, 97, 138, 0.55);
            color: #ffffff;
        }

        body:not(.theme-dark) .approval-chain-page .approval-kpi-card,
        body:not(.theme-dark) .approval-chain-page .approval-overview-item,
        body:not(.theme-dark) .approval-chain-page .approval-validation-item,
        body:not(.theme-dark) .approval-chain-page .approval-diff-item,
        body:not(.theme-dark) .approval-chain-page .approval-history-item {
            background: rgba(15, 23, 42, 0.02);
            border-color: rgba(148, 163, 184, 0.18);
        }

        body:not(.theme-dark) .approval-chain-page .approval-overview-item__title,
        body:not(.theme-dark) .approval-chain-page .approval-validation-item__title,
        body:not(.theme-dark) .approval-chain-page .approval-diff-item__title,
        body:not(.theme-dark) .approval-chain-page .approval-history-item__title,
        body:not(.theme-dark) .approval-chain-page .approval-kpi-value {
            color: #0f172a;
        }

        body:not(.theme-dark) .approval-chain-page .approval-overview-item__meta,
        body:not(.theme-dark) .approval-chain-page .approval-validation-item__meta,
        body:not(.theme-dark) .approval-chain-page .approval-diff-item__meta,
        body:not(.theme-dark) .approval-chain-page .approval-history-item__meta,
        body:not(.theme-dark) .approval-chain-page .approval-kpi-subtitle {
            color: #475569;
        }

        @@media (max-width: 991.98px) {
            .approval-chain-page .approval-step-row {
                grid-template-columns: 2.4rem minmax(0, 1fr) auto;
            }

            .approval-chain-page .approval-step-copy,
            .approval-chain-page .approval-step-limit {
                grid-column: 2 / -1;
            }

            .approval-chain-page .approval-step-limit {
                margin-top: 0.25rem;
            }

            .approval-chain-page .approval-step-actions {
                justify-content: flex-end;
                padding-top: 0.05rem;
            }

            .approval-chain-page .approval-summary-grid {
                grid-template-columns: 1fr;
            }

            .approval-chain-page .approval-kpi-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 575.98px) {
            .approval-chain-page .approval-kpi-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="dashboard-readable module-page admin-page approval-chain-page">
