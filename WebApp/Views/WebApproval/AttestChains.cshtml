        </div>
        <div class="approval-step-actions">
            __confirmButton__
            <button type="button" class="approval-icon-button js-remove-step" aria-label="Ta bort led">
                <i class="fa fa-times-circle"></i>
            </button>
        </div>
    </div>
</template>

<script>
    (() => {
        const model = @Html.Raw(JsonSerializer.Serialize(Model, jsonOptions));
        const orderTypes = Array.isArray(model.orderTypes) ? model.orderTypes : [];
        const approverOptions = Array.isArray(model.approverOptions) ? model.approverOptions : [];

        const modeButtons = document.querySelectorAll('[data-mode-button]');
        const modePanels = document.querySelectorAll('[data-mode-panel]');
        const orderTypeButtons = document.getElementById('orderTypeButtons');
        const amountInput = document.getElementById('amountInput');
        const quickAmountButtons = document.getElementById('quickAmountButtons');
        const stepList = document.getElementById('approvalStepList');
        const previewRows = document.getElementById('previewRows');
        const summaryType = document.getElementById('summaryType');
        const summaryAmount = document.getElementById('summaryAmount');
        const summaryStep = document.getElementById('summaryStep');
        const summaryNextStep = document.getElementById('summaryNextStep');
        const activeFlowSummary = document.getElementById('activeFlowSummary');
        const selectedTypeTitle = document.getElementById('selectedTypeTitle');
        const selectedTypeDescription = document.getElementById('selectedTypeDescription');
        const addStepBtn = document.getElementById('addStepBtn');
        const demoBtn = document.getElementById('demoBtn');
        const resetDesignerBtn = document.getElementById('resetDesignerBtn');
        const copySummaryBtn = document.getElementById('copySummaryBtn');
        const simulateBtn = document.getElementById('simulateBtn');
        const saveDraftBtn = document.getElementById('saveDraftBtn');
        const publishBtn = document.getElementById('publishBtn');
        const validationList = document.getElementById('validationList');
        const reviewDiffList = document.getElementById('reviewDiffList');
        const designerStatusTextOverview = document.getElementById('designerStatusTextOverview');
        const designerStatusTextEdit = document.getElementById('designerStatusTextEdit');
        const overviewDraftKpi = document.getElementById('overviewDraftKpi');
        const overviewDraftMeta = document.getElementById('overviewDraftMeta');
        const overviewValidationKpi = document.getElementById('overviewValidationKpi');
        const overviewValidationMeta = document.getElementById('overviewValidationMeta');
        const overviewFlowKpi = document.getElementById('overviewFlowKpi');
        const overviewDraftStateText = document.getElementById('overviewDraftStateText');
        const overviewDraftStateBadge = document.getElementById('overviewDraftStateBadge');
        const overviewValidationStateText = document.getElementById('overviewValidationStateText');
        const overviewValidationStateBadge = document.getElementById('overviewValidationStateBadge');
        const overviewNextStepText = document.getElementById('overviewNextStepText');
        const reviewStatusValue = document.getElementById('reviewStatusValue');
        const reviewStatusMeta = document.getElementById('reviewStatusMeta');
        const reviewChangeValue = document.getElementById('reviewChangeValue');
        const reviewValidationValue = document.getElementById('reviewValidationValue');
        const reviewValidationMeta = document.getElementById('reviewValidationMeta');
        const reviewActionValue = document.getElementById('reviewActionValue');
        const overviewScenarioText = document.getElementById('overviewScenarioText');
        const overviewScenarioBadge = document.getElementById('overviewScenarioBadge');
        const template = document.getElementById('approvalStepTemplate');
        const currencyLabel = @Html.Raw(JsonSerializer.Serialize(Model.Currency));

        if (!orderTypeButtons || !amountInput || !stepList || !previewRows || !template) return;

        let currentOrderType = getOrderType(model.selectedOrderTypeKey) || orderTypes[0];
        const basePublishedByType = new Map(orderTypes.map((type) => [String(type.key).toLowerCase(), cloneSteps(type.steps || [])]));
        const baseDraftByType = new Map(orderTypes.map((type) => [String(type.key).toLowerCase(), cloneSteps(type.steps || [])]));
        let publishedByType = cloneStateMap(basePublishedByType);
        let savedDraftByType = cloneStateMap(baseDraftByType);
        let currentAmount = parseAmount(amountInput.value);
        let currentSteps = sortStepsByLimit(savedDraftByType.get(String(currentOrderType?.key || '').toLowerCase()) || currentOrderType?.steps || []);
        let currentMode = 'edit';
        let demoScenarioSeed = null;

        function getOrderType(key) {
            return orderTypes.find((item) => String(item.key).toLowerCase() === String(key).toLowerCase());
        }

        function parseAmount(value) {
            const parsed = Number.parseFloat(String(value).replace(',', '.'));
            return Number.isFinite(parsed) && parsed >= 0 ? parsed : 0;
        }

        function cloneSteps(steps = []) {
            return steps.map((step) => ({ ...step }));
        }

        function sortStepsByLimit(steps = []) {
            return cloneSteps(steps)
                .map((step, index) => ({ ...step, __sortIndex: index }))
                .sort((a, b) => {
                    if (!!a.isDraft !== !!b.isDraft) return a.isDraft ? 1 : -1;
                    const leftLimit = a.limit == null ? Number.POSITIVE_INFINITY : a.limit;
                    const rightLimit = b.limit == null ? Number.POSITIVE_INFINITY : b.limit;
                    if (leftLimit !== rightLimit) return leftLimit - rightLimit;
                    return a.__sortIndex - b.__sortIndex;
                })
                .map(({ __sortIndex, ...step }) => step);
        }

        function cloneStateMap(sourceMap) {
            return new Map(Array.from(sourceMap.entries(), ([key, steps]) => [key, cloneSteps(steps || [])]));
        }

        function stepsEqual(a, b) {
            return JSON.stringify(a || []) === JSON.stringify(b || []);
        }

        function getCommittedSteps(steps = currentSteps) {
            return sortStepsByLimit(steps.filter((step) => !step.isDraft));
        }

        function formatAmount(value) {
            return new Intl.NumberFormat('sv-SE', { maximumFractionDigits: 0 }).format(value);
        }

        function formatInterval(start, end) {
            if (start <= 1 && end == null) return `1 kr – Obegränsat`;
            if (start <= 1) return `1 kr – ${formatAmount(end)} kr`;
            if (end == null) return `${formatAmount(start)} kr – Obegränsat`;
            return `${formatAmount(start)} kr – ${formatAmount(end)} kr`;
        }

        function roleClass(roleKey) {
            switch (String(roleKey).toLowerCase()) {
                case 'chef': return 'approval-role--teal';
                case 'controller': return 'approval-role--indigo';
                case 'cfo': return 'approval-role--amber';
                default: return 'approval-role--rose';
            }
        }

        function currentKey() {
            return String(currentOrderType?.key || '').toLowerCase();
        }

        function buildScenarioSeed() {
            const purchaseKey = 'purchase';
            const serviceKey = 'service';
            const travelKey = 'travel';

            return {
                currentOrderTypeKey: purchaseKey,
                currentAmount: 125000,
                currentMode: 'edit',
                publishedByType: new Map([
                    [purchaseKey, [
                        { sequence: 1, roleKey: 'chef', roleName: 'Chef', approverKey: 'anna-lindstrom', approverName: 'Anna Lindström', reserveApproverName: 'Marcus Ek', limit: 20000, note: 'Initial publicerat led för köp.' },
                        { sequence: 2, roleKey: 'controller', roleName: 'Controller', approverKey: 'marcus-ek', approverName: 'Marcus Ek', reserveApproverName: 'Helena Björk', limit: 90000, note: 'Publicerad nivå för större köp.' },
                        { sequence: 3, roleKey: 'cfo', roleName: 'CFO', approverKey: 'helena-bjork', approverName: 'Helena Björk', reserveApproverName: 'Anna Lindström', limit: null, note: 'Slutnivå i publicerad kedja.' }
                    ]],
                    [serviceKey, [
                        { sequence: 1, roleKey: 'chef', roleName: 'Chef', approverKey: 'sara-holm', approverName: 'Sara Holm', reserveApproverName: 'Jonas Berg', limit: 15000, note: 'Standardnivå för tjänster.' },
                        { sequence: 2, roleKey: 'controller', roleName: 'Controller', approverKey: 'jonas-berg', approverName: 'Jonas Berg', reserveApproverName: 'Helena Björk', limit: 50000, note: 'Budgetkontroll för konsultköp.' },
                        { sequence: 3, roleKey: 'cfo', roleName: 'CFO', approverKey: 'helena-bjork', approverName: 'Helena Björk', reserveApproverName: 'Sara Holm', limit: null, note: 'Högsta nivån publicerad.' }
                    ]],
                    [travelKey, [
                        { sequence: 1, roleKey: 'chef', roleName: 'Chef', approverKey: 'karin-stahl', approverName: 'Karin Ståhl', reserveApproverName: 'Peter Nordin', limit: 10000, note: 'Normal resepolicy.' },
                        { sequence: 2, roleKey: 'controller', roleName: 'Controller', approverKey: 'peter-nordin', approverName: 'Peter Nordin', reserveApproverName: 'Helena Björk', limit: 30000, note: 'Högre resebudget.' },
                        { sequence: 3, roleKey: 'cfo', roleName: 'CFO', approverKey: 'helena-bjork', approverName: 'Helena Björk', reserveApproverName: 'Karin Ståhl', limit: null, note: 'Slutnivå för resor.' }
                    ]]
                ]),
                savedDraftByType: new Map([
                    [purchaseKey, [
                        { sequence: 1, roleKey: 'chef', roleName: 'Chef', approverKey: 'anna-lindstrom', approverName: 'Anna Lindström', reserveApproverName: 'Marcus Ek', limit: 25000, note: 'Demo: höjd första gräns för att visa diff.' },
                        { sequence: 2, roleKey: 'controller', roleName: 'Controller', approverKey: 'marcus-ek', approverName: 'Marcus Ek', reserveApproverName: 'Helena Björk', limit: 100000, note: 'Demo: uppdaterad controller-gräns.' },
                        { sequence: 3, roleKey: 'cfo', roleName: 'CFO', approverKey: 'helena-bjork', approverName: 'Helena Björk', reserveApproverName: 'Anna Lindström', limit: null, note: 'Demo: oförändrad slutnivå.' }
                    ]],
                    [serviceKey, [
                        { sequence: 1, roleKey: 'chef', roleName: 'Chef', approverKey: 'sara-holm', approverName: 'Sara Holm', reserveApproverName: 'Jonas Berg', limit: 15000, note: 'Standardnivå för tjänster.' },
                        { sequence: 2, roleKey: 'controller', roleName: 'Controller', approverKey: 'jonas-berg', approverName: 'Jonas Berg', reserveApproverName: 'Helena Björk', limit: 50000, note: 'Budgetkontroll för konsultköp.' },
                        { sequence: 3, roleKey: 'cfo', roleName: 'CFO', approverKey: 'helena-bjork', approverName: 'Helena Björk', reserveApproverName: 'Sara Holm', limit: null, note: 'Högsta nivån publicerad.' }
                    ]],
                    [travelKey, [
                        { sequence: 1, roleKey: 'chef', roleName: 'Chef', approverKey: 'karin-stahl', approverName: 'Karin Ståhl', reserveApproverName: 'Peter Nordin', limit: 10000, note: 'Normal resepolicy.' },
                        { sequence: 2, roleKey: 'controller', roleName: 'Controller', approverKey: 'peter-nordin', approverName: 'Peter Nordin', reserveApproverName: 'Helena Björk', limit: 30000, note: 'Högre resebudget.' },
                        { sequence: 3, roleKey: 'cfo', roleName: 'CFO', approverKey: 'helena-bjork', approverName: 'Helena Björk', reserveApproverName: 'Karin Ståhl', limit: null, note: 'Slutnivå för resor.' }
                    ]]
                ])
            };
        }

        function applyScenarioSeed(seed) {
            if (!seed) return;

            publishedByType = cloneStateMap(seed.publishedByType || basePublishedByType);
            savedDraftByType = cloneStateMap(seed.savedDraftByType || baseDraftByType);
            const targetType = getOrderType(seed.currentOrderTypeKey) || orderTypes[0];
            currentOrderType = targetType;
            currentAmount = parseAmount(seed.currentAmount ?? amountInput.value);
            amountInput.value = String(currentAmount);
            currentSteps = sortStepsByLimit(savedDraftByType.get(String(targetType?.key || '').toLowerCase()) || targetType?.steps || []);
            currentMode = seed.currentMode || 'overview';
            demoScenarioSeed = seed;
            updateModePanels();
            renderStepRows();
            renderAll();
        }

        function getPublishedSteps() {
            return sortStepsByLimit(publishedByType.get(currentKey()) || currentOrderType?.steps || []);
        }

        function getSavedDraftSteps() {
            return sortStepsByLimit(savedDraftByType.get(currentKey()) || currentSteps);
        }

        function computeValidation(steps = currentSteps) {
            const issues = [];
            const draftSteps = steps.filter((step) => step.isDraft);
            const committedSteps = getCommittedSteps(steps);

            if (!steps.length) {
                issues.push({
                    kind: 'error',
                    title: 'Kedjan saknar led',
                    meta: 'Lägg till minst ett attestled innan publicering.'
                });
                return issues;
            }

            if (draftSteps.length) {
                issues.push({
                    kind: 'error',
                    title: 'Nytt led är inte sparat',
                    meta: 'Tryck Spara på det nya ledet innan granskning eller publicering.'
                });
            }

            let previousLimit = 0;

            committedSteps.forEach((step, index) => {
                const limit = Number.isFinite(step.limit) ? step.limit : null;
                const isLast = index === committedSteps.length - 1;

                if (!step.approverName || !step.approverName.trim()) {
                    issues.push({
                        kind: 'error',
                        title: `Steg ${index + 1} saknar attestant`,
                        meta: 'Välj en ansvarig innan flödet publiceras.'
                    });
                }

                if (!step.reserveApproverName || !step.reserveApproverName.trim()) {
                    issues.push({
                        kind: 'warn',
                        title: `Steg ${index + 1} saknar reserv`,
                        meta: 'Reservattestant bör vara satt för driftbarhet.'
                    });
                }

                if (!isLast && limit == null) {
                    issues.push({
                        kind: 'error',
                        title: `Steg ${index + 1} saknar beloppsgräns`,
                        meta: 'Mellansteg behöver en övre gräns.'
                    });
                }

                if (limit != null && limit < previousLimit) {
                    issues.push({
                        kind: 'error',
                        title: `Steg ${index + 1} överlappar tidigare led`,
                        meta: 'Beloppsgränsen måste vara högre än föregående led.'
                    });
                }

                if (limit != null) {
                    previousLimit = limit;
                }
            });

            const lastStep = committedSteps[committedSteps.length - 1];
            if (lastStep?.limit != null) {
                issues.push({
                    kind: 'warn',
                    title: 'Sista ledet är inte obegränsat',
                    meta: 'Förväntat är att sista nivån fångar resterande belopp.'
                });
            }

            return issues;
        }

        function computeDiff(baseSteps, nextSteps) {
            const diffs = [];
            const maxLength = Math.max(baseSteps.length, nextSteps.length);

            for (let index = 0; index < maxLength; index += 1) {
                const base = baseSteps[index];
                const next = nextSteps[index];

                if (!base && next) {
                    diffs.push({
                        kind: 'added',
                        title: `Led ${index + 1} tillagt`,
                        meta: `${next.roleName} · ${next.approverName}`
                    });
                    continue;
                }

                if (base && !next) {
                    diffs.push({
                        kind: 'removed',
                        title: `Led ${index + 1} borttaget`,
                        meta: `${base.roleName} · ${base.approverName}`
                    });
                    continue;
                }

                if (!base || !next) continue;

                const changes = [];
                if (base.roleName !== next.roleName) changes.push(`Roll ${base.roleName} → ${next.roleName}`);
                if (base.approverName !== next.approverName) changes.push(`Attestant ${base.approverName} → ${next.approverName}`);
                if (base.reserveApproverName !== next.reserveApproverName) changes.push(`Reserv ${base.reserveApproverName} → ${next.reserveApproverName}`);
                if ((base.limit ?? null) !== (next.limit ?? null)) {
                    const before = base.limit == null ? 'Obegränsat' : `${formatAmount(base.limit)} kr`;
                    const after = next.limit == null ? 'Obegränsat' : `${formatAmount(next.limit)} kr`;
                    changes.push(`Beloppsgräns ${before} → ${after}`);
                }
                if ((base.note || '') !== (next.note || '')) changes.push('Beskrivning uppdaterad');

                if (changes.length) {
                    diffs.push({
                        kind: 'changed',
                        title: `Steg ${index + 1} ändrat`,
                        meta: changes.join(' · ')
                    });
                }
            }

            return diffs;
        }

        function renderOrderTypeButtons() {
            orderTypeButtons.querySelectorAll('.approval-type-chip').forEach((btn) => {
                const isActive = String(btn.dataset.orderTypeKey).toLowerCase() === String(currentOrderType?.key).toLowerCase();
                btn.classList.toggle('is-active', isActive);
            });
        }

        function renderQuickAmounts() {
            if (!currentOrderType) return;
            quickAmountButtons.querySelectorAll('.approval-quick-amount').forEach((btn) => {
                const isActive = parseAmount(btn.dataset.quickAmount) === currentAmount;
                btn.classList.toggle('active', isActive);
            });
        }

        function renderStepRows() {
            currentSteps = sortStepsByLimit(currentSteps);
            stepList.innerHTML = '';

            currentSteps.forEach((step, index) => {
                const row = createStepRow(step, index + 1);
                stepList.appendChild(row);
            });
        }

        function createStepRow(step, sequence) {
            const selectedApprover = resolveApproverOption(step.approverKey, step.roleKey, false);
            const approverField = step.isDraft
                ? `
                    <div class="approval-step-control">
                        <label class="form-label">Attestant</label>
                        <select class="form-select approval-select js-approver-select">
                            ${buildApproverOptionsHtml(step.approverKey || '', true)}
                        </select>
                    </div>
                `
                : '';
            const confirmButton = step.isDraft
                ? `
                    <button type="button" class="approval-step-confirm js-lock-step">
                        <i class="fa fa-check"></i>
                        <span>Spara</span>
                    </button>
                `
                : '';
            const titleBlock = step.isDraft
                ? ''
                : `<div class="approval-step-name">${escapeHtml(selectedApprover?.displayName || `${step.roleName || 'Roll'} — ${step.approverName || '-'}`)}</div>`;
            const wrapper = document.createElement('div');
            wrapper.innerHTML = template.innerHTML
                .replaceAll('__sequence__', String(sequence))
                .replaceAll('__roleClass__', roleClass(step.roleKey))
                .replaceAll('__titleBlock__', titleBlock)
                .replaceAll('__approverField__', approverField)
                .replaceAll('__reserveName__', escapeHtml(step.reserveApproverName || '-'))
                .replaceAll('__note__', escapeHtml(step.note || ''))
                .replaceAll('__limit__', step.limit == null ? '' : String(step.limit))
                .replaceAll('__confirmButton__', confirmButton);

            const row = wrapper.firstElementChild;
            bindStepRow(row, step);
            return row;
        }

        function bindStepRow(row, step) {
            if (!row) return;
            row.querySelector('.js-approver-select')?.addEventListener('change', () => {
                updateStateFromRows();
                renderAll();
            });
            row.querySelector('.js-step-limit')?.addEventListener('input', () => {
                updateStateFromRows();
                renderAll();
            });
            row.querySelector('.js-lock-step')?.addEventListener('click', () => {
                updateStateFromRows();
                const rows = Array.from(stepList.querySelectorAll('.approval-step-row'));
                const rowIndex = rows.indexOf(row);
                const draftStep = currentSteps[rowIndex];
                if (!draftStep) return;

                if (!draftStep.approverKey) {
                    if (designerStatusTextEdit) designerStatusTextEdit.textContent = 'Välj attestant innan du trycker Spara';
                    return;
                }

                if (draftStep.limit == null) {
                    if (designerStatusTextEdit) designerStatusTextEdit.textContent = 'Ange beloppsgräns innan du trycker Spara';
                    return;
                }

                const committedSteps = cloneSteps(currentSteps);
                committedSteps[rowIndex] = { ...committedSteps[rowIndex], isDraft: false };
                currentSteps = sortStepsByLimit(committedSteps);
                persistCurrentDraftSnapshot();
                renderStepRows();
                renderAll();
            });
            row.querySelector('.js-remove-step')?.addEventListener('click', () => {
                row.remove();
                updateStateFromRows();
                renderAll();
            });
        }

        function updateStateFromRows() {
            const nextSteps = Array.from(stepList.querySelectorAll('.approval-step-row')).map((row, index) => {
                const source = currentSteps[index] || {};
                const approverSelect = row.querySelector('.js-approver-select');
                const selectedApprover = resolveApproverOption(approverSelect?.value || source.approverKey, source.roleKey, false) || {};
                const limitInput = row.querySelector('.js-step-limit');
                const isDraft = !!source.isDraft;
                return {
                    sequence: index + 1,
                    roleKey: selectedApprover.roleKey || source.roleKey || 'backup',
                    roleName: selectedApprover.title || source.roleName || 'Led',
                    approverKey: selectedApprover.key || source.approverKey || '',
                    approverName: selectedApprover.name || source.approverName || 'Ansvarig',
                    reserveApproverName: source.reserveApproverName || 'Reserv',
                    limit: parseAmount(limitInput?.value || '') || null,
                    note: source.note || '',
                    isDraft
                };
            });

            currentSteps = sortStepsByLimit(nextSteps);
        }

        function persistCurrentDraftSnapshot() {
            savedDraftByType.set(currentKey(), cloneSteps(currentSteps));
        }

        function resolveApproverOption(optionKey, roleKey, allowFallback = true) {
            const normalizedKey = String(optionKey || '').toLowerCase();
            const normalizedRoleKey = String(roleKey || '').toLowerCase();
            const option = approverOptions.find((entry) => {
                if (normalizedKey && String(entry.key).toLowerCase() === normalizedKey) return true;
                return normalizedRoleKey && String(entry.roleKey).toLowerCase() === normalizedRoleKey;
            });

            if (option) return option;
            return allowFallback ? approverOptions[0] || null : null;
        }

        function buildApproverOptionsHtml(selectedKey, includePlaceholder = false) {
            const normalizedSelectedKey = String(selectedKey || '').toLowerCase();
            if (!approverOptions.length) {
                return '<option value="">Ingen attestant</option>';
            }

            const optionsHtml = approverOptions.map((option) => {
                const isSelected = String(option.key).toLowerCase() === normalizedSelectedKey;
                const label = `${option.title} — ${option.name}`;
                return `<option value="${escapeHtml(option.key)}"${isSelected ? ' selected' : ''}>${escapeHtml(label)}</option>`;
            }).join('');

            if (!includePlaceholder) {
                return optionsHtml;
            }

            return `<option value="">Välj attestant</option>${optionsHtml}`;
        }

        function renderSummary() {
            summaryType.textContent = currentOrderType?.title || '-';
            summaryAmount.textContent = `${formatAmount(currentAmount)} ${currencyLabel}`;
            selectedTypeTitle.textContent = currentOrderType?.title || '-';
            selectedTypeDescription.textContent = currentOrderType?.description || '';

            const computed = computeActiveStep();
            summaryStep.textContent = computed.active ? `${computed.active.sequence}. ${computed.active.roleName}` : '-';
            summaryNextStep.textContent = computed.next ? `${computed.next.sequence}. ${computed.next.roleName}` : 'Slutled';
        }

        function renderValidation() {
            const issues = computeValidation();
            const errorCount = issues.filter((issue) => issue.kind === 'error').length;
            const warnCount = issues.filter((issue) => issue.kind === 'warn').length;

            if (validationList) {
                validationList.innerHTML = '';
                if (!issues.length) {
                    const item = document.createElement('div');
                    item.className = 'approval-validation-item';
                    item.innerHTML = `
                        <div class="approval-validation-item__title">Inga blockerande fel</div>
                        <div class="approval-validation-item__meta">Kedjan går att granska och publicera.</div>
                    `;
                    validationList.appendChild(item);
                } else {
                    issues.forEach((issue) => {
                        const item = document.createElement('div');
                        item.className = `approval-validation-item approval-validation-item--${issue.kind}`;
                        item.innerHTML = `
                            <div class="approval-validation-item__title">${escapeHtml(issue.title)}</div>
                            <div class="approval-validation-item__meta">${escapeHtml(issue.meta)}</div>
                        `;
                        validationList.appendChild(item);
                    });
                }
            }

            if (overviewValidationKpi) {
                overviewValidationKpi.textContent = errorCount ? `${errorCount} fel` : warnCount ? `${warnCount} varning${warnCount === 1 ? '' : 'ar'}` : 'OK';
            }

            if (overviewValidationMeta) {
                overviewValidationMeta.textContent = errorCount
                    ? 'Publicering stoppas tills felen är lösta.'
                    : warnCount
                        ? 'Det finns varningar, men flödet kan fortfarande granskas.'
                        : 'Inga blockerande fel i det aktuella utkastet.';
            }

            if (overviewValidationStateText) {
                overviewValidationStateText.textContent = errorCount
                    ? 'Kontrollera beloppsgränser och attestanter.'
                    : warnCount
                        ? 'En eller flera varningar behöver din uppmärksamhet.'
                        : 'Allt ser korrekt ut för publicering.';
            }

            if (overviewValidationStateBadge) {
                overviewValidationStateBadge.textContent = errorCount ? `${errorCount} fel` : warnCount ? `${warnCount} varning${warnCount === 1 ? '' : 'ar'}` : 'OK';
            }

            return { issues, errorCount, warnCount };
        }

        function renderOverview() {
            const validation = computeValidation();
            const errorCount = validation.filter((issue) => issue.kind === 'error').length;
            const warnCount = validation.filter((issue) => issue.kind === 'warn').length;
            const draftSteps = getSavedDraftSteps();
            const publishedSteps = getPublishedSteps();
            const dirty = !stepsEqual(currentSteps, draftSteps);
            const activeComputed = computeActiveStep();
            const unlimitedStepCount = getCommittedSteps().filter((step) => step.limit == null).length;
            const draftStateText = dirty ? 'Utkast har osparade ändringar.' : 'Utkastet är synkat med sparad version.';
            const demoActive = !!demoScenarioSeed;

            if (designerStatusTextOverview) {
                designerStatusTextOverview.textContent = demoActive
                    ? 'Demo aktiv'
                    : dirty
                        ? 'Ändringar pågår'
                        : 'Förhandsgranskning aktiv';
            }

            if (overviewDraftKpi) {
                overviewDraftKpi.textContent = demoActive ? 'Demodata' : dirty ? 'Ändrat utkast' : 'Synkat utkast';
            }

            if (overviewDraftMeta) {
                overviewDraftMeta.textContent = demoActive
                    ? 'Fast scenario för upprepade körningar.'
                    : dirty
                        ? 'Spara eller granska innan publicering.'
                        : 'Redo för simulering och granskning.';
            }

            if (overviewDraftStateText) {
                overviewDraftStateText.textContent = draftStateText;
            }

            if (overviewDraftStateBadge) {
                overviewDraftStateBadge.textContent = demoActive ? 'Demo' : dirty ? 'Ej sparat' : 'Sparat';
            }

            if (overviewScenarioText) {
                overviewScenarioText.textContent = `${formatAmount(currentAmount)} ${currencyLabel} · ${currentOrderType?.description || ''}`;
            }

            if (overviewScenarioBadge) {
                overviewScenarioBadge.textContent = demoActive ? `${currentOrderType?.title || '-'} · Demo` : currentOrderType?.title || '-';
            }

            if (overviewFlowKpi) {
                overviewFlowKpi.textContent = activeComputed.active
                    ? `${activeComputed.active.sequence}. ${activeComputed.active.roleName}`
                    : `${unlimitedStepCount} led utan slutgräns`;
            }

            if (overviewNextStepText) {
                overviewNextStepText.textContent = errorCount
                    ? 'Åtgärda valideringsfelen i redigeringsläget innan publicering.'
                    : dirty
                        ? 'Öppna Granska för att jämföra utkastet mot publicerad version.'
                        : activeComputed.next
                            ? `Nästa steg är ${activeComputed.next.sequence}. ${activeComputed.next.roleName}.`
                            : 'Detta är slutnivån i kedjan.';
            }

            if (overviewValidationKpi) {
                overviewValidationKpi.textContent = errorCount ? `${errorCount} fel` : warnCount ? `${warnCount} varning${warnCount === 1 ? '' : 'ar'}` : 'OK';
            }

            if (overviewDraftStateText) {
                overviewDraftStateText.title = draftSteps.length !== publishedSteps.length ? 'Utkastet avviker från publicerad version.' : 'Utkastet matchar publicerad version.';
            }

            if (overviewScenarioBadge && demoActive) {
                overviewScenarioBadge.textContent = `${currentOrderType?.title || '-'} · Demo`;
            }

        }

        function renderReview() {
            const validation = computeValidation();
            const baseSteps = getPublishedSteps();
            const diffs = computeDiff(baseSteps, currentSteps);
            const dirty = !stepsEqual(currentSteps, getSavedDraftSteps());
            const publishBlocked = validation.some((issue) => issue.kind === 'error') || diffs.length === 0;

            if (reviewStatusValue) {
                reviewStatusValue.textContent = dirty ? 'Utkast' : 'Synkat';
            }
            if (reviewStatusMeta) {
                reviewStatusMeta.textContent = dirty ? 'Det finns ändringar som inte är publicerade.' : 'Det sparade utkastet matchar den aktiva konfigurationen.';
            }
            if (reviewChangeValue) {
                reviewChangeValue.textContent = `${diffs.length}`;
            }
            if (reviewValidationValue) {
                reviewValidationValue.textContent = validation.some((issue) => issue.kind === 'error')
                    ? 'Blockerat'
                    : validation.some((issue) => issue.kind === 'warn')
                        ? 'Varning'
                        : 'OK';
            }
            if (reviewValidationMeta) {
                reviewValidationMeta.textContent = validation.some((issue) => issue.kind === 'error')
                    ? 'Åtgärda felen innan publicering.'
                    : validation.some((issue) => issue.kind === 'warn')
                        ? 'Varningarna bör granskas innan publicering.'
                        : 'Klar för publicering.';
            }
            if (reviewActionValue) {
                reviewActionValue.textContent = publishBlocked ? 'Publicering spärrad' : 'Redo att publiceras';
            }
            if (publishBtn) {
                publishBtn.disabled = publishBlocked;
            }
            if (saveDraftBtn) {
                saveDraftBtn.disabled = false;
            }

            if (reviewDiffList) {
                reviewDiffList.innerHTML = '';
                if (!diffs.length) {
                    const empty = document.createElement('div');
                    empty.className = 'approval-diff-item';
                    empty.innerHTML = `
                        <div class="approval-diff-item__title">Ingen skillnad mot publicerad version</div>
                        <div class="approval-diff-item__meta">Utkastet är identiskt med den senaste publicerade kedjan.</div>
                    `;
                    reviewDiffList.appendChild(empty);
                } else {
                    diffs.forEach((diff) => {
                        const item = document.createElement('div');
                        item.className = `approval-diff-item approval-diff-item--${diff.kind}`;
                        item.innerHTML = `
                            <div class="approval-diff-item__title">${escapeHtml(diff.title)}</div>
                            <div class="approval-diff-item__meta">${escapeHtml(diff.meta)}</div>
                        `;
                        reviewDiffList.appendChild(item);
                    });
                }
            }
        }

        function updateModePanels() {
            modePanels.forEach((panel) => {
                panel.classList.toggle('is-hidden', panel.dataset.modePanel !== currentMode);
            });

            modeButtons.forEach((button) => {
                button.classList.toggle('is-active', button.dataset.modeButton === currentMode);
            });
        }

        function computeBands() {
            const bands = [];
            let start = 1;

            getCommittedSteps().forEach((step, index) => {
                const limit = Number.isFinite(step.limit) ? step.limit : null;
                const end = limit;
                bands.push({
                    step,
                    start,
                    end
                });
                if (limit != null) {
                    start = limit + 1;
                }
            });

            return bands;
        }

        function computeActiveStep() {
            const bands = computeBands();
            const active = bands.find((band) => band.end == null || currentAmount <= band.end) || bands[bands.length - 1] || null;
            const activeIndex = active ? bands.indexOf(active) : -1;
            return {
                active: active?.step || null,
                next: activeIndex >= 0 ? bands[activeIndex + 1]?.step || null : null,
                bands
            };
        }

        function renderPreview() {
            const { active, bands } = computeActiveStep();
            previewRows.innerHTML = '';
            activeFlowSummary.innerHTML = '';

            bands.forEach((band) => {
                const isActive = active && active.sequence === band.step.sequence;
                const row = document.createElement('tr');
                row.dataset.sequence = String(band.step.sequence);
                row.className = `approval-preview-row${isActive ? ' is-active' : ''}`;
                row.innerHTML = `
                    <td>
                        <div class="approval-preview-range">${formatInterval(band.start, band.end)}</div>
                    </td>
                    <td>
                        <div class="approval-preview-badges">
                            <span class="approval-preview-badge ${band.step.roleKey === 'chef' ? 'approval-preview-badge--teal' : band.step.roleKey === 'controller' ? 'approval-preview-badge--indigo' : band.step.roleKey === 'cfo' ? 'approval-preview-badge--amber' : 'approval-preview-badge--rose'}">${escapeHtml(band.step.roleName)}</span>
                            <span class="approval-preview-badge ${isActive ? 'approval-preview-badge--active' : ''}">${escapeHtml(band.step.approverName)}</span>
                            <span class="approval-preview-badge">${escapeHtml(band.step.reserveApproverName)}</span>
                        </div>
                    </td>
                `;
                previewRows.appendChild(row);

                const flowItem = document.createElement('div');
                flowItem.className = 'approval-preview-flow__item';
                flowItem.innerHTML = `
                    <div class="approval-preview-flow__title">${band.step.sequence}. ${escapeHtml(band.step.roleName)}</div>
                    <div class="approval-preview-flow__meta">${escapeHtml(band.step.approverName)} · Reserv: ${escapeHtml(band.step.reserveApproverName)}</div>
                `;
                activeFlowSummary.appendChild(flowItem);
            });
        }

        function renderAll() {
            renderOrderTypeButtons();
            renderQuickAmounts();
            renderSummary();
            renderPreview();
            renderValidation();
            renderOverview();
            renderReview();
            if (designerStatusTextEdit) {
                const savedDraft = getSavedDraftSteps();
                designerStatusTextEdit.textContent = !stepsEqual(currentSteps, savedDraft)
                    ? `${currentOrderType?.title || 'Valt flöde'} · osparade ändringar`
                    : `${currentOrderType?.title || 'Valt flöde'} · ${formatAmount(currentAmount)} ${currencyLabel}`;
            }
        }

        function scrollToActivePreview() {
            const activeRow = previewRows.querySelector('.approval-preview-row.is-active');
            activeRow?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        function setOrderTypeByKey(key) {
            const nextType = getOrderType(key);
            if (!nextType) return;
            currentOrderType = nextType;
            currentSteps = sortStepsByLimit(savedDraftByType.get(String(nextType.key).toLowerCase()) || publishedByType.get(String(nextType.key).toLowerCase()) || nextType.steps || []);
            amountInput.value = String(currentAmount || nextType.quickAmounts?.[0] || 0);
            currentAmount = parseAmount(amountInput.value);
            renderStepRows();
            renderAll();
        }

        function escapeHtml(value) {
            return String(value)
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');
        }

        orderTypeButtons.addEventListener('click', (e) => {
            const btn = e.target.closest('.approval-type-chip');
            if (!btn) return;
            setOrderTypeByKey(btn.dataset.orderTypeKey);
        });

        modeButtons.forEach((button) => {
            button.addEventListener('click', () => {
                currentMode = button.dataset.modeButton || 'edit';
                updateModePanels();
            });
        });

        demoBtn?.addEventListener('click', () => {
            applyScenarioSeed(buildScenarioSeed());
        });

        quickAmountButtons.addEventListener('click', (e) => {
            const btn = e.target.closest('.approval-quick-amount');
            if (!btn) return;
            currentAmount = parseAmount(btn.dataset.quickAmount);
            amountInput.value = String(currentAmount);
            renderAll();
        });

        amountInput.addEventListener('input', () => {
            currentAmount = parseAmount(amountInput.value);
            renderAll();
        });

        addStepBtn?.addEventListener('click', () => {
            currentSteps.push({
                sequence: currentSteps.length + 1,
                roleKey: 'backup',
                roleName: 'Nytt led',
                approverKey: '',
                approverName: '',
                reserveApproverName: 'Reserv',
                limit: null,
                note: 'Välj attestant för det nya ledet.',
                isDraft: true
            });
            currentSteps = sortStepsByLimit(currentSteps);
            renderStepRows();
            renderAll();
        });

        saveDraftBtn?.addEventListener('click', () => {
            savedDraftByType.set(currentKey(), cloneSteps(currentSteps));
            renderAll();
            if (designerStatusTextEdit) {
                designerStatusTextEdit.textContent = 'Utkast sparat';
            }
        });

        publishBtn?.addEventListener('click', () => {
            const validation = computeValidation();
            if (validation.some((issue) => issue.kind === 'error')) return;
            publishedByType.set(currentKey(), cloneSteps(currentSteps));
            savedDraftByType.set(currentKey(), cloneSteps(currentSteps));
            renderAll();
            if (designerStatusTextEdit) {
                designerStatusTextEdit.textContent = 'Publicerad version uppdaterad';
            }
        });

        resetDesignerBtn?.addEventListener('click', () => {
            if (demoScenarioSeed) {
                applyScenarioSeed(demoScenarioSeed);
                if (designerStatusTextEdit) {
                    designerStatusTextEdit.textContent = 'Demo återställd';
                }
                return;
            }

            currentOrderType = getOrderType(model.selectedOrderTypeKey) || orderTypes[0];
            currentAmount = parseAmount(model.selectedAmount);
            amountInput.value = String(currentAmount);
            currentSteps = sortStepsByLimit(basePublishedByType.get(currentKey()) || currentOrderType?.steps || []);
            savedDraftByType = cloneStateMap(baseDraftByType);
            publishedByType = cloneStateMap(basePublishedByType);
            renderStepRows();
            renderAll();
        });

        simulateBtn?.addEventListener('click', () => {
            renderAll();
            scrollToActivePreview();
            if (designerStatusTextEdit) {
                designerStatusTextEdit.textContent = `Simulerar ${currentOrderType?.title || ''} för ${formatAmount(currentAmount)} ${currencyLabel}`;
            }
        });

        copySummaryBtn?.addEventListener('click', async () => {
            const computed = computeActiveStep();
            const text = [
                `Ordertyp: ${currentOrderType?.title || '-'}`,
                `Belopp: ${formatAmount(currentAmount)} ${currencyLabel}`,
                `Aktiv led: ${computed.active ? `${computed.active.sequence}. ${computed.active.roleName}` : '-'}`,
                `Nästa steg: ${computed.next ? `${computed.next.sequence}. ${computed.next.roleName}` : 'Slutled'}`
            ].join('\n');

            try {
                await navigator.clipboard.writeText(text);
                designerStatusTextEdit.textContent = 'Sammanställning kopierad';
            } catch {
                designerStatusTextEdit.textContent = 'Kunde inte kopiera sammanställningen';
            }
        });

        renderStepRows();
        updateModePanels();
        renderAll();
    })();
</script>
