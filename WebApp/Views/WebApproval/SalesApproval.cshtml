@using Microsoft.AspNetCore.Mvc.Localization

@model IEnumerable<Entities.ViewModels.WebApproval.WebApprovalSaleOrderVM>

@inject IViewLocalizer localizer
@inject IHtmlLocalizer<SharedResources> sharedLocalizer

@{
	// Sales approval list uses the same module-page shell as other portal modules.
	// Search and status filters remain client-side so the existing filter script can keep operating on rendered rows.
	ViewData["Title"] = localizer["PageHeader_SalesApproval"];
	var companyId = ViewData["CompanyId"];
}

@section Styles {
	<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
	<style>
		.webapproval-page .module-filter-card .input-group-text {
			border-color: rgba(148, 163, 184, 0.24);
			background: linear-gradient(180deg, rgba(57, 67, 84, 0.82) 0%, rgba(40, 50, 66, 0.92) 100%);
			color: #cbd5e1;
		}

		.webapproval-page .webapproval-sales-table th.webapproval-col-company,
		.webapproval-page .webapproval-sales-table td.webapproval-col-company,
		.webapproval-page .webapproval-sales-table th.webapproval-col-order,
		.webapproval-page .webapproval-sales-table td.webapproval-col-order,
		.webapproval-page .webapproval-sales-table th.webapproval-col-customer-number,
		.webapproval-page .webapproval-sales-table td.webapproval-col-customer-number,
		.webapproval-page .webapproval-sales-table th.webapproval-col-currency,
		.webapproval-page .webapproval-sales-table td.webapproval-col-currency,
		.webapproval-page .webapproval-sales-table th.webapproval-col-status,
		.webapproval-page .webapproval-sales-table td.webapproval-col-status {
			white-space: nowrap;
		}

		.webapproval-page .webapproval-sales-table td.webapproval-col-status .badge {
			white-space: nowrap;
		}

		body:not(.theme-dark) .webapproval-page .module-filter-card .input-group-text {
			background: linear-gradient(180deg, #f8fbff 0%, #eef4fb 100%);
			border-color: rgba(148, 163, 184, 0.34);
			color: #475569;
		}

		@@media (max-width: 1440px) {
			.webapproval-page .webapproval-sales-table {
				font-size: 0.96rem;
			}

			.webapproval-page .webapproval-sales-table thead th {
				font-size: 0.74rem;
				letter-spacing: 0.03em;
			}

			.webapproval-page .webapproval-sales-table th,
			.webapproval-page .webapproval-sales-table td {
				padding-left: 0.65rem;
				padding-right: 0.65rem;
			}
		}
	</style>
}

<div class="dashboard-readable module-page webapproval-page">
	<div class="module-page-header">
		<div>
			<div class="dashboard-card-title">Web Approval</div>
			<h1 class="module-page-title">@localizer["PageHeader_SalesApproval"]</h1>
			<div class="module-page-subtitle">@localizer["PageHeader_SalesApproval_SubTitle"]</div>
			<div class="module-page-meta">Visa försäljningsorder som väntar på beslut och jämför kund, leveransdatum och ordervärde i samma översikt.</div>
		</div>
	</div>

	@await Html.PartialAsync("_Alert")

	<div class="card kpi-card p-3 module-table-shell">
		@* Web Approval still filters the rendered table in-browser, so the search/status controls intentionally stay client-side. *@
		<div class="row g-3 pb-4">
			<div class="col-12 col-lg-8">
				<div class="input-group module-filter-card">
					<span class="input-group-text"><i class="fas fa-search"></i></span>
					<input type="text" class="form-control" id="searchOrders" onkeyup="filterBySearchString()" placeholder="@sharedLocalizer["SearchBoxPlaceholder"]" />
				</div>
			</div>
			<div class="col-12 col-lg-4">
				<div class="module-status-filters">
					<button class="btn btn-default" onclick="filterByNotApproved()" id="btnNotApproved">@sharedLocalizer["Status_NotApproved"]</button>
					<button class="btn btn-default" onclick="filterByApproved()" id="btnApproved">@sharedLocalizer["Status_Approved"]</button>
					<button class="btn btn-default" onclick="filterByRejected()" id="btnRejected">@sharedLocalizer["Status_Rejected"]</button>
					<button class="btn btn-default" onclick="filterClear()" id="btnClear">@sharedLocalizer["Filter_Clear"]</button>
				</div>
			</div>
		</div>

		<div class="table-responsive module-table">
			<table class="table table-hover mb-0 webapproval-sales-table" id="ordersTable">
				<thead>
					<tr>
						<th class="webapproval-col-company">@localizer["Header_Foretagkod"]</th>
						<th class="webapproval-col-order">@localizer["Header_OrderNumber"]</th>
						<th>@localizer["Header_SalesPerson"]</th>
						<th>@localizer["Header_Approver"]</th>
						<th class="webapproval-col-customer-number">@localizer["Header_CustomerNumber"]</th>
						<th>@localizer["Header_Customer"]</th>
						<th>@localizer["Header_RegistrationDate"]</th>
						<th>@localizer["Header_DeliveryDate"]</th>
						<th class="webapproval-col-currency">@localizer["Header_Currency"]</th>
						<th class="text-end">@localizer["Header_SalesValueLocal"]</th>
						<th class="text-end">@localizer["Header_SalesValue"]</th>
						<th class="webapproval-col-status">@localizer["Header_Status"]</th>
					</tr>
				</thead>
				<tbody>
					@if (Model is null || !Model.Any())
					{
						<tr><td colspan="12">@sharedLocalizer["Error_FailedToFindAnyRows"]</td></tr>
					}
					else
					{
						foreach (var order in Model)
						{
							<tr onclick="location.href='@Url.Action("SalesApprovalDetails", "WebApproval", new { companyId, id = order.Id })'" onmouseover="style.cursor='pointer'">
								<td class="webapproval-col-company">@order.Foretagkod</td>
								<td class="webapproval-col-order">@order.OrderNumber</td>
								<td>@order.SalesReference</td>
								<td>@order.AttestantName</td>
								<td class="webapproval-col-customer-number">@order.CustomerNumber</td>
								<td>@order.CustomerName</td>
								<td>@order.OrderRegisteredDate.ToShortDateString()</td>
								<td>@order.OrderEstimatedDeliveryDate.ToShortDateString()</td>
								<td class="text-center webapproval-col-currency">@order.Currency</td>
								<td class="text-end">@order.OrderValueLocal.ToString("0.00")</td>
								<td class="text-end">@order.OrderValue.ToString("0.00")</td>
								<td class="webapproval-col-status">
									@if (order.ApprovalStatus == 0 || order.ApprovalStatus == 3)
									{
										<span class="badge bg-silver-700">@sharedLocalizer["Status_NotApproved"]</span>
									}
									@if (order.ApprovalStatus == 1)
									{
										<span class="badge bg-green">@sharedLocalizer["Status_Approved"]</span>
									}
									@if (order.ApprovalStatus == 2)
									{
										<span class="badge bg-danger">@sharedLocalizer["Status_Rejected"]</span>
									}
								</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

<script>
	var localizedData = {
		'statusNotApproved': '@sharedLocalizer["Status_NotApproved"]',
		'statusApproved': '@sharedLocalizer["Status_Approved"]',
		'statusRejected': '@sharedLocalizer["Status_Rejected"]'
	};
</script>
<script type="text/javascript" src="~/js/webapproval.filters.js"></script>
