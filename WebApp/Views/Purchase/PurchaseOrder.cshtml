@using Entities.Purchase
@using Microsoft.AspNetCore.Mvc.Localization

@model Entities.Purchase.IPurchaseOrderVM

@inject IViewLocalizer Localizer
@inject IHtmlLocalizer<SharedResources> SharedLocalizer

@{
	// Purchase order detail mirrors the shared module-page pattern with summary cards above the main row shell.
	// The row form stays intact because add-to-stock submission depends on the full bound row payload.
	var isAcknowledgementDemo = ViewBag.PurchaseAcknowledgementDemo as bool? ?? false;
	ViewData["Title"] = isAcknowledgementDemo ? "Ordererkännande" : Localizer["PageHeader"];
	var purchaseSubmitAction = isAcknowledgementDemo ? "OrderAcknowledgement" : "PurchaseOrder";
	string registeredDate = Model?.RegisteredDate?.ToShortDateString() ?? "-";
	string deliveryDate = Model?.DeliveryDate?.ToShortDateString() ?? "-";
	var orderRows = Model?.OrderRows ?? new List<PurchaseOrderRowVM>();
	var hasPendingRows = orderRows.Any(x => x.IsRecieved != true);

	string GetDemoRowClass(PurchaseOrderRowVM row)
	{
		if (!isAcknowledgementDemo)
		{
			return string.Empty;
		}

		if (!row.ConfirmedDeliveryDate.HasValue)
		{
			return "purchase-ack-row--pending";
		}

		return row.DeliveryDate.HasValue && row.ConfirmedDeliveryDate.Value.Date == row.DeliveryDate.Value.Date
			? "purchase-ack-row--confirmed"
			: "purchase-ack-row--review";
	}

	string GetDemoStatusLabel(PurchaseOrderRowVM row)
	{
		if (!isAcknowledgementDemo)
		{
			return string.Empty;
		}

		if (!row.ConfirmedDeliveryDate.HasValue)
		{
			return "Väntar";
		}

		return row.DeliveryDate.HasValue && row.ConfirmedDeliveryDate.Value.Date == row.DeliveryDate.Value.Date
			? "Bekräftad"
			: "Avvikelse";
	}

	string ToDateInputValue(DateTime? value)
		=> value.HasValue ? value.Value.ToString("yyyy-MM-dd") : string.Empty;
}

