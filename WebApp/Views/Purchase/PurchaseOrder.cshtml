<div class="dashboard-readable module-page purchase-order-page">
	<div class="module-page-header">
		<div>
			<div class="dashboard-card-title">Inköp</div>
			<h1 class="module-page-title">@(isAcknowledgementDemo ? "Ordererkännande" : Localizer["PageHeader"])</h1>
			<div class="module-page-subtitle">@(isAcknowledgementDemo ? "Leverantörens kvittens på leveransdatum" : Localizer["PageSubHeader"])</div>
		</div>
		<div class="d-flex gap-2">
			<a class="btn btn-portal btn-portal-outline" asp-action="PurchaseOrders">Till inköpsorder</a>
		</div>
	</div>

	@await Html.PartialAsync("_Alert")

	<div class="row g-3 mb-2 kpi-list">
		<div class="col-lg-4 col-md-6">
			<div class="card kpi-card h-100 purchase-order-top-card">
				<div class="card-body">
					<div class="purchase-order-top-card-label">@Localizer["Header_From"]</div>
					<div class="purchase-order-top-card-value mb-2">@Model?.SupplierName</div>
					<div class="small text-muted">@Model?.Co</div>
					<div class="small text-muted">@Model?.Street</div>
					<div class="small text-muted">@Model?.ZipCode @Model?.City</div>
					<div class="small text-muted mt-2">@Model?.Currency</div>
				</div>
			</div>
		</div>
		<div class="col-lg-4 col-md-6">
			<div class="card kpi-card h-100 purchase-order-top-card">
				<div class="card-body">
					<div class="purchase-order-top-card-label">@Localizer["Header_To"]</div>
					<div class="purchase-order-top-card-value mb-2">@Model?.DeliveryCompany</div>
					<div class="small text-muted">@Model?.DeliveryCo</div>
					<div class="small text-muted">@Model?.DeliveryStreet</div>
					<div class="small text-muted">@Model?.DeliveryZip @Model?.DeliveryCity</div>
					<div class="small text-muted mt-2">@Model?.DeliveryCountry</div>
				</div>
			</div>
		</div>
		<div class="col-lg-4 col-md-12">
			<div class="card kpi-card h-100 purchase-order-top-card">
				<div class="card-body text-end">
					<div class="purchase-order-top-card-label">@Localizer["Header_OrderDetails"]</div>
					<div class="purchase-order-top-card-value purchase-order-number mb-2">@Localizer["Header_OrderNumber"] @Model?.OrderNumber</div>
					<div class="small text-muted">@Localizer["Header_OrderType"] @Model?.PurchaseOrderType</div>
					<div class="small text-muted">@Localizer["Header_RegistrationDate"] @registeredDate</div>
					<div class="small text-muted">@Localizer["Header_DeliveryDate"] @deliveryDate</div>
				</div>
			</div>
		</div>
	</div>

	<form asp-controller="Purchase" asp-action="@purchaseSubmitAction">
		@Html.AntiForgeryToken()
		<div class="d-none">
			<input type="hidden" asp-for="SupplierNumber" />
			<input type="hidden" asp-for="SupplierName" />
			<input type="hidden" asp-for="OrganizationNumber" />
			<input type="hidden" asp-for="OrderNumber" />
			<input type="hidden" asp-for="OrderStatusId" />
			<input type="hidden" asp-for="Co" />
			<input type="hidden" asp-for="Street" />
			<input type="hidden" asp-for="ZipCode" />
			<input type="hidden" asp-for="City" />
			<input type="hidden" asp-for="Country" />
			<input type="hidden" asp-for="CustomerNumberAtSupplier" />
			<input type="hidden" asp-for="IsBlocked" />
			<input type="hidden" asp-for="Currency" />
			<input type="hidden" asp-for="OrderValue" />
			<input type="hidden" asp-for="RegisteredDate" />
			<input type="hidden" asp-for="DeliveryDate" />
			<input type="hidden" asp-for="DeliveryCompany" />
			<input type="hidden" asp-for="DeliveryCo" />
			<input type="hidden" asp-for="DeliveryStreet" />
			<input type="hidden" asp-for="DeliveryZip" />
			<input type="hidden" asp-for="DeliveryCity" />
			<input type="hidden" asp-for="DeliveryCountry" />
			<input type="hidden" asp-for="PurchaseOrderTypeId" />
			<input type="hidden" asp-for="PurchaseOrderType" />
			<input type="hidden" asp-for="Message" />
			<input type="hidden" asp-for="ContactNumber" />
		</div>

		<div class="card kpi-card purchase-order-details-shell">
			<div class="card-body">
				@if (isAcknowledgementDemo)
				{
					<div class="purchase-ack-demo-header">
						<div>
							<div class="purchase-ack-demo-eyebrow">Ordererkännande</div>
							<div class="purchase-ack-demo-title">Leverantörens kvittens på leveransdatum</div>
						</div>
						<div class="purchase-ack-demo-legend">
							<div class="purchase-ack-demo-legend-item" title="Väntar på svar" aria-label="Väntar på svar"><span class="purchase-ack-demo-swatch purchase-ack-demo-swatch--pending"></span><i class="fa fa-clock me-1"></i>Väntar</div>
							<div class="purchase-ack-demo-legend-item" title="Bekräftad enligt beställning" aria-label="Bekräftad enligt beställning"><span class="purchase-ack-demo-swatch purchase-ack-demo-swatch--confirmed"></span><i class="fa fa-check-circle me-1"></i>Bekräftad</div>
							<div class="purchase-ack-demo-legend-item" title="Avvikelse som måste godkännas" aria-label="Avvikelse som måste godkännas"><span class="purchase-ack-demo-swatch purchase-ack-demo-swatch--review"></span><i class="fa fa-exclamation-triangle me-1"></i>Avvikelse</div>
						</div>
					</div>
					<div class="table-responsive">
						<table class="table table-invoice table-purchase-ack" id="articleRows">
							<thead>
								<tr>
									<th class="purchase-ack-select-cell"></th>
									<th>@Localizer["RowHeader_ArticleNumber"]</th>
									<th>@Localizer["RowHeader_ArticleDescription"]</th>
									<th>@Localizer["RowHeader_Quantity"]</th>
									<th>@Localizer["RowHeader_Price"]</th>
									<th>Ber lev datum</th>
									<th>Bekräftat lev datum</th>
									<th>Status</th>
									<th></th>
								</tr>
							</thead>
							<tbody>
								@if (!orderRows.Any())
								{
									<tr><td colspan="9">@SharedLocalizer["Error_FailedToFindAnyRows"]</td></tr>
								}
								else
								{
									for (int i = 0; i < orderRows.Count; i++)
									{
										var row = orderRows[i];
										var rowClass = GetDemoRowClass(row);
										var statusClass = row.ConfirmedDeliveryDate.HasValue
											? (row.DeliveryDate.HasValue && row.ConfirmedDeliveryDate.Value.Date == row.DeliveryDate.Value.Date ? "purchase-ack-status purchase-ack-status--confirmed" : "purchase-ack-status purchase-ack-status--review")
											: "purchase-ack-status purchase-ack-status--pending";
										var dateInputClass = row.ConfirmedDeliveryDate.HasValue
											? (row.DeliveryDate.HasValue && row.ConfirmedDeliveryDate.Value.Date == row.DeliveryDate.Value.Date ? "purchase-ack-date-input--confirmed" : "purchase-ack-date-input--review")
											: "purchase-ack-date-input--pending";
										<tr class="@rowClass purchase-ack-row"
											data-ack-row
											data-ack-expected="@ToDateInputValue(row.DeliveryDate)"
											data-ack-confirmed="@ToDateInputValue(row.ConfirmedDeliveryDate)"
											data-order-number="@Model?.OrderNumber"
											data-supplier-name="@Model?.SupplierName"
											data-article-number="@row.ArticleNumber"
											data-article-description="@row.ArticleDescription"
											data-expected-delivery="@ToDateInputValue(row.DeliveryDate)"
											data-confirmed-delivery="@ToDateInputValue(row.ConfirmedDeliveryDate)">
											<td class="purchase-ack-select-cell">
												<input type="hidden" asp-for="@Model.OrderRows[i].RowNumber" />
												<input type="hidden" asp-for="@Model.OrderRows[i].ArticleNumber" />
												<input type="hidden" asp-for="@Model.OrderRows[i].ArticleDescription" />
												<input type="hidden" asp-for="@Model.OrderRows[i].Quantity" />
												<input type="hidden" asp-for="@Model.OrderRows[i].RecievedQuantity" />
												<input type="hidden" asp-for="@Model.OrderRows[i].DeliveryDate" />
												<input type="hidden" asp-for="@Model.OrderRows[i].ConfirmedDeliveryDate" />
												<input type="hidden" asp-for="@Model.OrderRows[i].Unit" />
												<input type="hidden" asp-for="@Model.OrderRows[i].Price" />
												<input type="hidden" asp-for="@Model.OrderRows[i].Discount" />
												<input type="hidden" asp-for="@Model.OrderRows[i].Account" />
												<input type="hidden" asp-for="@Model.OrderRows[i].CostCenter" />
												<input type="checkbox"
													   asp-for="@Model.OrderRows[i].AddToStock"
													   class="form-check-input purchase-ack-select"
													   data-ack-select
													   aria-label="Markera rad för Jeeves" />
											</td>
											<td>@row.ArticleNumber</td>
											<td>@row.ArticleDescription</td>
											<td>
												<div class="purchase-ack-row-metric">
													<div class="purchase-ack-row-metric-value">
														<i class="fa fa-check-circle text-success"></i>
														@row.Quantity.ToString("0.00")
													</div>
												</div>
											</td>
											<td>
												<div class="purchase-ack-row-metric">
													<div class="purchase-ack-row-metric-value">
														<i class="fa fa-check-circle text-success"></i>
														@row.Price.ToString("0.00")
													</div>
												</div>
											</td>
											<td>
												<span class="purchase-ack-date">@row.DeliveryDate?.ToString("yyyy-MM-dd")</span>
											</td>
											<td>
												<input type="date" class="form-control flowengine-date-input purchase-ack-date-input @dateInputClass" value="@ToDateInputValue(row.ConfirmedDeliveryDate)" data-ack-date-input data-fe-datepicker="true" />
											</td>
											<td>
												<div class="purchase-ack-status-block">
													<span class="@statusClass" data-ack-status>
														@if (row.ConfirmedDeliveryDate.HasValue && row.DeliveryDate.HasValue && row.ConfirmedDeliveryDate.Value.Date == row.DeliveryDate.Value.Date)
														{
															<i class="fa fa-check-circle me-1"></i>
														}
														else if (row.ConfirmedDeliveryDate.HasValue)
														{
															<i class="fa fa-exclamation-triangle me-1"></i>
														}
														else
														{
															<i class="fa fa-clock me-1"></i>
														}
														@GetDemoStatusLabel(row)
													</span>
												</div>
											</td>
											<td class="purchase-ack-action-cell">
												<button type="button" class="btn btn-portal btn-portal-outline btn-sm purchase-ack-action-btn d-none" data-ack-sendback-btn>
													<i class="fa fa-paper-plane me-1"></i>Skicka tillbaka
												</button>
											</td>
										</tr>
									}
								}
							</tbody>
						</table>
					</div>
					<div class="purchase-ack-note">
						Markera en eller flera rader med checkboxen till vänster och justera leveransdatumet där det behövs. Gulmarkerade rader kan skickas tillbaka som mail, och valda rader skickas vidare till Jeeves med knappen nedan.
					</div>
					<div class="purchase-ack-footer">
						<div class="purchase-ack-footer-note">
							Leveransdatum, antal och pris visas direkt i raden så att du ser vad som skickas vidare.
						</div>
						<div class="purchase-ack-footer-meta">
							<span class="purchase-ack-selected-count" data-ack-selected-count>0 rader markerade</span>
							<button type="submit" class="btn btn-portal purchase-ack-submit-btn" data-ack-submit-btn disabled>
								<i class="fa fa-paper-plane me-1"></i>Skicka till Jeeves
							</button>
						</div>
					</div>
				}
				else
				{
					<div class="table-responsive">
						<table class="table table-invoice" id="articleRows">
							<thead>
								<tr>
									<th>@Localizer["RowHeader_ArticleNumber"]</th>
									<th>@Localizer["RowHeader_ArticleDescription"]</th>
									<th>@Localizer["RowHeader_Quantity"]</th>
									<th>@Localizer["RowHeader_RecievedQuantity"]</th>
									<th>@Localizer["RowHeader_Unit"]</th>
									<th>@Localizer["RowHeader_Price"]</th>
									<th>@Localizer["RowHeader_Discount"]</th>
									<th>@Localizer["RowHeader_RowTotal"]</th>
									<th>@Localizer["RowHeader_Account"]</th>
									<th>@Localizer["RowHeader_CostCenter"]</th>
									<th class="text-end">@Localizer["RowHeader_AddToStock"]</th>
								</tr>
							</thead>
							<tbody>
								@if (!orderRows.Any())
								{
									<tr><td colspan="12">@SharedLocalizer["Error_FailedToFindAnyRows"]</td></tr>
								}
								else
								{
									for (int i = 0; i < orderRows.Count; i++)
									{
										<tr>
											<td style="width:6%">
												<input type="hidden" asp-for="@Model.OrderRows[i].RowNumber" readonly />
												<input type="hidden" asp-for="@Model.OrderRows[i].ArticleNumber" readonly />
												@orderRows[i].ArticleNumber
											</td>
											<td style="width:20%">
												<input type="hidden" asp-for="@Model.OrderRows[i].ArticleDescription" readonly />
												@orderRows[i].ArticleDescription
											</td>
											<td style="width:5%">
												<input type="hidden" asp-for="@Model.OrderRows[i].Quantity" readonly />
												@orderRows[i].Quantity.ToString("0.00")
											</td>
											<td style="width:5%">
												<input type="hidden" asp-for="@Model.OrderRows[i].RecievedQuantity" readonly />
												@orderRows[i].RecievedQuantity.ToString("0.00")
											</td>
											<td style="width:4%">
												<input type="hidden" asp-for="@Model.OrderRows[i].Unit" readonly />
												@orderRows[i].Unit
											</td>
											<td style="width:5%">
												<input type="hidden" asp-for="@Model.OrderRows[i].Price" readonly />
												@orderRows[i].Price.ToString("0.00")
											</td>
											<td style="width:5%">
												<input type="hidden" asp-for="@Model.OrderRows[i].Discount" readonly />
												@orderRows[i].Discount.ToString("0.00")
											</td>
											<td style="width:5%">
												@{
													var price = orderRows[i].Quantity * (orderRows[i].Price * (1 - (orderRows[i].Discount / 100)));
												}
												@price.ToString("0.00")
											</td>
											<td style="width:5%">
												<input type="hidden" asp-for="@Model.OrderRows[i].Account" readonly />
												@orderRows[i].Account
											</td>
											<td style="width:5%">
												<input type="hidden" asp-for="@Model.OrderRows[i].CostCenter" readonly />
												@orderRows[i].CostCenter
											</td>
											<td class="text-end" style="width:5%">
												@if (orderRows[i].IsRecieved == false)
												{
													<input type="checkbox" asp-for="@Model.OrderRows[i].AddToStock" class="form-check-input" />
												}
											</td>
										</tr>
									}
								}
							</tbody>
						</table>
					</div>
					<div class="purchase-order-footer">
						<div class="purchase-order-actions">
							<div class="purchase-order-summary">
								<small>@Localizer["Header_SalesValue"] (@Html.DisplayFor(u => u.Currency))</small>
								<span class="fw-bold">@Model?.OrderValue.ToString("0.00")</span>
							</div>
							<div class="purchase-order-submit-group">
								@if (hasPendingRows)
								{
									<input type="submit" class="btn btn-portal btn-sm" id="btnSubmit" value="@Localizer["Submit"]">
								}
								else
								{
									<input type="submit" class="btn btn-portal btn-sm disabled" id="btnSubmit" value="@Localizer["Submit"]">
								}
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	</form>
</div>

@if (isAcknowledgementDemo)
{
	<div class="modal fade purchase-ack-modal" id="purchaseAckMailModal" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
			<div class="modal-content">
				<div class="modal-header">
					<div>
						<div class="purchase-ack-modal-label">Mailutkast</div>
						<h5 class="modal-title mb-0">Skicka tillbaka avvikande rad till leverantören</h5>
					</div>
					<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<div class="row g-3 mb-3">
						<div class="col-md-4">
							<div class="purchase-ack-modal-label mb-1">Till</div>
							<div class="fw-semibold" data-ack-modal-to></div>
						</div>
						<div class="col-md-4">
							<div class="purchase-ack-modal-label mb-1">Ämne</div>
							<div class="fw-semibold" data-ack-modal-subject></div>
						</div>
						<div class="col-md-4">
							<div class="purchase-ack-modal-label mb-1">Rad</div>
							<div class="fw-semibold" data-ack-modal-row></div>
						</div>
					</div>
					<div class="mb-3">
						<label class="purchase-ack-modal-label mb-1" for="purchaseAckMailBody">Meddelande</label>
						<textarea id="purchaseAckMailBody" class="form-control" rows="8" readonly data-ack-modal-body></textarea>
					</div>
					<div class="small text-muted">
						Det här är bara ett demo-utkast. Ingen riktig e-post skickas i det här läget.
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-portal btn-portal-outline" data-bs-dismiss="modal">Stäng</button>
					<button type="button" class="btn btn-portal" data-ack-modal-copy>
						<i class="fa fa-copy me-1"></i>Kopiera utkast
					</button>
				</div>
			</div>
		</div>
	</div>
}

<script>
	(function () {
		const demoEnabled = @((isAcknowledgementDemo).ToString().ToLowerInvariant());
		if (!demoEnabled) {
			return;
		}

		function initAcknowledgementDatepickers(scope = document) {
			if (!window.jQuery || !window.jQuery.fn || typeof window.jQuery.fn.datepicker !== 'function') {
				return;
			}

			window.jQuery(scope)
				.find('input[data-fe-datepicker="true"]')
				.each(function () {
					const input = this;
					const $input = window.jQuery(input);

					if ($input.hasClass('hasDatepicker')) {
						return;
					}

					const currentValue = input.value;
					input.setAttribute('type', 'text');
					input.setAttribute('autocomplete', 'off');
					input.setAttribute('placeholder', 'YYYY-MM-DD');

					$input.datepicker({
						dateFormat: 'yy-mm-dd',
						showOtherMonths: true,
						selectOtherMonths: true,
						showButtonPanel: true,
						beforeShow: function () {
							window.setTimeout(() => {
								window.jQuery('#ui-datepicker-div').addClass('flowengine-datepicker');
							}, 0);
						},
						onSelect: function () {
							input.dispatchEvent(new Event('change', { bubbles: true }));
						}
					});

					if (currentValue) {
						$input.datepicker('setDate', currentValue);
					}
				});
		}

		initAcknowledgementDatepickers();

		const rows = Array.from(document.querySelectorAll('[data-ack-row]'));
		const submitButton = document.querySelector('[data-ack-submit-btn]');
		const selectedCount = document.querySelector('[data-ack-selected-count]');
		const states = {
			pending: {
				icon: 'fa-clock',
				label: 'Väntar',
				rowClass: 'purchase-ack-row--pending',
				statusClass: 'purchase-ack-status--pending',
				dateClass: 'purchase-ack-date--pending'
			},
			confirmed: {
				icon: 'fa-check-circle',
				label: 'Bekräftad',
				rowClass: 'purchase-ack-row--confirmed',
				statusClass: 'purchase-ack-status--confirmed',
				dateClass: 'purchase-ack-date--confirmed'
			},
			review: {
				icon: 'fa-exclamation-triangle',
				label: 'Avvikelse',
				rowClass: 'purchase-ack-row--review',
				statusClass: 'purchase-ack-status--review',
				dateClass: 'purchase-ack-date--review'
			}
		};

		let modal = null;
		let modalTo = null;
		let modalSubject = null;
		let modalRow = null;
		let modalBody = null;
		let copyButton = null;
		let currentMessage = '';

		const modalElement = document.getElementById('purchaseAckMailModal');
		if (modalElement) {
			modalTo = modalElement.querySelector('[data-ack-modal-to]');
			modalSubject = modalElement.querySelector('[data-ack-modal-subject]');
			modalRow = modalElement.querySelector('[data-ack-modal-row]');
			modalBody = modalElement.querySelector('[data-ack-modal-body]');
			copyButton = modalElement.querySelector('[data-ack-modal-copy]');
			if (window.bootstrap) {
				modal = new bootstrap.Modal(modalElement);
			}
		}

		function buildMailBody(row) {
			return [
				'Hej,',
				'',
				`Vi behöver att ni bekräftar eller korrigerar leveransdatum för order ${row.orderNumber}.`,
				'',
				`Artikel: ${row.articleNumber} - ${row.articleDescription}`,
				`Önskat leveransdatum: ${row.expectedDelivery || '-'}`,
				`Bekräftat leveransdatum: ${row.confirmedDelivery || '-'}`,
				'',
				'Avvikelsen är markerad i ordererkännandet. Vänligen återkom med uppdaterat leveransdatum.',
				'',
				'Hälsningar',
				'Inköp'
			].join('\n');
		}

		function applyState(rowElement, mode) {
			rowElement.classList.remove(states.pending.rowClass, states.confirmed.rowClass, states.review.rowClass);
			rowElement.classList.add(states[mode].rowClass);

			const status = rowElement.querySelector('[data-ack-status]');
			if (status) {
				status.classList.remove(states.pending.statusClass, states.confirmed.statusClass, states.review.statusClass);
				status.classList.add(states[mode].statusClass);
				status.innerHTML = `<i class="fa ${states[mode].icon} me-1"></i>${states[mode].label}`;
			}

			const input = rowElement.querySelector('[data-ack-date-input]');
			if (input) {
				input.classList.remove(states.pending.dateClass, states.confirmed.dateClass, states.review.dateClass);
				input.classList.add(states[mode].dateClass);
			}

			const action = rowElement.querySelector('[data-ack-sendback-btn]');
			if (action) {
				action.classList.toggle('d-none', mode !== 'review');
			}
		}

		function updateSelectionState() {
			const selectedRows = rows.filter((rowElement) => {
				const select = rowElement.querySelector('[data-ack-select]');
				return Boolean(select && select.checked);
			});

			if (selectedCount) {
				selectedCount.textContent = `${selectedRows.length} rader markerade`;
			}

			if (submitButton) {
				submitButton.disabled = selectedRows.length === 0;
			}

			rows.forEach((rowElement) => {
				const select = rowElement.querySelector('[data-ack-select]');
				rowElement.classList.toggle('purchase-ack-row--selected', Boolean(select && select.checked));
			});
		}

		function openMailModal() {
			if (modal) {
				modal.show();
				return;
			}

			if (!modalElement) {
				return;
			}

			modalElement.classList.add('show');
			modalElement.style.display = 'block';
			modalElement.setAttribute('aria-hidden', 'false');
			document.body.classList.add('modal-open');
		}

		function closeMailModal() {
			if (modal) {
				modal.hide();
				return;
			}

			if (!modalElement) {
				return;
			}

			modalElement.classList.remove('show');
			modalElement.style.display = 'none';
			modalElement.setAttribute('aria-hidden', 'true');
			document.body.classList.remove('modal-open');
		}

		rows.forEach((rowElement) => {
			const expected = rowElement.dataset.expectedDelivery || '';
			const input = rowElement.querySelector('[data-ack-date-input]');
			const action = rowElement.querySelector('[data-ack-sendback-btn]');
			const select = rowElement.querySelector('[data-ack-select]');

			function refresh() {
				const confirmed = input ? input.value : '';
				let mode = 'pending';

				if (confirmed) {
					mode = confirmed === expected ? 'confirmed' : 'review';
				}

				rowElement.dataset.confirmedDelivery = confirmed;
				applyState(rowElement, mode);
			}

			if (input) {
				input.addEventListener('change', refresh);
				input.addEventListener('blur', refresh);
			}

			if (select) {
				select.addEventListener('change', updateSelectionState);
			}

			if (action) {
				action.addEventListener('click', () => {
					const row = {
						orderNumber: rowElement.dataset.orderNumber || '',
						supplierName: rowElement.dataset.supplierName || '',
						articleNumber: rowElement.dataset.articleNumber || '',
						articleDescription: rowElement.dataset.articleDescription || '',
						expectedDelivery: rowElement.dataset.expectedDelivery || '',
						confirmedDelivery: rowElement.dataset.confirmedDelivery || ''
					};

					const to = `${row.supplierName || 'Leverantör'} <order@leverantor.se>`;
					const subject = `Ordererkännande - order ${row.orderNumber}`;
					currentMessage = buildMailBody(row);

					if (modalTo) {
						modalTo.textContent = to;
					}
					if (modalSubject) {
						modalSubject.textContent = subject;
					}
					if (modalRow) {
						modalRow.textContent = `${row.articleNumber} - ${row.articleDescription}`;
					}
					if (modalBody) {
						modalBody.value = currentMessage;
					}

					openMailModal();
				});
			}

			rowElement.addEventListener('click', (event) => {
				if (!select || event.target.closest('input, button, a, label, textarea, select')) {
					return;
				}

				select.checked = !select.checked;
				select.dispatchEvent(new Event('change', { bubbles: true }));
			});

			refresh();
		});

		updateSelectionState();

		if (modalElement) {
			modalElement.querySelectorAll('[data-bs-dismiss="modal"]').forEach((closeButton) => {
				closeButton.addEventListener('click', closeMailModal);
			});
		}

		if (copyButton) {
			copyButton.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(currentMessage || (modalBody ? modalBody.value : ''));
					copyButton.innerHTML = '<i class="fa fa-check me-1"></i>Kopierat';
				} catch {
					copyButton.innerHTML = '<i class="fa fa-exclamation-triangle me-1"></i>Kunde inte kopiera';
				}

				window.setTimeout(() => {
					copyButton.innerHTML = '<i class="fa fa-copy me-1"></i>Kopiera utkast';
				}, 1400);
			});
		}
	})();
</script>
<script type="text/javascript" src="~/js/purchaseorders.filters.js"></script>
