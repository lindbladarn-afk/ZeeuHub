{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "AzureAppServicesFile": {
      "LogLevel": {
        "Microsoft": "None"
      }
    }
  },
  "AzureMonitor": {
    "ConnectionString": ""
  },
  "AllowedHosts": "*",
  "Azure": {
    "SignalR": {
      "Enabled": "true"
    }
  },
  "Integration": {
    "Companies": []
  },
  "Akeneo": {
    "BaseUrl": "",
    "ClientId": "",
    "ClientSecret": "",
    "Username": "",
    "Password": "",
    "PageSize": 100,
    "Enabled": true
  },
  "FlowEngine": {
    "Enabled": true,
    "Title": "FlowEngine",
    "Subtitle": "Portal-native omskrivning av FlowEngine i C# och Razor.",
    "Summary": "ZeeU Portal ska aga UI, auth, jobb och integrationer utan extern Swift-app eller separat URL.",
    "MigrationPhase": "foundation",
    "DocumentExtractMaxBytes": 10485760
  },
  "ControlPanel": {
    "AllowedCompanyName": "ZeeU AB"
  },
  "Mail": {
    "Verification": {
      "RedirectEnabled": false,
      "RedirectTo": ""
    }
  },
  "DashboardDemo": {
    "Enabled": true,
    "AllowedCompanyName": "ZeeU AB"
  },
  "BankReconciliation": {
    "Matching": {
      "AmountTolerance": 1.0,
      "DateWindowDays": 7,
      "RecommendationMinimumScore": 35,
      "RecommendationMaxResults": 4,
      "AutoMatchReferenceAmountScore": 90,
      "AutoMatchReferenceScore": 70,
      "AutoMatchAmountNameScore": 45,
      "AutoMatchAmountDateScore": 45,
      "ManualConfirmationMinimumScore": 80
    },
    "PaymentBundles": {
      "Enabled": true,
      "MaxCandidateTransactionsPerInvoice": 12,
      "MaxTransactionsPerBundle": 8,
      "MaxSuggestions": 10,
      "MinimumTransactionEvidenceScore": 60,
      "AmountTolerance": 1.0
    },
    "AiSuggestions": {
      "Enabled": true,
      "PromptVersion": "bankrec-ai-suggestion-v1",
      "MaxCandidates": 4,
      "Temperature": 0.0,
      "MaxTokens": 700
    }
  },
  "DocumentSigning": {
    "Companies": {}
  },
  "Ai": {
    "Quota": {
      "Enabled": false,
      "FreeTokensPerPeriod": 50000,
      "WarningThresholdPercent": 75,
      "CompanyOverrides": []
    }
  },
  "NotifyMe": {
    "Automation": {
      "PollIntervalMinutes": 5,
      "BatchSize": 25
    }
  },
  "TechnicalNotifications": {
    "Enabled": true,
    "SubjectPrefix": "Portal technical error",
    "To": "",
    "Cc": "",
    "Bcc": ""
  },
  "ExcelImport": {
    "BackgroundFileStore": {
      "StorageRoot": "",
      "RequireConfiguredStorageInProduction": true
    },
    "SchemaInitialization": {
      "AllowRuntimeInitializationInProduction": false
    }
  },
  "Retention": {
    "Enabled": true,
    "RunIntervalHours": 24,
    "BackgroundJobsRetentionDays": 14,
    "BackgroundJobRuntimeEventsRetentionDays": 7,
    "PortalEventLogsRetentionDays": 14,
    "AiQueryLogsRetentionDays": 14,
    "ExcelImportLogsRetentionDays": 14,
    "ExcelImportBackgroundFilesRetentionDays": 2,
    "FlowEngineJobsRetentionDays": 90,
    "ActionCenterItemStatesRetentionDays": 180,
    "BankReconciliationUploadRetentionDays": 7,
    "PurgeExpiredAuthenticationTickets": true
  },
  "Security": {
    "Authentication": {
      "CookieLifetimeMinutes": 60,
      "SessionIdleMinutes": 45,
      "SecurityStampValidationMinutes": 5,
      "EnforceSecureCookies": true,
      "SignOutWhenSessionBootstrapFails": true
    },
    "HubApi": {
      "Enabled": false,
      "Authority": "",
      "Audience": "",
      "ValidIssuer": "",
      "ValidAudiences": [],
      "RequiredScopes": [],
      "RequiredAppRoles": [],
      "RequireHttpsMetadata": true,
      "ClockSkewMinutes": 2
