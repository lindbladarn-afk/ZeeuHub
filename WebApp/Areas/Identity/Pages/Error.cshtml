@using Microsoft.AspNetCore.Identity
@using WebApp.Models.Identity
  
@inject SignInManager<ApplicationUser> SignInManager

@{
	ViewData["Title"] = "Thank You!";
	ViewData["AppHeaderNone"] = "true";
	ViewData["AppSidebarNone"] = "true";
	ViewData["AppClass"] = "app-without-header app-without-sidebar";
	ViewData["AppContentClass"] = "p-0";
	ViewData["AppBodyClass"] = "pace-top";
}

	<div class="error">
		<div class="error-code">Error!</div>
		<div class="error-content">
			<div class="error-message">Something went wrong...</div>
			<div class="error-desc mb-4">
				Read more on our <a class="link-secondary" href="https://www.zeeu.se">web site</a><br />
					
			</div>
			@if (SignInManager.IsSignedIn(User))
			{
				<div>
					<a href="@ViewData["ReturnView"]" class="btn btn-success px-3">Go Back</a>
				</div>
			}
		</div>
	</div>