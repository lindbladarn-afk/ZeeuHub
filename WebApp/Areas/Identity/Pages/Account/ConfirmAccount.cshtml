@page
@model ConfirmAccountModel
@{
    ViewData["Title"] = "Register";
    ViewData["AppHeaderNone"] = "true";
    ViewData["AppSidebarNone"] = "true";
    ViewData["AppClass"] = "app-without-header app-without-sidebar";
    ViewData["AppContentClass"] = "p-0";
    ViewData["AppBodyClass"] = "pace-top";
}

<!-- BEGIN register -->
<div class="register register-with-news-feed">
	<!-- BEGIN news-feed -->
	<div class="news-feed">
		<div class="news-image back_image"></div>
		<div class="news-caption">
			<h4 class="caption-title"><b>ZeeU</b> Hub</h4>
			<p>
				A place to manage your services
			</p>
		</div>
	</div>
	<!-- END news-feed -->
	
	<!-- BEGIN register-container -->
	<div class="register-container">
		<!-- BEGIN register-header -->
		<div class="register-header mb-25px h1">
			<div class="mb-1">Confirm account</div>
			<small class="d-block fs-15px lh-16">Please verify your ZeeU Hub account.</small>
		</div>
		<!-- END register-header -->
		
		<!-- BEGIN register-content -->
		<div class="register-content">
			<form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="POST" class="fs-13px">
				<div class="mb-3">
					<input asp-for="Input.Code" type="hidden" />
					<input asp-for="Input.Email" type="hidden" />
				</div>
				<div>
					@await Html.PartialAsync("_Alert")
				</div>
				<div class="mb-4">
					<label class="mb-2" asp-for="Input.Password"></label><span class="text-danger"> *</span>
					<input  class="form-control fs-13px" 
                            type="password" 
                            asp-for="Input.Password"
                            aria-required="true"
                            autocomplete="new-password"
                            placeholder="Password" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
				</div>
                <div class="mb-4">
					<label class="mb-2" asp-for="Input.ConfirmPassword"></label><span class="text-danger"> *</span>
					<input  class="form-control fs-13px" 
                            type="password" 
                            asp-for="Input.ConfirmPassword"
                            aria-required="true"
                            autocomplete="new-password"
                            placeholder="Confirm Password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
				</div>
				<div class="form-check mb-4">
					<input class="form-check-input" type="checkbox" value="" id="agreementCheckbox" />
					<label class="form-check-label" for="agreementCheckbox">
						By clicking Confirm, you agree to our <a href="javascript:;">Terms</a> and that you have read our <a href="javascript:;">Data Policy</a>.
					</label>
				</div>
				<div class="mb-4">
					<button	id="registerSubmit" 
							type="submit" 
							disabled = "disabled"
							class="btn btn-primary d-block w-100 btn-lg h-45px fs-13px">Confirm</button>
				</div>
				<div class="mb-4 pb-5">
					Already a member? Click <a href="/Account/Login">here</a> to login.
				</div>
				<hr class="bg-gray-600 opacity-2" />
				<p class="text-center text-gray-600">
					&copy; ZeeU AB All Right Reserved @DateTime.Now.Year
				</p>
			</form>
		</div>
		<!-- END register-content -->
	</div>
	<!-- END register-container -->
</div>
<!-- END register -->

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('#agreementCheckbox').on('click', function () {
                $('#registerSubmit').prop('disabled', !$('#agreementCheckbox').prop('checked'));
            });
        });
    </script>
}
