@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Ändra lösenord";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<partial name="_StatusMessage" for="StatusMessage" />
<div class="row g-3">
    <div class="col-xl-7">
        <div class="card account-manage-card">
            <div class="card-body p-4">
                <div class="dashboard-card-title">Säkerhet</div>
                <div class="account-manage-card-title mb-1">Byt lösenord</div>
                <p class="module-page-meta mb-4">Uppdatera ditt lösenord direkt som inloggad användare och spara när du är klar.</p>

                <form id="change-password-form" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" />
                        <label asp-for="Input.OldPassword" class="form-label"></label>
                        <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" />
                        <label asp-for="Input.NewPassword" class="form-label"></label>
                        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-4">
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
                        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                    <div class="account-manage-actions">
                        <button type="submit" class="btn btn-portal">Spara nytt lösenord</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-xl-5">
        <div class="card account-manage-card h-100">
            <div class="card-body p-4">
                <div class="dashboard-card-title">Tips</div>
                <div class="account-manage-card-title mb-1">Bra lösenord</div>
                <p class="account-manage-note mb-0">Använd ett unikt lösenord som inte delas med andra tjänster och kombinera gärna detta med tvåfaktorsautentisering.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
