@page
@model LoginWithRecoveryCodeModel
@using Microsoft.AspNetCore.Localization

@{
    // Recovery-code page with a delayed loading state so fast verification does not flash an unnecessary modal.
    var currentCulture = HttpContext.Features.Get<IRequestCultureFeature>()?.RequestCulture.UICulture.Name ?? "sv";
    var isSwedish = currentCulture.StartsWith("sv", StringComparison.OrdinalIgnoreCase);
    var languageReturnUrl = $"{HttpContext.Request.Path}{HttpContext.Request.QueryString}";
    var leftTitle = isSwedish
        ? "Affärsinsikter och arbetsflöden i samma vy"
        : "Business insights and workflows in one view";
    var leftCopy = isSwedish
        ? "Följ order, fakturor, notifieringar, kundhändelser och ZeeU Intelligence per bolag utan att hoppa mellan system."
        : "Follow orders, invoices, notifications, customer events, and ZeeU Intelligence per company without switching systems.";
    var pointOne = isSwedish
        ? "Dashboard med order, fakturor och trender i realtid."
        : "Dashboards with orders, invoices, and trends in real time.";
    var pointTwo = isSwedish
        ? "ZeeU Intelligence hjälper dig tolka data, hitta avvikelser och ställa frågor direkt i ZeeU Hub."
        : "ZeeU Intelligence helps you interpret data, spot anomalies, and ask questions directly in ZeeU Hub.";
    var pointThree = isSwedish
        ? "Action Center och NotifyMe för signaler som kräver åtgärd."
        : "Action Center and NotifyMe for signals that require action.";
    var pointFour = isSwedish
        ? "Arbeta per bolag med samma hubbupplevelse genom hela flödet."
        : "Work by company with the same hub experience throughout the workflow.";
    var helperText = isSwedish
        ? "Ange en av dina återställningskoder om du inte kommer åt autentiseringsappen."
        : "Enter one of your recovery codes if you cannot access the authenticator app.";
    var codeLabel = isSwedish ? "Återställningskod" : "Recovery code";
    var verifyLabel = isSwedish ? "Logga in med kod" : "Sign in with code";
    var loadingTitle = isSwedish ? "Verifierar återställningskod..." : "Verifying recovery code...";
    var loadingFootnote = isSwedish
        ? "Det här kan ta några sekunder om ZeeU Hub behöver läsa in större mängd data."
        : "This can take a few seconds if ZeeU Hub needs to load a larger amount of data.";
    ViewData["Title"] = isSwedish ? "Återställningskod" : "Recovery code verification";
    ViewData["AppHeaderNone"] = "true";
    ViewData["AppSidebarNone"] = "true";
    ViewData["AppClass"] = "app-without-header app-without-sidebar";
    ViewData["AppContentClass"] = "p-0";
    ViewData["AppBodyClass"] = "pace-top";
    ViewData["DisableTheme"] = "true";
}

<div class="login login-with-news-feed auth-shell">
    <div class="news-feed">
        <div class="news-image back_image"></div>
        <div class="news-caption">
            <div class="login-story">
                <h1 class="caption-title">@leftTitle</h1>
                <p class="caption-copy">@leftCopy</p>
                <div class="login-story-points">
                    <div class="login-story-point">
                        <span class="login-story-point-icon"><i class="fas fa-chart-line"></i></span>
                        <span>@pointOne</span>
                    </div>
                    <div class="login-story-point">
                        <span class="login-story-point-icon"><i class="fas fa-magic"></i></span>
                        <span>@pointTwo</span>
                    </div>
                    <div class="login-story-point">
                        <span class="login-story-point-icon"><i class="fas fa-bolt"></i></span>
                        <span>@pointThree</span>
                    </div>
                    <div class="login-story-point">
                        <span class="login-story-point-icon"><i class="fas fa-building"></i></span>
                        <span>@pointFour</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="login-container">
        <div class="login-header mb-30px">
            <div class="brand">
                <div class="login-brand-mark">
                    <span class="login-brand-mark-icon"><i class="fas fa-layer-group"></i></span>
                    <span><b>ZeeU</b> Hub</span>
                </div>
            </div>
            <form asp-controller="Home" asp-action="SetLanguage" method="post" class="login-language-form" id="loginLanguageForm">
                <input type="hidden" name="returnUrl" value="@languageReturnUrl" />
                <div class="login-language-pills" aria-label="Language toggle">
                    <button type="submit" name="culture" value="sv" class="login-language-pill @(isSwedish ? "is-active" : null)">SV</button>
                    <button type="submit" name="culture" value="en" class="login-language-pill @(!isSwedish ? "is-active" : null)">EN</button>
                </div>
            </form>
        </div>

        <div class="login-content">
            <form method="post" class="fs-13px login-form" id="recoveryCodeForm" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger login-alert mb-20px" role="alert"></div>
                <div class="form-floating mb-15px">
                    <input asp-for="Input.RecoveryCode" class="form-control h-55px fs-15px recovery-code-input" autocomplete="one-time-code" />
                    <label asp-for="Input.RecoveryCode" class="d-flex align-items-center fs-13px text-gray-600">@codeLabel</label>
                    <span asp-validation-for="Input.RecoveryCode" class="text-danger login-field-error"></span>
                </div>
                <div class="form-group mb-15px">
                    <button type="submit" class="btn btn-success d-block h-55px w-100 btn-lg fs-15px login-submit" id="recoverySubmitButton">@verifyLabel</button>
                </div>
                <div class="login-assurance mb-25px">
                    <span class="login-assurance-icon"><i class="fas fa-shield-alt"></i></span>
                    <span>@helperText</span>
                </div>
                <hr class="bg-gray-600 opacity-2 mb-20px" />
                <div class="text-gray-600 text-center text-gray-500-darker mb-0 login-footer">
                    &copy; ZeeU AB @DateTime.Now.Year
                </div>
            </form>

            <div class="login-loading-overlay" id="loginLoadingOverlay" aria-hidden="true">
                <div class="login-loading-panel" role="status" aria-live="polite">
                    <div class="login-loading-brand">
                        <span class="login-loading-brand-icon"><i class="fas fa-layer-group"></i></span>
                        <span><b>ZeeU</b> Hub</span>
                    </div>
                    <div class="login-loading-spinner" aria-hidden="true"></div>
                    <div class="login-loading-title" id="loginLoadingTitle">@loadingTitle</div>
                    <div class="login-loading-steps">
                        <div class="login-loading-step"><span></span>@(isSwedish ? "Verifierar konto" : "Verifying account")</div>
                        <div class="login-loading-step"><span></span>@(isSwedish ? "Skapar säker session" : "Creating secure session")</div>
                        <div class="login-loading-step"><span></span>@(isSwedish ? "Laddar in data" : "Loading data")</div>
                    </div>
                    <div class="login-loading-footnote">@loadingFootnote</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
          const form = document.getElementById("recoveryCodeForm");
          const submitButton = document.getElementById("recoverySubmitButton");
          const overlay = document.getElementById("loginLoadingOverlay");
          const loadingTitle = document.getElementById("loginLoadingTitle");
          const loadingDelayMs = 900;
          if (!form || !submitButton || !overlay) {
            return;
          }

          const showLoading = (title) => {
            if (loadingTitle && title) {
              loadingTitle.textContent = title;
            }

            overlay.classList.add("is-visible");
            overlay.setAttribute("aria-hidden", "false");
            form.setAttribute("aria-busy", "true");
          };

        form.addEventListener("submit", () => {
          form.classList.add("is-loading");
          submitButton.disabled = true;
          submitButton.classList.add("is-loading");
          window.setTimeout(() => {
            showLoading("@loadingTitle");
          }, loadingDelayMs);
          });
        })();
    </script>
}
